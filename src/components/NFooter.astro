---
import TennibotFooterLogo from "@assets/new/tennibot-footer-logo.svg"
import PartnerFooterForm from "./PartnerFooterForm"
import { Pages } from "@utils"

const currentYear = new Date().getFullYear()
---
<footer class="bg-black flex flex-col" >
    <div class="max-w-7xl w-[95%] mx-auto flex flex-col gap-y-10 md:flex-row md:justify-around py-16">
        <!-- Newsletter -->
        <div class="md:w-[30%] w-[95%] md:mx-0 mx-auto" >
            <div class="w-fit mx-auto">
                <img src={TennibotFooterLogo.src} alt="Tennibot Footer Logo" class="mb-3" />
                
                <p class="text-t-off-white font-pluto text-sm xl:text-base mb-5 opacity-60" >
                    Be the first to hear about new products and features.
                </p>
        
                <PartnerFooterForm client:load 
                    formClassName="flex w-full flex-row justify-center items-center gap-2"
                    inputClassName="font-plutoLight w-full py-3 bg-t-off-black border-[0.5px] pl-5 border-[#FFFFFF66] text-t-off-white rounded-3xl"
                    buttonClassName="bg-t-green border-2 border-t-green rounded-3xl opacity-80 hover:opacity-100 px-6 py-3 fill-current stroke-t-off-black text-t-green relative hover:bg-t-green hover:stroke-t-off-black transition-all duration-300 ease-in-out"
                    listId="XPBLEH"
                />
                <div class="flex flex-row gap-x-3 mt-7" >
                    <a class="bg-t-off-black rounded-full p-3 group flex flex-col items-center justify-center cursor-pointer  transition-all duration-300 ease-in-out" >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="15" viewBox="0 0 20 20" fill="none">
                            <path class="fill-t-off-white group-hover:fill-t-green transition-all duration-300 ease-in-out" d="M19.9992 20.0002V12.6752C19.9992 9.0752 19.2242 6.3252 15.0242 6.3252C12.9992 6.3252 11.6492 7.4252 11.0992 8.4752H11.0492V6.6502H7.07422V20.0002H11.2242V13.3752C11.2242 11.6252 11.5492 9.9502 13.6992 9.9502C15.8242 9.9502 15.8492 11.9252 15.8492 13.4752V19.9752H19.9992V20.0002Z"/>
                            <path class="fill-t-off-white group-hover:fill-t-green transition-all duration-300 ease-in-out" d="M0.324219 6.65039H4.47422V20.0004H0.324219V6.65039Z"/>
                            <path class="fill-t-off-white group-hover:fill-t-green transition-all duration-300 ease-in-out" d="M2.4 0C1.075 0 0 1.075 0 2.4C0 3.725 1.075 4.825 2.4 4.825C3.725 4.825 4.8 3.725 4.8 2.4C4.8 1.075 3.725 0 2.4 0Z"/>
                        </svg>
                    </a>
        
                    <a class="bg-t-off-black rounded-full p-3 flex group cursor-pointer flex-col items-center justify-center transition-all duration-300 ease-in-out" >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="15" viewBox="0 0 20 20" fill="none">
                            <path class="fill-t-off-white group-hover:fill-t-green transition-all duration-300 ease-in-out" d="M10 6.33203C7.97603 6.33203 6.33203 7.97603 6.33203 10C6.33203 12.024 7.97603 13.672 10 13.672C12.024 13.672 13.672 12.024 13.672 10C13.672 7.97603 12.024 6.33203 10 6.33203Z" />
                            <path class="fill-t-off-white group-hover:fill-t-green transition-all duration-300 ease-in-out" d="M15.536 0H4.464C2.004 0 0 2.004 0 4.464V15.536C0 18 2.004 20 4.464 20H15.536C18 20 20 18 20 15.536V4.464C20 2.004 18 0 15.536 0ZM10 16.48C6.428 16.48 3.52 13.572 3.52 10C3.52 6.428 6.428 3.524 10 3.524C13.572 3.524 16.48 6.428 16.48 10C16.48 13.572 13.572 16.48 10 16.48ZM16.616 4.7C15.86 4.7 15.244 4.088 15.244 3.332C15.244 2.576 15.86 1.96 16.616 1.96C17.372 1.96 17.988 2.576 17.988 3.332C17.988 4.088 17.372 4.7 16.616 4.7Z" />
                        </svg>
                    </a>
        
                    <a class="bg-t-off-black rounded-full group cursor-pointer p-3 flex flex-col items-center justify-center  transition-all duration-300 ease-in-out" >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="15" viewBox="0 0 20 20" fill="none">
                            <g clip-path="url(#clip0_2445_475)">
                              <path class="fill-t-off-white group-hover:fill-t-green transition-all duration-300 ease-in-out" d="M11.8616 8.46864L19.147 0H17.4206L11.0947 7.3532L6.04225 0H0.214844L7.85515 11.1193L0.214844 20H1.94134L8.62162 12.2348L13.9574 20H19.7848L11.8612 8.46864H11.8616ZM9.49695 11.2173L8.72283 10.1101L2.56342 1.29967H5.21521L10.1859 8.40994L10.9601 9.51718L17.4214 18.7594H14.7696L9.49695 11.2177V11.2173Z" />
                            </g>
                            <defs>
                              <clipPath id="clip0_2445_475">
                                <rect width="20" height="20" fill="white"/>
                              </clipPath>
                            </defs>
                        </svg>
                    </a>
        
                    <a class="bg-t-off-black rounded-full p-3 flex flex-col items-center justify-center cursor-pointer group transition-all duration-300 ease-in-out" >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path class="fill-t-off-white group-hover:fill-t-green transition-all duration-300 ease-in-out" d="M19.5879 5.19897C19.3574 4.34219 18.6819 3.66684 17.8252 3.43612C16.2602 3.00781 9.99981 3.00781 9.99981 3.00781C9.99981 3.00781 3.73961 3.00781 2.17452 3.4198C1.33438 3.65036 0.642392 4.34234 0.411833 5.19897C0 6.7639 0 10.0094 0 10.0094C0 10.0094 0 13.2713 0.411833 14.8199C0.642545 15.6765 1.3179 16.352 2.17467 16.5827C3.75609 17.011 9.99996 17.011 9.99996 17.011C9.99996 17.011 16.2602 17.011 17.8252 16.5991C18.682 16.3685 19.3574 15.693 19.5881 14.8364C19.9999 13.2713 19.9999 10.0259 19.9999 10.0259C19.9999 10.0259 20.0164 6.7639 19.5879 5.19897Z" fill="white"/>
                            <path class="fill-t-off-black" d="M8.00586 13.0074L13.2117 10.0091L8.00586 7.01074V13.0074Z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Quick Links -->
        <div class="md:w-fit md:ml-[-50px] min-[426px]:w-[386px] w-[95%] md:mx-0 mx-auto">
            <h5 class="text-t-off-white font-avenirBold text-lg">Quick Links</h5>
            <div class="flex flex-col gap-y-5 mt-5" >
                <a href="/" class="text-t-off-white font-pluto text-sm xl:text-base hover:text-t-green transition-all duration-300 ease-in-out opacity-60 hover:opacity-100" >About Us</a>
                <a href="/" class="text-t-off-white font-pluto text-sm xl:text-base hover:text-t-green transition-all duration-300 ease-in-out opacity-60 hover:opacity-100" >FAQ</a>
                <a href="/" class="text-t-off-white font-pluto text-sm xl:text-base hover:text-t-green transition-all duration-300 ease-in-out opacity-60 hover:opacity-100" >Invest</a>
            </div>
        </div>
    
        <!-- Get in touch -->
        <div class="md:w-fit min-[426px]:w-[386px] w-[95%] md:mx-0 mx-auto" >
            <h5 class="text-t-off-white font-avenirBold text-lg">Get in touch</h5>
            <div class="flex flex-col gap-y-5 mt-5" >
                <a href="/" class="text-t-off-white flex flex-row gap-x-2 items-center font-pluto text-sm xl:text-base hover:text-t-green transition-all duration-300 ease-in-out opacity-60 hover:opacity-100" >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M17 3.5H7C4 3.5 2 5 2 8.5V15.5C2 19 4 20.5 7 20.5H17C20 20.5 22 19 22 15.5V8.5C22 5 20 3.5 17 3.5ZM17.47 9.59L14.34 12.09C13.68 12.62 12.84 12.88 12 12.88C11.16 12.88 10.31 12.62 9.66 12.09L6.53 9.59C6.21 9.33 6.16 8.85 6.41 8.53C6.67 8.21 7.14 8.15 7.46 8.41L10.59 10.91C11.35 11.52 12.64 11.52 13.4 10.91L16.53 8.41C16.85 8.15 17.33 8.2 17.58 8.53C17.84 8.85 17.79 9.33 17.47 9.59Z" fill="white"/>
                    </svg>
                    haithame@tennibot.com
                </a>
                <a href="/" class="text-t-off-white flex flex-row gap-x-2 items-center font-pluto text-sm xl:text-base hover:text-t-green transition-all duration-300 ease-in-out opacity-60 hover:opacity-100" >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M11.05 14.95L9.2 16.8C8.81 17.19 8.19 17.19 7.79 16.81C7.68 16.7 7.57 16.6 7.46 16.49C6.43 15.45 5.5 14.36 4.67 13.22C3.85 12.08 3.19 10.94 2.71 9.81C2.24 8.67 2 7.58 2 6.54C2 5.86 2.12 5.21 2.36 4.61C2.6 4 2.98 3.44 3.51 2.94C4.15 2.31 4.85 2 5.59 2C5.87 2 6.15 2.06 6.4 2.18C6.66 2.3 6.89 2.48 7.07 2.74L9.39 6.01C9.57 6.26 9.7 6.49 9.79 6.71C9.88 6.92 9.93 7.13 9.93 7.32C9.93 7.56 9.86 7.8 9.72 8.03C9.59 8.26 9.4 8.5 9.16 8.74L8.4 9.53C8.29 9.64 8.24 9.77 8.24 9.93C8.24 10.01 8.25 10.08 8.27 10.16C8.3 10.24 8.33 10.3 8.35 10.36C8.53 10.69 8.84 11.12 9.28 11.64C9.73 12.16 10.21 12.69 10.73 13.22C10.83 13.32 10.94 13.42 11.04 13.52C11.44 13.91 11.45 14.55 11.05 14.95Z" fill="white"/>
                        <path d="M21.9696 18.33C21.9696 18.61 21.9196 18.9 21.8196 19.18C21.7896 19.26 21.7596 19.34 21.7196 19.42C21.5496 19.78 21.3296 20.12 21.0396 20.44C20.5496 20.98 20.0096 21.37 19.3996 21.62C19.3896 21.62 19.3796 21.63 19.3696 21.63C18.7796 21.87 18.1396 22 17.4496 22C16.4296 22 15.3396 21.76 14.1896 21.27C13.0396 20.78 11.8896 20.12 10.7496 19.29C10.3596 19 9.96961 18.71 9.59961 18.4L12.8696 15.13C13.1496 15.34 13.3996 15.5 13.6096 15.61C13.6596 15.63 13.7196 15.66 13.7896 15.69C13.8696 15.72 13.9496 15.73 14.0396 15.73C14.2096 15.73 14.3396 15.67 14.4496 15.56L15.2096 14.81C15.4596 14.56 15.6996 14.37 15.9296 14.25C16.1596 14.11 16.3896 14.04 16.6396 14.04C16.8296 14.04 17.0296 14.08 17.2496 14.17C17.4696 14.26 17.6996 14.39 17.9496 14.56L21.2596 16.91C21.5196 17.09 21.6996 17.3 21.8096 17.55C21.9096 17.8 21.9696 18.05 21.9696 18.33Z" fill="white"/>
                    </svg>
                    (251) 277-8022
                </a>
                <a href="/" class="text-t-off-white flex flex-row gap-x-2 items-center font-pluto text-sm xl:text-base hover:text-t-green transition-all duration-300 ease-in-out opacity-60 hover:opacity-100" >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <g clip-path="url(#clip0_2445_507)">
                          <path d="M20.6191 8.45C19.5691 3.83 15.5391 1.75 11.9991 1.75C11.9991 1.75 11.9991 1.75 11.9891 1.75C8.45912 1.75 4.41912 3.82 3.36912 8.44C2.19912 13.6 5.35912 17.97 8.21912 20.72C9.27912 21.74 10.6391 22.25 11.9991 22.25C13.3591 22.25 14.7191 21.74 15.7691 20.72C18.6291 17.97 21.7891 13.61 20.6191 8.45ZM11.9991 13.46C10.2591 13.46 8.84912 12.05 8.84912 10.31C8.84912 8.57 10.2591 7.16 11.9991 7.16C13.7391 7.16 15.1491 8.57 15.1491 10.31C15.1491 12.05 13.7391 13.46 11.9991 13.46Z" fill="white"/>
                        </g>
                        <defs>
                          <clipPath id="clip0_2445_507">
                            <rect width="24" height="24" fill="white"/>
                          </clipPath>
                        </defs>
                    </svg>
                    2175 Pumphrey Ave.<br /> 
                    Auburn, AL 36832
                </a>
            </div>
        </div>
    </div>

    <div
    class="flex px-10 bg-t-off-black md:w-full pt-5"
    >
        <div class="max-w-7xl w-[95%] mx-auto flex items-baseline justify-around pb-4 gap-5 md:w-full flex-wrap md:justify-between" >
            <p class="font-plutoLight lg:text-base hover:text-t-green transition-colors duration-200 text-t-off-white opacity-60">Copyright © {currentYear} Tennibot, Inc.</p>
            <div class="flex flex-row gap-x-5" >
                <a href={Pages.TERMS} class="cursor-pointer font-plutoLight lg:text-base hover:text-t-green transition-colors opacity-60 duration-200 text-xs text-t-off-white text-right ">Terms & Conditions</a>
                <a href={Pages.PRIVACY} class="cursor-pointer font-plutoLight lg:text-base hover:text-t-green transition-colors opacity-60 duration-200 text-xs text-t-off-white text-right ">Privacy Policy</a>
            </div>
        </div>
    </div>
</footer>