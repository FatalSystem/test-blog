---
// Define props for the component, including a new `tag` prop
interface Props {
  tag?: "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  color?: string;
  weight?: "thin" | "extralight" | "light" | "normal" | "medium" | "semibold" | "bold" | "extrabold"  | "black";
  className?: string;
  uppercase?: boolean;
  size?: "xs" | "sm" | "base" | "lg" | "xl" | "2xl" | "3xl" | "4xl" | "5xl" | "6xl" | "7xl" | "8xl" | "9xl"; 
  align?: "left" | "center" | "right" | "justify" | "start" | "end";
}
const { tag = "p", className } = Astro.props;

// Determine the class name based on size and color props
const baseStyle = `text-pretty font-avenir ${className}` ;
---

{
  tag === 'p' && <p class={`${baseStyle}  ${className}`}><slot /></p>
}
{
  tag === 'h1' && <h1 class={`${baseStyle}  ${className}`}><slot /></h1>
}
{
  tag === 'h2' && <h2 class={`${baseStyle}  ${className}`}><slot /></h2>
}
{
  tag === 'h3' && <h3 class={`${baseStyle}  ${className}`}><slot /></h3>
}
{
  tag === 'h4' && <h4 class={`${baseStyle}  ${className}`}><slot /></h4>
}
{
  tag === 'h5' && <h5 class={`${baseStyle}  ${className}`}><slot /></h5>
}
{
  tag === 'h6' && <h6 class={`${baseStyle}  ${className}`}><slot /></h6>
}

