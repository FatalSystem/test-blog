---
import Text from '@components/Core/Text.astro'
import Button from '@components/Core/Button.astro'

interface Props {
    title: string;
    link: string;
}

const { title, link } = Astro.props

---
<div class="py-8 flex flex-col md:flex-row md:justify-between md:items-center " >
    <div class="md:w-[50%] w-full" >
        <Text tag="h5" className="uppercase text-xl md:text-lg xl:text-2xl 2xl:text-3xl font-avenirBold" >{title}</Text>
        <Text tag="p" className="mb-5 mt-3 font-avenir text-lg xl:text-xl" >Auburn, AL, United States</Text>
    </div>
    <div class="text-center flex" >
        <Button href={link} theme="ghostLight" className="w-full tablet:w-64 mobilem:px-16 cursor-pointer" >See details</Button>
    </div>
</div>