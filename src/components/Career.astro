---
import Text from '@components/core/Text.astro'
import Button from '@components/core/Button.astro'

interface Props {
    job: {
        id: string
        title: string
        city: string
        state_code: string
    }
}

const { job } = Astro.props

---
<div class="py-8 flex flex-col md:flex-row md:justify-between md:items-center " >
    <div class="md:w-[50%] w-full" >
        <Text tag="h5" className="uppercase text-xl md:text-lg xl:text-2xl 2xl:text-3xl font-avenirBold" >{job.title}</Text>
        <Text tag="p" className="mb-5 mt-3 font-avenir text-lg xl:text-xl" ><span class="capitalize" >{`${job.city.toLowerCase()},`}</span>{` ${job.state_code}, United States`}</Text>
    </div>
    <div class="text-center flex" >
        <Button theme="ghostLight" className="w-full tablet:w-64 mobilem:px-16 cursor-pointer" >See details</Button>
    </div>
</div>