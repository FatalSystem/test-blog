---
export interface ITButton {
  onClick?: string 
  style?: string
  theme?: "light" | "dark"
}

const { onClick, style, theme = "light" }: ITButton = Astro.props

const themeClasses = {
  light: "text-t-off-white border-t-off-white hover:bg-t-off-white hover:text-t-off-black",
  dark: "text-t-off-black border-t-off-black hover:bg-t-off-black hover:text-t-off-white",
  green: "text-t-green border-t-green hover:bg-t-green hover:text-t-off-black",
}
---

<button
  onclick={onClick}
  class={`text-lg font-thin rounded-full px-16 py-2 font-avenir uppercase border-2 transition duration-300 ${themeClasses[theme]} ${style}`}
>
  <slot />
</button>
