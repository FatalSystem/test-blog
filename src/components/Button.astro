---
export interface ITButton {
  onClick?: string 
  style?: string
  theme?: "light" | "dark"
}

const { onClick, style, theme = "light" }: ITButton = Astro.props
---

<button
  onclick={onClick}
  class={` rounded-full px-10 py-2 font-avenir uppercase font-medium border-2 transition duration-300 ${
    theme === "light"
      ? "text-t-light-green border-t-light-green hover:bg-t-light-green hover:text-t-black "
      : "text-t-black border-t-black hover:bg-t-black hover:text-t-light-green "
  } ${style}`}
>
  <slot />
</button>
