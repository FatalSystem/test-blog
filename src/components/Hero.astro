---
import Button from "./Core/Button.astro"
import Text from "./Core/Text.astro"
---
<section
  class=" w-full h-[100vw] bg-t-black flex flex-wrap content-around overflow-hidden | md:h-screen | min-[850px]:h-[51vw] text-t-off-white"
>
  <!-- <div style="background-image: url('../src/assets/front-page/cover-img.webp')" class="bg-cover bg-center absolute w-full h-[150%]" /> -->
  <!-- desktop -->
  <iframe
    src="https://player.vimeo.com/video/893993983?background=1"
    allow="autoplay; fullscreen;"
    allowfullscreen
    class="hidden bg-[url('../src/assets/front-page/cover-img.webp')] bg-contain bg-center w-full opacity-75 | h-[150%] | min-[850px]:block"
  >
  </iframe>
  <!-- mobile -->
  <iframe
    src="https://player.vimeo.com/video/894270264?background=1"
    allow="autoplay; fullscreen;"
    allowfullscreen
    class=" bg-[url('../src/assets/front-page/cover-img-mobile.webp')] bg-contain bg-center w-full opacity-75 bg-t-black | static h-[150%] | min-[850px]:hidden"
  >
  </iframe>
  <div
    class=" w-full z-10 absolute left-0 flex flex-col justify-center items-center bg-gradient-to-t from-t-video-gradient to-transparent h-[100vw] | md:h-screen | min-[850px]:h-[51vw]"
  >
    <Text tag="h1" className="font-black uppercase text-center text-pretty text-[2rem] px-5 mobilem:text-4xl tablet:text-4xl md:text-5xl lg:text-6xl 2xl:text-7xl" >
      Tennis, meet robot.
    </Text>
    <div class="mt-7 flex flex-col sm:flex-row gap-5" >
      <!-- TODO: Add actions -->
      <Button onClick="/" style="mr-3 w-64">Play video</Button>
      <Button onClick="/" style="w-64" theme="green" >Buy now</Button>
    </div>
  </div>
</section>

