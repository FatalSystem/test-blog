---
import Button from "./Button.astro"
---

<section>
  <div
    class="absolute bg-t-black w-screen left-1/2 top-20 -mt-2 transform -translate-x-1/2"
    style="padding:125% 0 0 0"
  >
    <iframe
      src="https://player.vimeo.com/video/780515008?background=1"
      frameborder="0"
      allow="autoplay; fullscreen;"
      allowfullscreen
      class="absolute top-0 left-0 w-full h-full opacity-75"></iframe>
  </div>
  <div class="z-10 absolute top-1/3 left-0 w-screen flex flex-col items-center">
    <h1
      class="text-t-light-green text-3xl font-avenir font-black uppercase text-center"
    >
      Tennis, meet robot.
    </h1>
    <Button onClick="/" style="mt-4">See it in action</Button>
  </div>
</section>
