---
import { cn } from '@utils'
import { Image } from 'astro:assets'
import Text from "@components/core/Text.astro"

const { img, label } = Astro.props; 

---

<figure
  class={cn(
    "relative w-72 2xl:w-96 overflow-hidden rounded-xl border px-10 py-5",
    // light styles
    "border-t-off-white bg-transparent/[.01] hover:shadow-lg ease-linear duration-500",
    // dark styles
    "dark:border-t-off-white dark:transparent/[.01]",
  )}
>
  <div class="flex flex-col h-full">
    <Image alt="" height="75" loading="eager" src={img} class="m-auto 2xl:hidden" />
    <Image alt="" height="95" loading="eager" src={img} class="m-auto hidden 2xl:block" />
    <Text className='text-center italic mt-3 uppercase 2xl:text-xl' >{label}</Text>
  </div>
</figure>