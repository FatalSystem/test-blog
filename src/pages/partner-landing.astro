<Layout title="Partner | Tennibot" showFooter={false} showHeader={false} showPartnerHeader={true} >
    <main class="w-full bg-t-off-black relative text-t-off-white" >
      <section class="h-[100vh] bg-[url('/images/partner/partner-hero.webp')] bg-cover bg-center flex flex-col justify-between" >
