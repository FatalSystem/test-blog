      <section class="bg-black pt-16 pb-44" >
        <div class="w-[80%] md:bg-t-off-black rounded-xl mx-auto px-0 md:px-14 py-16" >
            <h2 class="font-avenirBold text-t-green text-center text-3xl  mobilem:text-2xl mb-5" >Reserve your spot now </h2>
            <p class="font-avenir text-t-off-white text-center text-lg mb-10" >Be one of the Early Founding Backers - only 150 units available</p>
            <div class="w-[100%]">
                <!-- <p class="font-avenirBold text-t-green text-2xl mb-5" >Pre Order Partner</p> -->
                <div class="flex md:flex-row flex-col-reverse w-full gap-5" >
                    <div class="flex md:flex-col flex-col mt-5 md:mt-0 w-full justify-start gap-10">
                        <!-- <div class="flex flex-row items-center gap-3" >
                            <a href="/" class={`w-fit px-5 text-lg 2xl:text-2xl 2xl: 2xl:py-3 font-thin rounded-full py-1 font-avenir border-2 transition duration-300 text-center text-t-off-black bg-t-green border-t-green md:text-t-off-black md:bg-green hover:bg-t-green hover:text-t-off-black`}>Reserve</a>
                            <div>
                                <p class="font-pluto text-t-off-white text-sm" >Pay in full or in interest free installments</p>
                            </div>
                        </div> -->
    
                        <!-- <div>
                            <img
                            src={shipping.src}
                            width={25}
                            height={25}
                            />
                            <p class="font-avenirBold text-t-off-white text-lg mt-3" >Free Shipping</p>
                            <p class="font-pluto text-t-off-white" >We'll deliver your Partner right to your doorstep.</p>
                        </div> -->
                        <div>
                            <img
                            src={moneyBack.src}
                            width={25}
                            height={25}
                            />
                            <p class="font-avenirBold text-t-off-white text-lg mt-3" >60-day-money-back-guarantee</p>
                            <p class="font-pluto text-t-off-white" >Try Partner for 60 days. Free returns within 60 days</p>
                        </div>
                        <div>
                            <img
                            src={customization.src}
                            width={25}
                            height={25}
                            />
                            <p class="font-avenirBold text-t-off-white text-lg mt-3" >Personalized Customization</p>
                            <p class="font-pluto text-t-off-white" >Have your name or loved one or even your club's<br /> itched on your robot.</p>
                        </div>
                        <div>
                            <img
                            src={warranty.src}
                            width={25}
                            height={25}
                            />
                            <p class="font-avenirBold text-t-off-white text-lg mt-3" >5 Year Warranty</p>
                            <p class="font-pluto text-t-off-white" >We've got you covered. Purchase with peace of mind.</p>
                        </div>
