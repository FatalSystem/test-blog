                src={techCrunch.src}
                width={130}
                height={50}
                class="brightness-0 invert"
                />
                <img
                src={bbc.src}
                width={60}
                height={50}
                class="brightness-0 invert"
                />
                <img
                src={bloomberg.src}
                width={120}
                class="brightness-0 invert mb-[-5px]"
                />
            </div>
        </div>
      </section>

      <section class="bg-black" >
        <div class="w-[80%] mx-auto pt-24 pb-10" >
            <h2 class="font-avenirBold text-t-green text-center uppercase text-3xl" >Train without limits</h2>
        </div>
