---
import Layout from "layouts/Layout.astro"
import time from '@assets/partner/time.svg'
import bbc from '@assets/partner/bbc.svg'
import techCrunch from '@assets/partner/techcrunch.svg'
import bloomberg from '@assets/partner/bloomberg.svg'
import shipping from '@assets/partner/shipping-icon.svg'
import customization from '@assets/partner/customization-icon.svg'
import moneyBack from '@assets/partner/return-icon.svg'
import warranty from '@assets/partner/warranty-icon.svg'
import PartnerVideoDisplay from "@components/PartnerVideoDisplay"
import VideoThumbnail from "@components/VideoThumbnail"
import PartnerPopup from "@components/PartnerPopup"
import PartnerFooter from "@components/PartnerFooter.astro"
import PartnerFeatures from "@components/PartnerFeatures"
import PartnerSlider from "@components/PartnerSlider"
import PartnerHeader from "@components/PartnerHeader"
import TestimonialItem from "@components/TestimonialItem"
import PartnerVideoSlider from "@components/PartnerVideoSlider"
---
<Layout title="Partner | Tennibot" showFooter={false} showHeader={false} showPartnerHeader={true} >
    <main class="w-full bg-t-off-black text-t-off-white" >
      <section class="relative h-[100vh] bg-[url('/images/partner/partner-hero.webp')] bg-cover bg-left flex flex-col justify-between" >
        <div class="absolute inset-0 bg-gradient-to-l from-black/70 from-0% to-transparent to-90%"></div>
        <div class="flex flex-col justify-start w-fit self-center md:items-center items-start z-10 pt-[8vh] p-5" >
            <h1 class="font-avenir text-t-off-white uppercase mb-3 lg:text-6xl text-4xl text-center" >The <span class="font-avenirBold" >Partner</span></h1>
            <p class="font-avenir text-t-off-white text-left uppercase md:text-xl text-md" >
                The only ball machine<br class="md:hidden" /> that moves like a human.
            </p>
            <a href="/" class={`mt-10 w-64 tablet:w-64 2xl:w-80 text-xl 2xl:text-2xl 2xl:py-3 rounded-full py-2 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green`}>Reserve</a>
        </div>

        <div class="w-[50%] mx-auto pb-[15vh] z-10 flex flex-col justify-end" >
            <p class="font-avenir text-t-off-white uppercase text-center md:text-lg text-sm mb-3 flex flex-col justify-center items-center" >As seen in:</p>
            <div class="mobilel:flex mobilel:flex-row grid grid-cols-2 gap-7 items-center justify-center" >
                <img
                src={time.src}
                width={70}
                height={50}
                class="brightness-0 invert w-[50px]"
                />
                <img
                src={techCrunch.src}
                width={130}
                height={50}
                class="brightness-0 invert w-[110px]"
                />
                <img
                src={bbc.src}
                width={60}
                height={50}
                class="brightness-0 invert w-[50px]"
                />
                <img
                src={bloomberg.src}
                width={120}
                class="brightness-0 invert mb-[-5px] w-[100px]"
                />
            </div>
        </div>
      </section>

      <section class="relative hidden lg:block bg-black" >
        <div class="w-[80%] mx-auto pt-24 pb-10" >
            <h2 class="font-avenirBold text-t-green text-center uppercase md:text-3xl mobilem:text-2xl text-xl" >Train without limits</h2>
        </div>
        <PartnerVideoDisplay client:load />
    </section>

    <section class="relative block lg:hidden bg-black" >
        <div class="w-[80%] mx-auto pt-24 pb-10" >
            <h2 class="font-avenirBold text-t-green text-center uppercase md:text-3xl mobilem:text-2xl text-xl" >Train without limits</h2>
        </div>
        <PartnerVideoSlider type="tennis" client:load />
    </section>

      <section class="bg-black" >
        <div class="w-[80%] mx-auto pt-16 pb-10" >
            <h2 class="font-avenirBold text-t-green text-center uppercase md:text-3xl mobilem:text-2xl text-xl" >Why Tennibot?</h2>
            <p class="font-pluto text-t-off-white text-center mt-5 md:text-lg mobilem:text-md text-sm" >We invented intelligent court training – the rest are just playing catch-up.</p>
        </div>

        <div class="w-[80%] mx-auto flex md:flex-row flex-col md:gap-20 gap-10 pt-5 pb-16" >
            <div class="w-[100%] border-2 border-t-off-white rounded-xl text-left py-8 px-5" >
                <h5 class="font-avenirBold uppercase text-xl text-t-off-white mb-3" >Premium Quality</h5>
                <p class="font-pluto text-t-off-white text-sm" >Tennibot is the only ball machine company that offers a <span class="text-t-green">3-year warranty</span>. We stand behind our quality, while others don't.</p>
            </div>
            <div class="w-[100%] border-2 border-t-off-white rounded-xl text-left py-8 px-5" >
                <h5 class="font-avenirBold uppercase text-xl text-t-off-white mb-3" >Track Record</h5>
                <p class="font-pluto text-t-off-white text-sm" >Since 2018, we have been building autonomous tennis robots for picking up balls and sweeping clay courts. <span class="text-t-green">This is not our first rodeo :)</span></p>
            </div>
            <div class="w-[100%] border-2 border-t-off-white rounded-xl text-left py-8 px-5" >
                <h5 class="font-avenirBold uppercase text-xl text-t-off-white mb-3" >Detail Obsessed</h5>
                <p class="font-pluto text-t-off-white text-sm" >We purchased, tested, and analyzed <span class="text-t-green">every ball machine on the market</span> to solve & address all the consumer pain points and inconveniences to build the ultimate ball machine!</p>
            </div>
        </div>
      </section>

      <section class="bg-black" >
        <div class="w-[80%] mx-auto flex md:flex-row flex-col justify-center pt-10 pb-36" >
            <div class=" flex flex-col md:items-center items-start md:w-[50%]" >
                <h5 class="font-avenirBold md:text-2xl text-xl uppercase text-left text-t-off-white mb-5" >
                    Desgined and<br class="" /> assembled in the USA 🇺🇸
                </h5>
            </div>
            <div class="md:w-[50%] flex flex-col justify-between" >
                <p class="font-avenir md:text-md text-sm text-t-off-white mb-8" >
                    Tennibot is a dedicated team based in Auburn, Alabama.<br class="md:block hidden" /> Crafted with care by fellow tennis, pickle, & padel players.
                </p>
                <a href="/" class={`tablet:w-64 w-full 2xl:w-80 text-xl 2xl:text-2xl 2xl: 2xl:py-3 rounded-full py-2 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green`}>Reserve</a>
            </div>
        </div>

        <div class="w-[80%] mx-auto flex flex-row justify-center gap-10 pt-5 pb-16" >
            <p class="font-avenir text-t-off-white text-center text-md md:text-lg" >
                "Finally, a ball machine that moves and adapts like a real player. I have been waiting for this invention for years!"<br /> <br />James C., Tennis Coach | Burlingame, CA
            </p>
        </div>
      </section>
      
      <section class="bg-black pt-5 pb-36" >
        <PartnerFeatures client:load />
      </section>

      <section class="bg-black pb-36 pt-10" >
        <div class="w-[80%] mx-auto" >
            <h2 class="font-avenirBold text-t-green text-center md:text-3xl mobilem:text-2xl text-xl uppercase" >How partner works</h2>
            <p class="font-pluto text-t-off-white text-center md:text-lg mobilem:text-lg text-sm mt-5 mb-10" >In three easy steps... 👇🏼</p>
        </div>
        <div class="flex md:flex-row flex-col gap-10 overflow-x-scroll px-5 flex-nowrap [&::-webkit-scrollbar]:hidden" >
            <div class="min-w-[45%] h-[50vh] bg-[url('/images/partner/partner-step-one.webp')] bg-cover bg-center rounded-xl flex flex-col justify-between px-5 py-5" >
                <p class="font-avenirBold text-t-off-white text-3xl" >1.</p>
                <div class="mb-10">
                    <h5 class="font-avenirBold text-t-off-white md:text-3xl text-xl mb-5" >Ready in one minute</h5>
                    <p class="font-pluto text-t-off-white md:text-xl" >Simply set the Partner & Station on the court and turn them on. </p>
                </div>
            </div>
            <div class="min-w-[45%] h-[50vh] bg-[url('/images/partner/partner-step-two.webp')] bg-cover bg-center rounded-xl flex flex-col justify-between px-5 py-5" >
                <p class="font-avenirBold text-t-off-white text-3xl" >2.</p>
                <div class="mb-10">
                    <h5 class="font-avenirBold text-t-off-white md:text-3xl text-xl mb-5" >Auto calibrate in seconds</h5>
                    <p class="font-pluto text-t-off-white md:text-xl" >They will automatically calibrate the court lines, the net, and their position & yours on the court.</p>
                </div>
            </div>
            <div class="min-w-[45%] h-[50vh] bg-[url('/images/partner/tennis.png')] bg-cover bg-bottom rounded-xl flex flex-col justify-between px-5 py-5" >
                <p class="font-avenirBold text-t-off-white text-3xl" >3.</p>
                <div class="mb-10">
                    <h5 class="font-avenirBold text-t-off-white md:text-3xl text-xl mb-5" >Create your dream match</h5>
                    <p class="font-pluto text-t-off-white md:text-xl " >With the Tennibot app, reate any practice or match session you dream of simple as that!</p>
                </div>
            </div>
        </div>
      </section>
      <section class="bg-black pt-16 pb-36" >
        <div class="w-[80%] mx-auto" >
            <h2 class="font-avenirBold text-t-green text-center md:text-3xl mobilem:text-2xl text-xl mb-10" >Intelligent. Powerful. Unmatched.</h2>
            <div class="bg-t-off-black p-10 rounded-xl flex flex-col">
                <p class="font-avenir uppercase text-t-off-white md:text-2xl mobilem:text-xl mb-5">See it in action</p>
                <div class="flex md:flex-row flex-col gap-5 justify-between items-center" >
                    <VideoThumbnail client:idle title="Infinite drills" videoSource="https://player.vimeo.com/video/932265258" className="bg-[url('/images/rover/setupthumbnail.webp')] md:w-[30%] w-full"  />
                    <VideoThumbnail client:idle title="Game-like matches" videoSource="https://player.vimeo.com/video/932265258" className="bg-[url('/images/rover/setupthumbnail.webp')] md:w-[30%] w-full"  />
                    <VideoThumbnail client:idle title="Tracking & Analytics" videoSource="https://player.vimeo.com/video/932265258" className="bg-[url('/images/rover/setupthumbnail.webp')] md:w-[30%] w-full"  />
                </div>
            </div>
        </div>
      </section>
      <section class="bg-black pt-16 pb-36" >
        <div class="" >
            <h2 class="font-avenirBold text-t-green text-center md:text-3xl mobilem:text-2xl text-xl mb-10" >But don't take our word for it!</h2>
            <div class="px-5 flex flex-row gap-10 overflow-x-scroll flex-nowrap [&::-webkit-scrollbar]:hidden" >
                <TestimonialItem client:idle quote={`"I think every tennis coach should have one of theses."`} name="Sylvana Jordyn" location="Rockville, MD" videoSource="https://player.vimeo.com/video/1031406658" className="bg-[url('/images/partner/testimonial-one.png')]" />
                <TestimonialItem client:idle quote={`"I think every tennis coach should have one of theses."`} name="Logan West" location="Washington, DC" videoSource="https://player.vimeo.com/video/1031406854" className="bg-[url('/images/partner/testimonial-two.png')]" />
                <TestimonialItem client:idle quote={`"I think every tennis coach should have one of theses."`} name="Alex Chan" location="Rockville, MD" videoSource="https://player.vimeo.com/video/1031406731" className="bg-[url('/images/partner/testimonial-three.png')]" />
                <TestimonialItem client:idle quote={`"I think every tennis coach should have one of theses."`} name="Mo Eldemerdash" location="Auburn, AL" videoSource="https://player.vimeo.com/video/1031426621" className="bg-[url('/images/partner/testimonial-four.png')]" />
            </div>
        </div>
      </section>

