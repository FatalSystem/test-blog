  {
    question: 'What makes The Partner different from other pickleball machines?',
    answer: 'The Partner is the first AI-powered pickleball machine that actively moves and responds to your court position in real time. Unlike stationary machines, it tracks your location and delivers shots that simulate playing against a real partner.'
  },
  {
    question: 'How does The Partner detect players and adjust shots?',
    answer: 'Using a combination of AI, advanced sensors, and computer vision, The Partner tracks your movement, the court lines, and the pickleball itself. This allows it to auto-calibrate and dynamically adjust shots for a realistic training experience.'
  },
  {
    question: 'Is The Partner safe to use on a pickleball court?',
    answer: 'Absolutely. It includes intelligent safety sensors that detect people and obstacles, pausing operation if someone is nearby.'
  },
  {
    question: 'How fast can The Partner shoot pickleballs?',
    answer: 'The Partner supports a wide range of adjustable shot speeds suitable for all skill levels. It can shoot up to 65 miles per hour.'
  },
  {
    question: 'When will I receive my Partner if I order today?',
    answer: 'Your unit will be shipped 6–7 weeks after the order is placed.'
  }
]
const slides = [
  {
    style: "bg-[url('/images/new/pickleball/pickleball-tennibot-partner-ball-machine-front-close.webp')] sm:h-[70vh] h-[45vh]",
    thumbnail: "/images/new/pickleball/pickleball-tennibot-partner-ball-machine-front-close.webp"
  },
  {
    style: "bg-[url('/images/new/pickleball/pickleball-tennibot-partner-side-net.webp')] sm:h-[70vh] h-[45vh]",
    thumbnail: "/images/new/pickleball/pickleball-tennibot-partner-side-net.webp"
  },
  {
    style: "bg-[url('/images/new/pickleball/pickleball-tennibot-partner-front-on-court.webp')] bg-right sm:h-[70vh] h-[45vh]",
    thumbnail: "/images/new/pickleball/pickleball-tennibot-partner-front-on-court.webp"
  },
  {
    style: "bg-[url('/images/new/pickleball/hitting-with-tennibot-partner-ball-machine.webp')] sm:h-[70vh] h-[45vh]",
    thumbnail: "/images/new/pickleball/hitting-with-tennibot-partner-ball-machine.webp"
