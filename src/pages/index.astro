---
// Astro
import Layout from "../layouts/Layout.astro"
import Hero from "@components/Hero.astro"
import { BackgroundImage } from "astro-imagetools/components"
import { Image } from 'astro:assets'
import Button from "@components/Core/Button.astro"
import Text from "@components/Core/Text.astro"

// React
import { Marquee, MarqueeItem } from "@components/Marquee"
import Counter from "@components/Counter"
import { TestimonialsSlider, } from "@components/TestimonialsSlider"
import { MediaQuotes } from "@components/MediaQuotes"
import FrontPageSlider from "@components/FrontPageSlider"
import { Pages } from "@utils"

// Imgs
import ballCollection from "@assets/front-page/ball-collection.webp"
import ballCollectionMobile from "@assets/front-page/ball-collection-mobile.webp"
import lineJudging from "@assets/front-page/line-judging.webp"
import lineJudgingMobile from "@assets/front-page/line-judging-mobile.webp"
import courtSweeping from "@assets/front-page/courtsweeping.webp"
import courtSweepingMobile from "@assets/front-page/court-sweeping-mobile.webp"
import matchAnalysis from "@assets/front-page/matchanalysis.webp"
import matchAnalysisMobile from "@assets/front-page/match-analysis-mobile.webp"

import harvard from "@assets/front-page/marquee/harvard.svg"
import auburn from "@assets/front-page/marquee/auburn.svg"
import wakeForest from "@assets/front-page/marquee/wake-forest.svg"
import stanford from "@assets/front-page/marquee/stanford.svg"

import usaMap from "@assets/front-page/usa-map.svg"
import Globe from "@components/Globe"

// const MAIN_SLIDER_OPTIONS: EmblaOptionsType = { loop: false, watchDrag: false }
// const MAIN_SLIDE_COUNT = 3
// const MAIN_SLIDES = Array.from(Array(MAIN_SLIDE_COUNT).keys())

const VIDEO_SLIDER_OPTIONS = { loop: true }
const VIDEO_SLIDES = [
  {
    title: `"I think every tennis coach should have one of these."`,
    author: {
      name: "John Smith",
      location: "San Diego, CA"
    },
    url: "/"
  },
  {
    title: `"I think every tennis coach should have one of these."`,
    author: {
      name: "John Smith",
      location: "San Diego, CA"
    },
    url: "/"
  },
  {
    title: `"I think every tennis coach should have one of these."`,
    author: {
      name: "John Smith",
      location: "San Diego, CA"
    },
    url: "/"
  },
  {
    title: `"I think every tennis coach should have one of these."`,
    author: {
      name: "John Smith",
      location: "San Diego, CA"
    },
    url: "/"
  },
  {
    title: `"I think every tennis coach should have one of these."`,
    author: {
      name: "John Smith",
      location: "San Diego, CA"
    },
    url: "/"
  },
]

const MARQUEE_CONTENT = [
  {
    img: harvard
  },
  {
    img: auburn
  },
  {
    img: wakeForest
  },
  {
    img: stanford
  }
]
---

<Layout title="Welcome to Tennibot.">
  <main class="bg-t-off-black text-t-off-white" >
    <Hero />

    <MediaQuotes client:only="visible"/>

    <section class="relative text-t-off-white">
      <FrontPageSlider client:only="react" />
    </section>

    <section>
      <picture >
        <source srcset={ballCollectionMobile.src} media="(max-width: 425px)" />
        <Image src={ballCollection} class="w-full" alt="Ball collection image" />
      </picture>
      <picture>
        <source srcset={lineJudgingMobile.src} media="(max-width: 425px)" />
        <Image src={lineJudging}  class="w-full" alt="Line judging image" />
      </picture>
      <picture>
        <source srcset={courtSweepingMobile.src} media="(max-width: 425px)" />
        <Image src={courtSweeping} class="w-full" alt="Court sweeping image" />
      </picture>
      <picture>
        <source srcset={matchAnalysisMobile.src} media="(max-width: 425px)" />
        <Image src={matchAnalysis} class="w-full" alt="Match analysis image" />
      </picture>
    </section>

    <section class="flex flex-col md:flex-row" >
      <div class="w-full md:w-[50%] md:h-full">
        <BackgroundImage src="../src/assets/front-page/rover.webp" >
          <div class="h-[60vh] md:h-[90vh] flex flex-col items-center justify-between p-10" >
            <Text tag="h3" className="uppercase font-black text-3xl" >
              Rover
            </Tex>
            <div class="flex flex-col items-center" >
              <Text tag="p" className="uppercase text-2xl text-center font-thin" >
                Take the <strong class="font-bold" >tedious</strong><br> out of <strong class="font-bold" >tennis</strong>
              </Text>
              <Button href={Pages.ROVER} className="mt-6 w-64" >Learn more</Button>
            </div>
          </div>
        </BackgroundImage>
      </div>
      <div class="w-full md:w-[50%] md:h-full" >
        <BackgroundImage src="../src/assets/front-page/station.webp" >
          <div class="h-[60vh] md:h-[90vh] flex flex-col items-center justify-between p-10">
            <Text tag="h3" className="uppercase font-black text-3xl" >
              Station
            </Tex>
            <div class="flex flex-col items-center" >
              <Text tag="p" className="uppercase text-2xl text-center font-thin" >
                Your own personal<br> <strong class="font-bold" >coach, analyst and line judge</strong>
              </Text>
              <Button href={Pages.STATION} className="mt-6 w-64 " >Learn more</Button>
            </div>
          </div>
        </BackgroundImage>
      </div>
    </section>

    <section class="bg-t-off-black pt-20 mb-20" >
      <Text tag="h3" className="pb-10 uppercase text-3xl font-thin text-center" >Trusted by...</Text>
      <div class="relative flex h-full w-full flex-col items-center justify-center overflow-hidden" >
        <Marquee pauseOnHover className="[--duration:50s]" >
          {MARQUEE_CONTENT.map((item, index) => {
            return (
              <MarqueeItem key={index} img={item.img} />
            )
          })}
        </Marquee>
      </div>
    </section>

    <section class="bg-t-off-black md:h-[80vh] sm:h-[100vh] h-[90vh] flex" >
      <div class="w-4/5 m-auto flex flex-col-reverse md:flex-row justify-center items-center gap-10" >
        <div class="md:w-[50%] w-full" >
          <div class="w-full flex flex-col justify-end" >
            <!-- overflow-hidden here -->
            <div class="bg-t-off-black relative flex h-full flex-col w-full items-center justify-center">  
              <Globe client:only="react" className=" bg-t-off-black" />
              <!-- <div class="pointer-events-none absolute inset-0 h-full bg-[radial-gradient(circle_at_50%_200%,rgba(0,0,0,0.2),rgba(255,255,255,0))]" /> -->
            </div>
          </div>
          <!-- TODO: Animate highlight on scroll -->
          <!-- <Image src={usaMap} alt="" /> -->
        </div>
        <div>
          <Text tag="h6" className="font-black text-center text-5xl" >
            <Counter client:only="react" value={1027945} />
          </Text>
          <Text tag="p" className="text-center text-2xl font-thin italic mt-5" >
            Tennis balls collect by Tennibot,<br class="hidden sm:block" /> across the United States
          </Text>
        </div>
      </div>
    </section>
    
    <section class="relative bg-t-off-black mt-20 pb-20 overflow-hidden ">
      <TestimonialsSlider client:only="react" slides={VIDEO_SLIDES} options={VIDEO_SLIDER_OPTIONS} />
    </section>
    <section class="flex flex-row justify-center items-center lg:pb-10 pb-5">
      <hr class="sm:w-full  w-[30%] " >
      <div class="sm:mx-10 mx-2">
        <Text tag="h6" className="w-full uppercase font-black text-center text-pretty text-sm mobilel:text-lg mobilem:text-base sm:text-nowrap sm:text-2xl" >Designed and assembled in the USA</Text>
      </div>
      <hr class="sm:w-full  w-[30%] " >
    </section>
  </main>
</Layout>