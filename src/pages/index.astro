---
import Layout from "../layouts/Layout.astro"
import Header from "../components/Header"
import Hero from "../components/Hero.astro"
import { Container as CarouselContainer } from "../components/Carousel"
import ImagesSection from "../components/ImagesSection.astro"
---

<Layout title="Welcome to Astro.">
  <Header client:visible />
  <main>
    <Hero />
    <!-- Spacer -->
    <!-- mb-36 -->
    <div class="h-96 mb-4 mobilem:mb-20 mobilel:mb-36"></div>
    <CarouselContainer client:load />
    <ImagesSection />
  </main>
</Layout>
