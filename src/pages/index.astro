---
import Layout from "layouts/Layout.astro"
import Text from "@components/core/Text.astro"
import { Pages } from "@utils"

---
<Layout showHeader={false} showFooter={false} title="Tennibot">
    <main class="w-full bg-t-off-black relative text-t-off-white" >
        <section class="flex flex-col sm:flex-row tablet:mt-0 mt-[-1px]" >
          <div class="w-full group md:w-[50%] md:h-full" >
            <div  class="bg-[url('/images/general/bm.webp')] bg-cover bg-center " >
              <div class="sm:h-[100vh] h-[50vh] relative flex flex-col  items-center justify-between py-10">
                <!-- <div class="bg-black sm:w-[50vw] w-full absolute opacity-20 group-hover:opacity-40 transition-all duration-300 ease-in-out" ></div> -->
                <Text tag="h3" className="uppercase z-10 font-avenir xl:text-4xl text-3xl" >
                    The <span class="font-avenirBold" >partner</span>
                </Text>
                <div class="flex flex-col items-center w-[90%]" >
                  <Text tag="p" className="uppercase text-pretty font-avenir mb-5 text-lg xl:text-3xl mobilem:text-lg text-center" >
                    The smartest <span class="font-avenirBold" >ball machine</span><br /> in the world
                  </Text>
                  <!-- <Button aria-label="Navigate to the Rover page" href="/" className="mt-4 w-64 uppercase text-t-off-black" >Meet Rover</Button> -->
                  <a href="/partner" class={`tablet:w-64 w-full 2xl:w-80 text-lg 2xl:text-2xl 2xl: 2xl:py-3 font-thin rounded-full py-2 font-avenir uppercase border-2 transition duration-300 text-center text-t-green bg-[rgba(192,242,12,0.10)] border-t-green`}>Meet Partner</a>
                </div>
              </div>
            </div>
          </div>
            <div class="w-full group md:w-[50%] md:h-full" >
              <div  class="bg-[url('/images/general/rovers.webp')] bg-cover bg-bottom " >
                <div class="sm:h-[100vh] h-[50vh] relative flex flex-col items-center justify-between py-10">
                  <!-- <div class="bg-black sm:w-[50vw] w-full absolute opacity-20 group-hover:opacity-40 transition-all duration-300 ease-in-out" ></div> -->
                  <Text tag="h3" className="uppercase z-10 font-avenir xl:text-4xl text-3xl" >
                      The <span class="font-avenirBold" >Rover</span>
                  </Text>
                  <div class="flex flex-col items-center w-[90%]" >
                    <Text tag="p" className="uppercase text-pretty font-avenir mb-5 text-lg xl:text-3xl mobilem:text-lg text-center" >
                      The smartest <span class="font-avenirBold" >ball collector</span> <br />in the world
                    </Text>
                    <!-- <Button aria-label="Navigate to the Rover page" href="/" className="mt-4 w-64 uppercase text-t-off-black" >Meet Rover</Button> -->
                    <a href={Pages.TENNIS} class={`tablet:w-64 w-full 2xl:w-80 text-lg 2xl:text-2xl 2xl: 2xl:py-3 font-thin rounded-full py-2 font-avenir uppercase border-2 transition duration-300 text-center text-t-green bg-[rgba(192,242,12,0.10)] border-t-green `}>Meet Rover</a>
                  </div>
                </div>
              </div>
            </div>
        </section>
    </main>
</Layout>