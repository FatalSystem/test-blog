---
import LandingForm from "@components/LandingForm"
import Layout from "layouts/Layout.astro"
import { BackgroundImage } from "astro-imagetools/components"
import Button from "@components/core/Button.astro"
import Text from "@components/core/Text.astro"
import { Pages } from "@utils"

---
<Layout showHeader={false} showFooter={false} title="Join the newsletter | Tennibot">
    <main class="w-full bg-t-off-black relative text-t-off-white" >
        <a href="/" class="group cursor-pointer w-full h-[50vh]" >
            <div  class="xl:bg-[url('/images/tennis/tennibot.webp')] bg-[url('/images/tennis/tennis-mobile.webp')] bg-cover bg-center" >
              <div class="h-[50vh] flex flex-col items-center justify-center">
                <div class="bg-black h-[50vh] w-[100vw] absolute opacity-20 group-hover:opacity-40 transition-all duration-300 ease-in-out" ></div>
                <Text tag="h3" className="uppercase z-10 font-avenirBold xl:text-4xl text-3xl" >
                  Tennis
                </Text>
                <div class="flex flex-col items-center w-[90%]" >
                  <!-- <Text tag="p" className="uppercase text-pretty font-avenir text-lg xl:text-3xl mobilem:text-xl text-center" >
                    Your own personal<br> <strong class="font-avenirBold" >coach, analyst and umpire</strong>
                  </Text> -->
                  <!-- <Button aria-label="Navigate to the Station page" href={Pages.STATION} className="mt-4 w-64 " >Learn more</Button> -->
                </div>
              </div>
            </div>
        </a>
        <section class="flex flex-col sm:flex-row tablet:mt-0 mt-[-1px]" >
            <a href="/pickleball" class="w-full group cursor-pointer md:w-[50%] md:h-full" >
                <div  class=" bg-[url('/images/tennis/pickleball.webp')] bg-cover bg-left" >
                  <div class="h-[50vh] flex flex-col items-center justify-center py-5">
                    <div class="bg-black h-[50vh] sm:w-[50vw] w-full absolute opacity-20 group-hover:opacity-40 transition-all duration-300 ease-in-out" ></div>
                    <Text tag="h3" className="uppercase z-10 font-avenirBold xl:text-4xl text-3xl" >
                      Pickleball
                    </Tex>
                    <div class="flex flex-col items-center w-[90%]" >
                      <!-- <Text tag="p" className="uppercase text-pretty font-avenir text-lg xl:text-3xl mobilem:text-xl text-center" >
                        Your own personal<br> <strong class="font-avenirBold" >coach, analyst and umpire</strong>
                      </Text> -->
                      <!-- <Button aria-label="Navigate to the Station page" href={Pages.STATION} className="mt-4 w-64 " >Learn more</Button> -->
                    </div>
                  </div>
                </div>
              </a>
            <a href="/padel" class="w-full group cursor-pointer md:w-[50%] md:h-full" >
                <div  class="xl:bg-[url('/images/tennis/padel.webp')] bg-[url('/images/tennis/padel-mobile.webp')] bg-cover lg:bg-right bg-center " >
                  <div class="relative h-[50vh] flex flex-col items-center justify-center py-5">
                    <div class="bg-black h-[50vh] sm:w-[50vw] w-full absolute opacity-20 group-hover:opacity-40 transition-all duration-300 ease-in-out" ></div>
                    <Text tag="h3" className="uppercase z-10 font-avenirBold xl:text-4xl text-3xl" >
                        Padel
                    </Text>
                    <div class="flex flex-col items-center w-[90%]" >
                      <!-- <Text tag="p" className="uppercase text-pretty font-avenir text-lg xl:text-3xl mobilem:text-xl text-center" >
                        Your own personal<br> <strong class="font-avenirBold" >coach, analyst and umpire</strong>
                      </Text> -->
                      <!-- <Button aria-label="Navigate to the Station page" href={Pages.STATION} className="mt-4 w-64 " >Learn more</Button> -->
                    </div>
                  </div>
                </div>
            </a>
          </section>
    </main>
</Layout>