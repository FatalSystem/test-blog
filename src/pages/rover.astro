---
import Button from "@components/Core/Button.astro"
import Layout from "../layouts/Layout.astro"
import Text from "@components/Core/Text.astro"
import DeviceGridItem from "@components/DeviceGridItem.astro"
import { BackgroundImage } from "astro-imagetools/components"
import { Image } from 'astro:assets'
import RadialGradient from '@components/RadialGradient.tsx'
import RoverHeroMobile from '@components/RoverHeroMobile.tsx'

import VideoPlayer from '@components/VideoPlayer.tsx'

import roverTopView from '@assets/rover/rovertopview.webp'
import roverTopViewTablet from '@assets/rover/rovertopviewtablet.webp'
import roverTopViewMobile from '@assets/rover/rovertopviewmobile.webp'
import roverApp from '@assets/rover/roverapp.webp'
import downloadIOS from '@assets/rover/downloadios.svg'
import downloadAndroid from '@assets/rover/downloadandroid.svg'

---

<Layout title="Welcome to Tennibot.">
    <main class="bg-t-off-black overflow-hidden" >
        <section class="hidden bg-t-off-black md:grid grid-cols-3 text-t-off-white" >
            <div class="absolute z-10 inset-0 top-[15%]" >
                <Text tag="h1" className="font-black uppercase text-5xl px-5 text-center drop-shadow-sm" >How does the rover work?</Text>
                <Text tag="p" className="font-thin uppercase text-3xl mt-3 text-center " >It's as easy as...</Text>
            </div>
            <BackgroundImage src="../src/assets/rover/roverstepone.webp" >
                <div class="h-[95vh]" >
                    <div class=" flex flex-col absolute inset-0 text-center justify-end pb-10 z-10" >
                        <Text tag="h3" className="font-bold text-8xl" >1</Text>
                        <Text tag="p" className="uppercase font-bold text-xl" >Roll onto the court</Text>
                    </div>
                </div>
            </BackgroundImage>
            <BackgroundImage src="../src/assets/rover/station.webp" >
                <div class="absolute inset-0 flex flex-col text-center justify-end pb-10 z-10" >
                    <Text tag="h3" className="font-bold text-8xl"  >2</Text>
                    <Text tag="p" className="font-bold uppercase text-xl" >Place the station</Text>
                </div>
            </BackgroundImage>
            <BackgroundImage src="../src/assets/rover/game.webp" >
                <div class=" absolute inset-0 flex flex-col  text-center justify-end pb-10 z-10" >
                    <Text tag="h3" className="font-bold text-8xl" >3</Text>
                    <Text tag="p" className="font-bold uppercase text-xl" >Focus on your game</Text>
                </div>
            </BackgroundImage>
            <div class="absolute z-[2] w-full h-[95%] bg-gradient-to-b from-t-shade from-10% via-transparent via-70% to-t-shade to-90% opacity-70" ></div> 
        </section>

        <section class="relative md:hidden text-t-off-white" >
            <div class="absolute z-10 inset-0 top-[5%]" >
                <Text tag="h1" className="font-black uppercase text-3xl mobilem:px-9 px-5 text-center drop-shadow-sm" >How does the rover work?</Text>
                <Text tag="p" className="font-thin uppercase text-xl mt-3 text-center " >It's as easy as...</Text>
            </div>
            <RoverHeroMobile client:only="react" />
        </section>

        <section class=" bg-t-off-black overflow-hidden lg:h-[100vh] lg:flex lg:justify-center lg:flex-col text-t-off-white" >
            <div class="w-[80%] mx-auto flex flex-col py-16 overflow-hidden" >
                <Text tag="h2" className="uppercase font-bold text-pretty text-3xl lg:text-4xl text-left tracking-tight min-[600px]:w-[60%] md:w-[50%] z-[1]" >
                    Tennibot:<br> the <span class="before:block before:h-1 before:absolute before:inset-y-4 before:inset-x-0 before:w-full before:-skew-y-12 before:z-10 before:bg-t-green relative" ><span class="text-gray-400 relative ">first</span></span> only autonomous tennis assistant
                </Text>
                <div class="order-last flex flex-col justify-center items-center min-[600px]:items-start min-[600px]:w-[60%] md:w-[50%] z-[1] " >
                    <Text tag="p" className="lg:text-lg text-base text-pretty my-7 tracking-tight" >Using computer vision and machine learning, the Tennibot detects tennis balls and picks them up autonomously. Its advanced navigation algorithms allow it to move smoothly on the court (including fence & net areas) while avoiding obstacles and humans.</Text>
                    <Button href="/buy" theme="ghostGreen" className="w-full  tablet:w-64 "  >Buy now</Button>
                </div>
                <div class="position min-[600px]:absolute min-[600px]:right-[0%] min-[600px]:w-[60%]" >
                    <picture>
                        <source srcset={roverTopViewTablet.src} media="(max-width: 768px)" />
                        <source srcset={roverTopViewMobile.src} media="(max-width: 450px)" />
                        <Image src={roverTopView}  class="w-full" alt="Rover top view illustration" />
                      </picture>
                </div>
            </div>
        </section>

        <section class="bg-t-off-black lg:h-[70vh] min-[670px]:h-fit min-[670px]:pt-16 text-t-off-white" >
            <div class="min-[670px]:w-[80%] w-full lg:h-[60vh] h-fit grid lg:grid-cols-4 min-[670px]:grid-cols-2 min-[670px]:mx-auto min-[670px]:gap-3">
                <DeviceGridItem containerClass="lg:bg-[url('../src/assets/rover/rovercloseup.webp')] min-[670px]:bg-[url('../src/assets/rover/rovercloseuptablet.webp')] bg-[url('../src/assets/rover/rovercloseupmobile.webp')] " >
                    <Text tag="h6" className="z-[1] uppercase text-2xl min-[670px]:text-xl text-center font-bold min-[670px]:font-thin min-[670px]:text-left mb-3" >Hold 80 balls</Text>
                    <Text tag="p" className="z-[1] min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The Tennibot bucket holds up to 80 tennis balls, in an easy-to remove net bag.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('../src/assets/rover/roverballs.webp')] min-[670px]:bg-[url('../src/assets/rover/roverballstablet.webp')] bg-[url('../src/assets/rover/roverballsmobile.webp')]" >
                    <Text tag="h6" className="z-[1] uppercase text-2xl min-[670px]:text-xl text-center font-bold min-[670px]:font-thin min-[670px]:text-left mb-3 mobilem:w-[70%] tablet:w-[60%] min-[670px]:w-full " >Up to 5 hours of battery life</Text>
                    <Text tag="p" className="z-[1] min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The Tennibot can easily handle multiple lessons before needing to recharge.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('../src/assets/rover/roverterrain.webp')] min-[670px]:bg-[url('../src/assets/rover/roverterraintablet.webp')] bg-[url('../src/assets/rover/roverterrainmobile.webp')]" >
                    <Text tag="h6" className="z-[1] uppercase text-2xl min-[670px]:text-xl text-center font-bold min-[670px]:font-thin min-[670px]:text-left mb-3 mobilem:w-[70%] tablet:w-[60%] min-[670px]:w-full" >Works on clay and hard courts</Text>
                    <Text tag="p" className="z-[1] min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >Whether you prefer the speed of hard courts or sliding on clay, Tennibot has got you covered.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('../src/assets/rover/roversize.webp')] min-[670px]:bg-[url('../src/assets/rover/roversizetablet.webp')] bg-[url('../src/assets/rover/roversizemobile.webp')] " >
                    <Text tag="h6" className="z-[1] uppercase text-2xl min-[670px]:text-xl text-center font-bold min-[670px]:font-thin min-[670px]:text-left mb-3" >The size of a suitcase</Text>
                    <Text tag="p" className="z-[1] min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The Tennibot fits in most car trunks and at only 25lbs, it it easy to roll on and off the court.</Text>
                </DeviceGridItem>
            </div>
        </section>

        <section class="bg-t-off-black flex justify-center min-[550px]:h-[50vh] min-[550px]:mt-16 min-[550px]:items-center min-[550px]:pt-0 pt-20 text-t-off-white xl:mt-[10%]" >
            <div class="w-[80%] mx-auto flex min-[550px]:flex-row flex-col items-center justify-center" >
                <div class="min-[550px]:w-[50%] min-[550px]:mb-0 mb-14" >
                    <Text tag="h2" className="font-bold text-pretty text-3xl lg:text-4xl text-center min-[550px]:text-left uppercase"  >Take control</Text>
                    <Text tag="p" className="text-lg text-pretty text-center min-[550px]:text-left my-7 tracking-tight" >The Tennibot app enables you to select specific regions for the Rover to focus on, designate restricted zones for the Rover to avoid, or drive it yourself.</Text>
                    <div class="flex flex-row gap-5 lg:pr-10 min-[550px]:pl-0 px-8" >
                        <a href="https://apps.apple.com/us/app/tennibot/id1438424530" target="_blank" class="cursor-pointer"  ><Image src={downloadIOS}  alt="Download Tennibot on iOS" /></a>
                        <a href="https://play.google.com/store/apps/details?id=com.tennibot&hl=en&gl=US" target="_blank" class="cursor-pointer" ><Image src={downloadAndroid}   alt="Download Tennibot on iOS" /></a>
                    </div>
                </div>
                <div class="min-[550px]:w-[50%] lg:ml-20 min-[550px]:ml-10" >
                    <picture>
                        <!-- <source srcset={lineJudgingMobile.src} media="(max-width: 425px)" /> -->
                        <Image src={roverApp}  class="w-full" alt="Line judging image" />
                    </picture>
                </div>
            </div>
        </section>

        <section class="bg-t-off-black flex justify-center pt-20 text-t-off-white" >
            <div class="w-[80%] lg:pb-24 lg:pt-16 pb-12" >
                <div class="flex flex-row justify-between" >
                    <Text tag="h2" className="text-3xl lg:text-4xl uppercase font-black" >See it in action</Text>
                    <a class="transition ease-in-out delay-150 hidden md:flex flex-row items-center font-avenir text-t-off-white underline uppercase text-lg cursor-pointer hover:text-t-green stroke-t-off-white hover:stroke-t-green duration-200" >
                        View video gallery
                        <svg xmlns="http://www.w3.org/2000/svg" width="42" height="19" viewBox="0 0 52 29" fill="none" class="ml-3" >
                            <path d="M1 14.5H51M51 14.5L36.3659 28M51 14.5L36.3659 1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                </div>

                <div class="h-fit relative overflow-hidden rounded-xl mt-10" >
                    <VideoPlayer client:only="react" />
                    <RadialGradient from="#1C1C1F" to="#141416" />
                </div>
                <div class="flex flex-row justify-center md:hidden mt-10" >
                    <Button onClick="/" theme="ghostLight" className="tablet:w-64 w-full" >View video gallery</Button>
                </div>
            </div>
        </section>

        <section class=" bg-t-off-black lg:pb-32 pt-11 pb-20 text-t-off-white" >
            <div class="w-[80%] flex lg:flex-row flex-col items-center mx-auto h-full" >
                <div>
                    <Text tag="h3" className="uppercase font-thin text-3xl lg:text-4xl mb-5" >Want to learn more?</Text>
                    <Text tag="p" className="" >If you have a question about the Tennibot or how it operates, visit our FAQ's page for more information.</Text>
                </div>
                <div class="lg:w-[50%] lg:mt-0 mt-10 w-full flex lg:justify-end justify-center" >
                    <Button onClick="/" theme="ghostLight" className="tablet:w-64 w-full" >View FAQ's</Button>
                </div>
            </div>
        </section>
    </main>
</Layout>