---
import Button from "@components/core/Button.astro"
import Layout from "../layouts/Layout.astro"
import Text from "@components/core/Text.astro"
import DeviceGridItem from "@components/DeviceGridItem.astro"
import { BackgroundImage } from "astro-imagetools/components"
import { Image } from 'astro:assets'
import RadialGradient from '@components/RadialGradient.tsx'
import RoverHeroMobile from '@components/RoverHeroMobile.tsx'

import VideoPlayer from '@components/VideoPlayer.tsx'
import RoverTitle from '@assets/rover/rovertitle.svg'

import roverTopView from '@assets/rover/rovertopview.webp'
import roverTopViewTablet from '@assets/rover/rovertopviewtablet.webp'
import roverTopViewMobile from '@assets/rover/rovertopviewmobile.webp'
import roverApp from '@assets/rover/roverapp.webp'
import downloadIOS from '@assets/rover/downloadios.svg'
import downloadAndroid from '@assets/rover/downloadandroid.svg'
import { Pages } from "@utils"

---

<Layout title="Welcome to Tennibot.">
    <main class="bg-t-off-black overflow-hidden" >
        <section class="hidden bg-t-off-black min-[830px]:grid grid-cols-3 text-t-off-white" >
            <div class="absolute z-10 inset-0 top-[15%]" >
                <Text tag="h1" className="font-avenirBold uppercase text-5xl px-5 text-center drop-shadow-sm" >How does the rover work?</Text>
                <Text tag="p" className="font-avenir uppercase text-3xl mt-3 text-center " >It's as easy as...</Text>
            </div>
            <div class="bg-[url('/images/rover/roverstepone.webp')] bg-center bg-cover relative" >
                <div class="h-[95vh]" >
                    <div class=" flex flex-col absolute inset-0 text-center justify-end pb-10 z-10" >
                        <Text tag="h3" className="font-avenirBold text-8xl" >1</Text>
                        <Text tag="p" className="uppercase font-avenirBold text-xl xl:text-3xl" >Roll onto the court</Text>
                    </div>
                </div>
            </div>
            <div class="bg-[url('/images/rover/station.webp')] bg-center bg-cover relative" >
                <div class="absolute inset-0 flex flex-col text-center justify-end pb-10 z-10" >
                    <Text tag="h3" className="font-avenirBold text-8xl" >2</Text>
                    <Text tag="p" className="font-avenirBold uppercase text-xl xl:text-3xl" >Place the station</Text>
                </div>
            </div>
            <div class="bg-[url('/images/rover/game.webp')] bg-center bg-cover relative " >
                <div class=" absolute inset-0 flex flex-col  text-center justify-end pb-10 z-10" >
                    <Text tag="h3" className="font-avenirBold text-8xl" >3</Text>
                    <Text tag="p" className="font-avenirBold uppercase text-xl xl:text-3xl" >Focus on your game</Text>
                </div>
            </div>
            <!-- <div class="absolute z-[2] w-full h-[95%] bg-gradient-to-b from-[#232320]/[0.8] from-1% via-transparent via-70% to-[#232320]/[0.8] to-99%" ></div>  -->
        </section>

        <section class="relative min-[830px]:hidden text-t-off-white" >
            <div class="absolute z-10 inset-0 top-[5%] h-fit" >
                <Text tag="h1" className="font-avenirBold uppercase text-3xl mobilem:px-9 px-5 text-center drop-shadow-sm" >How does the rover work?</Text>
                <Text tag="p" className="font-avenir uppercase text-xl mt-3 text-center " >It's as easy as...</Text>
            </div>
            <RoverHeroMobile client:load />
        </section>

        <section class="relative bg-t-off-black overflow-hidden lg:h-[100vh] lg:flex lg:justify-center lg:flex-col text-t-off-white" >
            <div class="w-[80%] mx-auto flex flex-col lg:flex-row flex-nowrap py-16 overflow-visible" >
                <div class="xl:w-[60%] lg:w-[60%] w-[100%]" >
                    <!-- <Text tag="h2" className="uppercase font-avenirBold text-pretty min-[550px]:text-5xl mobilem:text-3xl mobilel:text-4xl text-2xl md:text-6xl lg:text-5xl min-[1440px]:text-6xl text-left tracking-tight" >
                        Tennibot:<br/> the <span class="before:block before:h-1 before:absolute before:inset-y-4 before:inset-x-0 before:w-full before:-skew-y-12 before:z-10 before:bg-t-green relative" ><span class="text-gray-400 relative ">first</span></span> only autonomous<br/> tennis assistant
                    </Text> -->
                    <picture>
                        <Image src={RoverTitle} alt="The only autonmous tennis assistant" class="w-full xl:max-w-[60%]" />
                    </picture>
                    <picture class="w-fit lg:hidden" >
                        <source srcset={roverTopViewTablet.src} media="(max-width: 1024px)" />
                        <source srcset={roverTopViewMobile.src} media="(max-width: 450px)" />
                        <Image src={roverTopView}  class="w-full my-10" alt="Rover top view illustration" />
                    </picture>
                    <div class="flex flex-col justify-center items-center lg:items-start" >
                        <Text tag="p" className="font-plutoLight xl:text-lg 2xl:text-xl text-pretty my-7 tracking-tight" >Using computer vision and machine learning, the Tennibot detects tennis balls and picks them up autonomously. Its advanced navigation algorithms allow it to move smoothly on the court (including fence & net areas) while avoiding obstacles and humans.</Text>
                        <Text tag="p" className="md:hidden text-base text-pretty mb-7 font-plutoLight tracking-tight" >When the bucket is full, the Tennibot will deliver the balls to you and go back to work, without any hassle.</Text>
                        <Button href="/buy" theme="ghostGreen" className="w-full  tablet:w-64 "  >Buy now</Button>
                    </div>
                </div>
                <div class="w-[100%] lg:w-[50%] hidden lg:block overflow-visible" >
                    <picture class="static w-[100%] lg:absolute top-[-15%]   min-[1685px]:top-[0%] lg:top-[25%] min-[1600px]:top-[15%] xl:right-[0%] lg:right-[0%] xl:w-[50%] lg:w-[50%]" >
                        <source srcset={roverTopViewTablet.src} media="(max-width: 768px)" />
                        <source srcset={roverTopViewMobile.src} media="(max-width: 450px)" />
                        <Image src={roverTopView}  class="w-full" alt="Rover top view illustration" />
                    </picture>
                </div>
            </div>
        </section>

        <section class="bg-t-off-black min-[670px]:h-fit min-[670px]:pt-16 text-t-off-white" >
            <div class="min-[670px]:w-[80%] w-full h-fit grid lg:grid-cols-4 min-[670px]:grid-cols-2 min-[670px]:mx-auto min-[670px]:gap-3">
                <DeviceGridItem containerClass="lg:bg-[url('/images/rover/rovercloseup.webp')] min-[670px]:bg-[url('/images/rover/rovercloseupmobile.webp')] bg-[url('/images/rover/rovercloseupmobile.webp')] " >
                    <Text tag="h6" className="z-[1] uppercase text-2xl min-[670px]:text-xl text-center font-avenirBold min-[670px]:font-avenir min-[670px]:font-thin min-[670px]:text-left mb-3" >Hold 80 balls</Text>
                    <Text tag="p" className="z-[1] min-[670px]:w-full w-[80%] text-center min-[670px]:text-left font-avenir text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The Tennibot bucket holds up to 80 tennis balls, in an easy-to remove net bag.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('/images/rover/roverballs.webp')] min-[670px]:bg-[url('/images/rover/roverballsmobile.webp')] bg-[url('/images/rover/roverballsmobile.webp')]" >
                    <Text tag="h6" className="z-[1] uppercase text-2xl min-[670px]:text-xl text-center font-avenirBold min-[670px]:font-avenir min-[670px]:font-thin min-[670px]:text-left mb-3 mobilem:w-[70%] tablet:w-[60%] min-[670px]:w-full " >Up to 5 hours of battery life</Text>
                    <Text tag="p" className="z-[1] min-[670px]:w-full w-[80%] text-center min-[670px]:text-left font-avenir text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The Tennibot can easily handle multiple lessons before needing to recharge.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('/images/rover/roverterrain.webp')] min-[670px]:bg-[url('/images/rover/roverterrainmobile.webp')] bg-[url('/images/rover/roverterrainmobile.webp')]" >
                    <Text tag="h6" className="z-[1] uppercase text-2xl min-[670px]:text-xl text-center font-avenirBold min-[670px]:font-avenir min-[670px]:font-thin min-[670px]:text-left mb-3 mobilem:w-[70%] tablet:w-[60%] min-[670px]:w-full" >Works on clay and hard courts</Text>
                    <Text tag="p" className="z-[1] min-[670px]:w-full w-[80%] text-center min-[670px]:text-left font-avenir text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >Whether you prefer the speed of hard courts or sliding on clay, Tennibot has got you covered.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('/images/rover/roversize.webp')] min-[670px]:bg-[url('/images/rover/roversizemobile.webp')] bg-[url('/images/rover/roversizemobile.webp')] " >
                    <Text tag="h6" className="z-[1] uppercase text-2xl min-[670px]:text-xl text-center font-avenirBold min-[670px]:font-avenir min-[670px]:font-thin min-[670px]:text-left mb-3" >The size of a suitcase</Text>
                    <Text tag="p" className="z-[1] min-[670px]:w-full w-[80%] text-center min-[670px]:text-left font-avenir text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The Tennibot fits in most car trunks and at only 25lbs, it it easy to roll on and off the court.</Text>
                </DeviceGridItem>
            </div>
        </section>

        <section class="bg-t-off-black flex justify-center py-36 md:py-40 lg:py-56 2xl:py-64 min-[550px]:items-center text-t-off-white " >
            <div class="w-[80%] 2xl:w-[65%] mx-auto flex min-[550px]:flex-row flex-col items-center justify-center" >
                <div class="min-[550px]:w-[50%] min-[550px]:mb-0 mb-14" >
                    <Text tag="h2" className="font-avenir text-pretty text-3xl lg:text-4xl text-left uppercase"  >Take <span class="font-avenirBold" >control</span></Text>
                    <Text tag="p" className="font-plutoLight text-xs 2xl:text-xl text-pretty  my-7 tracking-tight" >The Tennibot app enables you to select specific regions for the Rover to focus on, designate restricted zones for the Rover to avoid, or drive it yourself.</Text>
                    <div class="flex flex-row gap-5 lg:pr-10 min-[550px]:pl-0 px-8" >
                        <a href="https://apps.apple.com/us/app/tennibot/id1438424530" target="_blank" class="cursor-pointer"  ><Image src={downloadIOS}  alt="Download Tennibot on iOS" /></a>
                        <a href="https://play.google.com/store/apps/details?id=com.tennibot&hl=en&gl=US" target="_blank" class="cursor-pointer" ><Image src={downloadAndroid}   alt="Download Tennibot on iOS" /></a>
                    </div>
                </div>
                <div class="min-[550px]:w-[50%] lg:ml-20 min-[550px]:ml-10" >
                    <picture>
                        <!-- <source srcset={lineJudgingMobile.src} media="(max-width: 425px)" /> -->
                        <Image src={roverApp} class="mx-auto" alt="Line judging image" />
                    </picture>
                </div>
            </div>
        </section>

        <section class="bg-t-off-black flex justify-center text-t-off-white" >
            <div class="w-[80%] 2xl:w-[65%] lg:pb-24 lg:pt-16 pb-12" >
                <div class="flex flex-row justify-between" >
                    <Text tag="h2" className="text-3xl lg:text-4xl uppercase font-avenirBold" >See it in action</Text>
                </div>

                <div class="w-full sm:grid sm:grid-cols-2 flex flex-col mt-5 gap-5" >
                    <div class="rounded-lg bg-[url('/images/rover/setupthumbnail.webp')] bg-center bg-cover overflow-hidden" >
                        <button class="lg:h-[50vh] w-full relative flex flex-col justify-center items-center md:h-[30vh] h-[30vh]" >
                            <svg xmlns="http://www.w3.org/2000/svg" width="57" height="72" viewBox="0 0 57 72" fill="none">
                                <path opacity="0.65" d="M54.5722 31.5497C57.8093 33.722 57.8093 38.278 54.5722 40.4503L9.06586 70.9893C5.25966 73.5437 0 70.9618 0 66.539V5.46099C0 1.03824 5.25965 -1.54367 9.06585 1.01064L54.5722 31.5497Z" fill="#F6F7F2"/>
                              </svg>
                              <Text className="font-avenir absolute left-[5%] bottom-[5%] text-t-off-white uppercase text-lg lg:text-2xl 2xl:text-3xl">Setup</Text>
                        </button>
                    </div>
                    <div class="rounded-lg bg-[url('/images/rover/timelapsethumbnail.webp')] bg-center bg-cover overflow-hidden" >
                        <button class="lg:h-[50vh] w-full  relative flex flex-col justify-center items-center md:h-[30vh] h-[30vh]" >
                            <svg xmlns="http://www.w3.org/2000/svg" width="57" height="72" viewBox="0 0 57 72" fill="none">
                                <path opacity="0.65" d="M54.5722 31.5497C57.8093 33.722 57.8093 38.278 54.5722 40.4503L9.06586 70.9893C5.25966 73.5437 0 70.9618 0 66.539V5.46099C0 1.03824 5.25965 -1.54367 9.06585 1.01064L54.5722 31.5497Z" fill="#F6F7F2"/>
                              </svg>
                              <Text className="font-avenir absolute left-[5%] bottom-[5%] text-t-off-white uppercase text-lg lg:text-2xl 2xl:text-3xl">One hour timelapse</Text>
                        </button>
                    </div>
                </div> 
            </div>
        </section>

        <section class=" bg-t-off-black lg:pb-32 pt-11 pb-20 text-t-off-white" >
            <div class="w-[80%] 2xl:w-[65%] flex md:flex-row flex-col items-end mx-auto h-full " >
                <div>
                    <Text tag="h3" className="uppercase font-avenir text-2xl lg:text-4xl 2xl:text-5xl mb-5" >Want to learn more?</Text>
                    <Text tag="p" className="font-plutoLight lg:text-lg 2xl:text-xl md:w-[90%] 2xl:w-[70%]" >If you have a question about the Tennibot or how it operates, visit our FAQ's page for more information.</Text>
                </div>
                <div class="lg:w-[50%] lg:mt-0 mt-10 w-full flex lg:justify-end justify-center" >
                    <Button href={Pages.FAQ} theme="ghostLight" >View FAQ's</Button>
                </div>
            </div>
        </section>
    </main>
</Layout>