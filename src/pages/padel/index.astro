---
import NHero from "@components/NHero.astro";
import Layout from "layouts/Layout.astro";

import SaveupIcon from "@assets/newdesignimages/SaveupIcon.png";
import AutomateIcon from "@assets/newdesignimages/AutomateIcon.png";

import Text from "@components/core/Text.astro"
import { Image } from 'astro:assets'
import roverApp from '@assets/rover/roverapp.webp'

import phoneIcon from '@assets/new/pickleball/phone.svg'
import courtsIcon from '@assets/new/pickleball/courts.svg'
import resistantIcon from '@assets/new/pickleball/resistant.svg'
import DraggableSlider from "@components/DraggableSlider";
import TestimonialItem from "@components/TestimonialItem";
import NewFAQ from "@components/NewFAQ";
import padelPartnerBg from '@assets/new/padel/tennibot-padel-partner-side-court.webp'
import VideoHero from "@components/VideoHero";
import gearIcon from '@assets/icons/gear.svg'

const padelFAQ: Array<{ question: string, answer: string }> = [
  {
    question: 'What makes The Partner different from other padel machines?',
    answer: 'The Partner is the first AI-powered padel machine that moves and responds to your position on the court in real time. Unlike traditional machines, it tracks your movement and delivers shots that replicate the feel of a real opponent.'
  },
  {
    question: 'How does The Partner detect players and adjust shots?',
    answer: 'The Partner uses advanced sensors, AI, and computer vision to detect player positioning, court boundaries, and the ball. It automatically calibrates and adjusts its shots dynamically for realistic, match-like play.'
  },
  {
    question: 'Is The Partner safe to use on a padel court?',
    answer: 'Yes. The Partner features intelligent safety systems that detect humans and obstacles, pausing operation if anything gets too close.'
  },
  {
    question: 'When will I receive my Partner if I order today?',
    answer: 'Your Partner will be shipped 6–7 weeks after your order is placed.'
  },
  {
    question: 'Is there a warranty on The Partner?',
    answer: 'Yes. Every Partner unit includes a three-year warranty that covers manufacturing defects.'
  },
  {
    question: 'Where is The Partner made?',
    answer: 'The Partner is proudly designed and assembled in the USA with high-quality craftsmanship.'
  },
]

---
<Layout title="Tennibot | Padel Ball Machines">
  <VideoHero 
        client:only="react" 
        title="Explore AI-Powered <span class='text-t-green drop-shadow-lg font-avenirBold'>Padel Gear</span><br class='hidden sm:block'/> That’s Changing the game"
        description="Discover the most advanced padel ball machine, and the <br class='hidden sm:block'/> only autonomous ball collector – powered by AI"
        primaryCta={{
            text: "Ball Machine",
            href: "/padel/ball-machine"
        }}
        secondaryCta={{
            text: "Ball Collector", 
            href: "/padel/ball-collector"
        }}
        videoSource="https://d21pdw38fc8384.cloudfront.net/padel-hero-bg.mp4"
    />
    <!-- <NHero heroStyle="bg-[url('/images/new/pickleball/pickleball-hero.webp')]" primaryCta="Ball machine" secondaryCta="Ball collector" primaryCtaLink="/padel/ball-machine" secondaryCtaLink="/padel/ball-collector" >
        <h1
        slot="title"
        class="text-xl uppercase mobilem:text-2xl drop-shadow-lg mobilel:text-3xl font-avenirBold sm:text-3xl md:text-4xl lg:text-4xl font-bold mb-3 sm:mb-5 leading-tight animate-fade-in-up text-white"
        >
          Explore AI-Powered <span class="text-t-green drop-shadow-lg font-avenirBold ">Padel Gear</span><br class="hidden sm:block"/> That’s Changing the game
        </h1>
        <p
        slot="description"
        class="text-sm drop-shadow-lg font-plutoLight sm:text-base md:text-lg mb-6 sm:mb-8 opacity-90 leading-relaxed animate-fade-in-up delay-200 text-white max-w-2xl mx-auto"
        >
          Discover the most advanced padel ball machine, and the<br class="hidden sm:block"/> only autonomous ball collector – powered by AI
        </p>
    </NHero> -->

    <section id="products" class="py-16 sm:py-20 lg:py-24 bg-[#191A16] relative z-10" role="region" aria-label="Product showcase">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
            <div class="text-center mb-12 sm:mb-16 lg:mb-20">
              <h2 class="text-xl mobilel:text-2xl uppercase sm:text-4xl lg:text-5xl font-avenirBold mb-4 sm:mb-6 leading-tight text-white">
                    Upgrade Your Padel Game<br class="hidden min-[750px]:block"/> With <span class="text-t-green">AI-Powered Gear</span>
                </h2>
                <p class="text-base sm:text-lg font-plutoLight text-t-off-white px-4">
                    Explore Our Smart Ball Machines & Automatic Ball Retrievers
                </p>
            </div>
      
            <div class="flex flex-col sm:justify-center sm:flex-row sm:flex-nowrap sm:[&::-webkit-scrollbar]:hidden gap-6 sm:gap-5 md:gap-8">
              <article class=" bg-[url('/images/new/padel/padel-partner-on-court.webp')] bg-cover bg-center text-left relative sm:min-w-[350px] rounded-2xl md:h-[550px] h-[50vh] overflow-hidden">
                    <!-- <img     
                        src={padelPartnerOnCourt.src}
                        alt="Tennibot Partner - AI-powered padel ball machine with programmable drills"     
                        fetchpriority="high"     
                        class="w-full h-full object-cover"
                    /> -->
                    
                    <div class="absolute flex flex-col justify-end bottom-0 top-0 left-0 right-0 p-6 sm:p-8 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
                        <h3 class="text-xl uppercase sm:text-2xl font-avenirBold mb-2 text-white"><span class="font-plutoLight" >Padel<br /></span> Ball Machine</h3>
                        <p class="text-sm sm:text-base font-pluto text-gray-200 mb-4 sm:mb-6 leading-relaxed">
                          Train with precision and elevate your sessions using the Tennibot Partner – the AI-powered padel machine built for focused, match-like drills.
                        </p>
                        <a href="/padel/ball-machine" class={`w-full text-sm sm:text-base rounded-full py-3 px-8 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green hover:bg-t-green hover:text-t-off-black`}>
                            Shop now
                        </a>
                    </div>
                </article>

                <article class=" bg-[url('/images/new/padel/padelbot-on-court.webp')] bg-cover bg-center text-left relative sm:min-w-[350px] rounded-2xl md:h-[550px] h-[50vh] overflow-hidden">
                    <!-- <img     
                        src={TennibotRover.src}
                        alt="Tennibot Rover - Automatic padel ball collector and retriever"     
                        fetchpriority="high"     
                        class="w-full h-full object-cover"
                    /> -->
                    
                    <div class="absolute flex flex-col justify-end bottom-0 top-0 left-0 right-0 p-6 sm:p-8 bg-gradient-to-t from-black/60 via-black/40 to-transparent">
                        <h3 class="text-xl uppercase sm:text-2xl font-avenirBold mb-2 text-white"><span class="font-plutoLight" >Padel<br /></span> Ball Collector</h3>
                        <p class="text-sm sm:text-base font-pluto text-gray-200 mb-4 sm:mb-6 leading-relaxed">
                            Automate ball retrieval with the Tennibot Rover – a smart, portable collector built for every padel court.
                        </p>
                        <a href="/padel/ball-collector" class={`w-full text-sm sm:text-base rounded-full py-3 px-8 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green hover:bg-t-green hover:text-t-off-black`}>
                            Reserve now
                        </a>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section
      class="py-16 sm:py-20 bg-[url('/images/new/padel/padel-wheels-bg.webp')] bg-cover bg-center lg:py-24"
      role="region"
      aria-label="AI Partner"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 min-h-[55vh] flex flex-col justify-between relative z-10">
        <div class="mb-8 sm:mb-12">
          <h2
              class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-center font-avenirBold mb-5 leading-tight text-white uppercase"
            >
                Why AI Gear Elevates Your <br class="hidden sm:block" /><span class="text-t-green">Padel Training</span>
            </h2>
            <p class="text-sm sm:text-lg font-plutoLight text-center text-t-off-white px-4">
                Tennibot’s padel solutions let you focus on your game, without the hassle
            </p>
        </div>

        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            <div class="flex items-center gap-3 sm:gap-4">
              <img
                src={AutomateIcon.src}
                alt="Automate training sessions icon"
                class="w-5 h-5 sm:w-6 sm:h-6 object-contain flex-shrink-0"
              />
              <p class="text-sm sm:text-base font-pluto text-t-off-white">
                Precise shot delivery with custom drills powered by AI
              </p>
            </div>

            <div class="flex items-center gap-3 sm:gap-4">
              <img
                src={SaveupIcon.src}
                alt="Save court time icon"
                class="w-5 h-5 sm:w-6 sm:h-6 object-contain flex-shrink-0"
              />
              <p class="text-sm sm:text-base font-pluto text-t-off-white">
                Perfect for players, coaches and clubs
              </p>
            </div>

            <div class="flex items-center gap-3 sm:gap-4">
              <img
                src={SaveupIcon.src}
                alt="Built for all surfaces icon"
                class="w-5 h-5 sm:w-6 sm:h-6 object-contain flex-shrink-0"
              />
              <p class="text-sm sm:text-base font-pluto text-t-off-white">
                Human-like rallies and hundreds of drill combinations
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24 bg-t-off-black flex flex-col justify-center min-[550px]:items-center text-t-off-white" role="region" aria-label="Mobile app control">
        <div class="mb-8 sm:mb-12">
            <h2
              class="text-2xl uppercase md:w-full w-[95%] mx-auto mobilem:text-3xl  sm:text-3xl md:text-4xl lg:text-5xl text-center font-avenirBold leading-tight text-white"
            >
                Build Your Smart Padel<br class="hidden sm:block"/> Court With <span class="text-t-green">Tennibot</span>
            </h2>
            <p class="mobilel:text-base text-sm mt-3 font-plutoLight text-center text-t-off-white px-4">
                Use Tennibot gear individually or as an integrated system. <br class="hidden sm:block" />Automate drills and collect balls hands-free - all powered by AI.
            </p>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 flex md:flex-row flex-col-reverse items-center justify-center" >
          <div class="md:w-[50%] md:mb-0 mb-14 md:ml-10" >
                <picture>
                    <!-- <source srcset={lineJudgingMobile.src} media="(max-width: 425px)" /> -->
                    <Image src={roverApp} class="mx-auto w-full max-w-sm sm:max-w-md lg:max-w-lg" alt="Tennibot mobile app interface for controlling padel ball machines and collectors" />
                </picture>
            </div>
            <div class="md:w-[50%] md:mb-0 mb-14 md:ml-10" >
                <div class="flex flex-row items-center gap-3 sm:gap-4 mb-10">
                    <div class="bg-[#262424] rounded-lg p-3 size-12 flex items-center justify-center" >
                        <Image src={phoneIcon.src} alt="Tennibot mobile app interface for controlling padel ball machines and collectors" class="size-full" />
                    </div>
                    <div>
                        <Text tag="p" className="font-avenirBold text-base text-pretty tracking-tight" >Shared interface and app integration</Text> 
                        <Text tag="p" className="font-pluto text-sm text-pretty mt-1 tracking-tight" >Control all devices from one intuitive mobile app</Text>
                    </div>
                </div>
                <div class="flex flex-row items-center gap-3 sm:gap-4 mb-10">
                    <div class="bg-[#262424] rounded-lg p-3 size-12 flex items-center justify-center" >
                        <Image src={courtsIcon.src} alt="Tennibot mobile app interface for controlling padel ball machines and collectors" class="size-full" />
                    </div>
                    <div>
                        <Text tag="p" className="font-avenirBold text-base text-pretty tracking-tight" >Works with all standard padel courts</Text> 
                        <Text tag="p" className="font-pluto text-sm text-pretty mt-1 tracking-tight" >Easy setup on any court surface or configuration</Text>
                    </div>
                </div>
                <div class="flex flex-row items-center gap-3 sm:gap-4 mb-10">
                  <div class="bg-[#262424] rounded-lg p-3 min-[500px]:size-12 size-14 flex items-center justify-center" >
                    <Image src={gearIcon.src} alt="Tennibot mobile app interface for controlling tennis ball machines and collectors" class="size-full" />
                  </div>
                    <div>
                        <Text tag="p" className="font-avenirBold text-base text-pretty tracking-tight" >Built for All Courts and Conditions</Text> 
                        <Text tag="p" className="font-pluto text-sm text-pretty mt-1 tracking-tight" >Engineered to perform indoors or outdoors,<br class="hidden sm:block"/> with a durable design.</Text>
                    </div>
                </div>
                <div class="justify-center flex md:block" >
                    <a href="https://calendly.com/haithameletrabi/30-minute-meeting-tennibot-demo" target="_blank" class="w-full px-10 cursor-pointer text-sm sm:text-base lg:text-lg rounded-full py-3 sm:py-2 lg:py-3 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green hover:bg-t-green hover:text-t-off-black" >
                        Book a demo
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="py-24 sm:py-20 lg:py-28 bg-[#262424]" role="region" aria-label="Frequently asked questions">
        <div class="max-w-7xl w-[95%] mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
            <h2 class="text-2xl uppercase sm:text-3xl md:text-3xl lg:text-5xl text-center font-avenirBold text-white mb-4 sm:mb-16 leading-tight">
                Why Padel needs<br class="hidden md:block" />
                <span class="text-t-green">Smart Solutions</span>
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-12">
                <div>
                    <Text tag="p" className="font-avenirBold text-base mobilel:text-lg md:text-xl text-t-green text-pretty tracking-tight" >
                      A Sport on the Rise
                    </Text> 

                    <Text tag="p" className="font-pluto text-t-off-white sm:text-base text-sm text-pretty mt-1 tracking-tight" >
                      Padel is growing rapidly across clubs and facilities worldwide, with more players demanding smarter ways to train. As the game becomes faster and more competitive, traditional training methods can’t keep up.
                      <br /><br />Manual ball pickup, inconsistent feeds, and lack of structured drills limit player development and waste valuable court time.
                    </Text>
                </div>
                <div>
                  <Text tag="p" className="font-avenirBold text-base mobilel:text-lg md:text-xl text-t-green text-pretty tracking-tight" >
                    Common Challenges in Padel Training
                  </Text> 

                  <Text tag="p" className="font-pluto text-t-off-white sm:text-base text-sm text-pretty mt-1 tracking-tight" >
                    Manual ball collection breaks the rhythm of practice. Unreliable ball feeds make it hard to run structured drills or simulate match play. Inconsistent training setups limit progress and slow down development.
                    <br /><br />Getting accurate, consistent shots from a moving ball machine used to sound like science fiction. With Tennibot Partner, it’s now part of everyday training.
                    <br /><br />Players lose valuable court time to repetitive tasks. Coaches find it difficult to deliver consistent, high-quality training across different skill levels.
                  </Text>
                </div>
                <div>
                    <Text tag="p" className="font-avenirBold text-base mobilel:text-lg md:text-xl text-t-green text-pretty tracking-tight" >
                      Smarter Padel Training Starts Here
                    </Text> 

                    <Text tag="p" className="font-pluto text-t-off-white sm:text-base text-sm text-pretty mt-1 tracking-tight" >
                      Tennibot’s AI-powered gear is built to solve the real challenges of padel training. The Tennibot Partner delivers precise, programmable feeds so players can focus on footwork, technique, and shot selection. Meanwhile, the Rover handles ball collection automatically with no interruptions and no wasted time.
                      <br/><br />Whether you’re training solo or coaching a team, Tennibot helps you run more efficient sessions and keep the focus where it belongs, on performance.
                    </Text>
                </div>
            </div>
        </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24 bg-t-off-black" role="region" aria-label="Customer testimonials">
        <div>
            <div class="text-center max-w-[80%] mx-auto mb-12 sm:mb-16 lg:mb-20">
              <h2 class="text-2xl sm:text-3xl md:text-4xl font-avenirBold mb-4 sm:mb-6 leading-tight text-t-off-white uppercase">What <span class="text-t-green">players & coaches</span><br class="hidden sm:block"/> say about tennibot</h2>
            </div>
            <DraggableSlider client:load className="gap-10" >
                <TestimonialItem client:load quote={`"“This is really impressive, any of the tennis ball machines I used in the past don’t compare to this... they’re highly predicable, this ones not as predictable.”`} name="Charlie Harrison" location="Auburn, AL" videoSource="https://player.vimeo.com/video/1106005248" className="bg-[url('/images/new/home/charlie-testimonial.webp')]" />
                <TestimonialItem client:load quote={`"It's fantastic for drilling, practice points, and even doubles drills. I really enjoyed it."`} name="Sylvana Jordyn" location="Rockville, MD" videoSource="https://player.vimeo.com/video/1031406658" className="bg-[url('/images/partner/testimonial-one.png')]" />
                <TestimonialItem client:load quote={`"I worked on rapid-fire volleys, reflexes, and range at the net—it's perfect for sharpening your skills."`} name="Logan West" location="Washington, DC" videoSource="https://player.vimeo.com/video/1031406854" className="bg-[url('/images/partner/testimonial-two.png')]" />
                <TestimonialItem client:load quote={`"What surprised me the most was how much I had to move and anticipate—it felt just like a real hitting session."`} name="Alex Chan" location="Rockville, MD" videoSource="https://player.vimeo.com/video/1031406731" className="bg-[url('/images/partner/testimonial-three.png')]" />
                <TestimonialItem client:load quote={`"The Tennibot Partner is an amazing ball machine—it moves, evolves, and offers an experience unlike any other ball machine I've played with before."`} name="Mo Eldemerdash" location="Auburn, AL" videoSource="https://player.vimeo.com/video/1031426621" className="bg-[url('/images/partner/testimonial-four.png')]" />
            </DraggableSlider>
        </div>
      </section>

      <section class="py-16 sm:py-20 lg:py-24 bg-[#262424]" role="region" aria-label="Frequently asked questions">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12">
            <div>
              <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl font-avenirBold text-white mb-4 sm:mb-6 uppercase leading-tight">
                Common Questions<br class="hidden lg:block" /> About <span class="text-t-green">Tennibot <br class="hidden lg:block" />Padel Gear</span>
              </h2>
              <p class="text-sm sm:text-base lg:text-lg font-pluto text-t-off-white opacity-95 mb-6 sm:mb-8">
                Join the revolution in padel training today!
              </p>
              <p class="text-xs sm:text-sm lg:text-base font-pluto text-t-off-white">
                Got more questions? Give us a ring at<br class="hidden md:block" />
                <a href="tel:2512778022" class="text-t-green font-avenirBold">251-277-8022</a>
              </p>
            </div>
            
              <NewFAQ client:only="react" faq={padelFAQ} />
          </div>
        </div>
      </section>

      <section class="relative py-16 sm:py-20 lg:py-24 overflow-hidden" role="region" aria-label="Call to action">
        <img 
          src={padelPartnerBg.src} 
          alt="Tennibot Station and Rover tennis ball machines on the court" 
          class="absolute bottom-0 left-0 w-full h-full object-cover object-bottom pointer-events-none z-10" 
        />
        <div class="min-h-[60vh] max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 text-center relative z-10 flex flex-col justify-start">
          <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-avenirBold text-t-off-white mb-6 sm:mb-8 leading-tight uppercase">
            Smarter padel starts here.<br class="hidden sm:block" />
            <span class="text-t-green">Are you ready?</span>
          </h2>
          
          <div class="flex flex-col w-full sm:flex-row justify-center gap-4 max-w-md sm:max-w-none mx-auto">
            <a href="/padel/ball-machine" class="w-full sm:w-48 lg:w-64 text-sm sm:text-base lg:text-lg rounded-full py-3 sm:py-2 lg:py-3 font-avenir uppercase border-2 transition duration-300 text-center bg-t-green border-t-green text-t-off-black hover:bg-opacity-90">
              SHOP NOW
            </a>
            <a href="https://calendly.com/haithameletrabi/30-minute-meeting-tennibot-demo" target="_blank" class="w-full sm:w-48 lg:w-64 text-sm sm:text-base lg:text-lg rounded-full py-3 sm:py-2 lg:py-3 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green hover:bg-t-green hover:text-t-off-black">
              BOOK A DEMO
            </a>
          </div>
        </div>
      </section>
</Layout>