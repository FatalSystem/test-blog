ill="#F6F7F2"/>
                    </svg>
                    <Text tag="p" className={perksTextStyle} >
                        Tennibot care
                    </Text>
                </div>

                <div class={perksStyle}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="55" height="45" viewBox="0 0 55 49" fill="none">
                        <path d="M54.9411 24.5661C54.1663 21.1049 51.098 18.7008 47.5727 18.6259C47.4392 18.623 47.3032 18.6136 47.1259 18.6056C46.468 12.4311 43.6799 7.48574 38.6032 3.9371C35.2475 1.59137 31.5195 0.482332 27.5 0.500213C23.4805 0.482332 19.7525 1.59137 16.3968 3.9371C11.3201 7.48574 8.53204 12.4311 7.87418 18.6056C7.6968 18.6136 7.56086 18.623 7.42738 18.6259C3.90196 18.7008 0.833686 21.1049 0.0588112 24.5661L0 32.1224C0.344058 34.0095 1.25834 35.5551 2.75186 36.7461C4.78747 38.3694 7.16167 38.6394 9.62594 38.3696C10.8845 38.232 11.2968 37.6391 11.2968 36.3555C11.2975 31.032 11.271 25.7082 11.3164 20.3851C11.3271 19.1153 11.4653 17.8231 11.7346 16.5828C13.3825 9.00346 20.2344 3.95498 27.5 3.95456C34.7656 3.95498 41.6175 9.00346 43.2653 16.5828C43.5347 17.8231 43.6729 19.1153 43.6836 20.3851C43.7291 25.7082 43.7025 31.032 43.7031 36.3555C43.7031 36.3962 43.7047 36.4342 43.7056 36.4733C42.0924 41.9786 38.6528 44.0633 33.0184 43.8989V45.7586C38.2521 46.4299 43.3441 43.2069 45.2053 38.3464C45.2604 38.3548 45.3152 38.3633 45.3741 38.3696C47.8383 38.6394 50.2123 38.3694 52.2481 36.7461C53.7417 35.5551 54.656 34.0095 55 32.1224L54.9411 24.5661Z" fill="#F6F7F2"/>
                        <path d="M29.6202 41.5521C28.4905 41.5316 27.3602 41.5316 26.2303 41.5524C24.7876 41.579 23.6073 43.1304 23.5886 44.9905C23.5702 46.8354 24.6872 48.3867 26.1304 48.4808C26.7287 48.5197 27.3297 48.4873 27.9296 48.4871C28.5292 48.4868 29.1303 48.5197 29.7287 48.4805C31.1717 48.3852 32.2874 46.8313 32.2661 44.9855C32.2445 43.1256 31.0637 41.5782 29.6202 41.5521Z" fill="#F6F7F2"/>
                    </svg>
                    <Text tag="p" className={perksTextStyle} >
                        Dedicated support
                    </Text>
                </div>

                <div class={perksStyle}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" viewBox="0 0 61 61" fill="none">
                        <path d="M29.5831 61C30.0823 56.7246 30.424 52.4226 31.1577 48.1877C31.6581 45.2945 32.4124 42.3555 33.6259 39.6966C35.395 35.8198 38.8416 33.6785 42.9797 32.9472C48.3523 31.9967 53.7717 31.3065 59.1407 30.5081L59.1383 30.4906C53.7686 29.6929 48.3499 29.0021 42.9773 28.0522C38.8393 27.3203 35.3926 25.1796 33.6236 21.3027C32.4093 18.6439 31.6558 15.7049 31.1554 12.8117C30.4216 8.57738 30.0793 4.27541 29.5807 0H29.5582C29.059 4.2748 28.7168 8.57738 27.9836 12.8117C27.4826 15.7049 26.7289 18.6439 25.5154 21.3027C23.7463 25.1796 20.2996 27.3203 16.1616 28.0522C10.789 29.0021 5.36967 29.6929 0 30.4906L0.00299428 30.5081C5.37211 31.3065 10.7914 31.9967 16.1641 32.9472C20.3021 33.6785 23.7488 35.8198 25.5178 39.6966C26.7314 42.3555 27.4851 45.2945 27.9861 48.1877C28.7198 52.422 29.0614 56.7246 29.5607 61" fill="#F6F7F2"/>
                        <path d="M50.4964 23.3213C50.6738 21.802 50.7956 20.2729 51.0562 18.7681C51.2343 17.7403 51.5021 16.6956 51.9335 15.7505C52.5617 14.3731 53.7867 13.6122 55.2571 13.352C57.1662 13.0144 59.0922 12.7692 61 12.4854L60.9994 12.4794C59.091 12.1961 57.1656 11.9504 55.2565 11.6128C53.7856 11.3531 52.5611 10.5922 51.9322 9.21421C51.5009 8.26975 51.2331 7.22505 51.0549 6.19725C50.7944 4.6924 50.6733 3.16339 50.4958 1.64404H50.488C50.3104 3.16339 50.1885 4.6924 49.9282 6.19725C49.75 7.22505 49.4822 8.26975 49.0514 9.21421C48.4226 10.5922 47.1976 11.3531 45.7272 11.6128C43.8181 11.9504 41.8921 12.1961 39.9844 12.4794L39.9849 12.4854C41.8933 12.7692 43.8188 13.0144 45.7278 13.352C47.1988 13.6122 48.4231 14.3731 49.0521 15.7505C49.4834 16.6956 49.7512 17.7403 49.9293 18.7681C50.1899 20.2729 50.311 21.802 50.4885 23.3213" fill="#F6F7F2"/>
                    </svg>
                    <Text tag="p" className={perksTextStyle} >
                        Premium experience
                    </Text>
                </div>
            </div>
        </section>

        <section class="relative" >
            <CCSlider client:only="react" type="coaches" />
        </section>
        <section class="relative" >
            <CCSlider client:only="react" type="clubs" />
        </section>
        <section class="relative" >
            <CCSlider client:only="react" type="school" />
        </section>

        <!-- <section>
            <div class="w-[80%] mx-auto pb-20" >
                <div class="mt-20 mb-10" >
                    <Text tag="h2" className="font-avenir font-light uppercase text-t-off-white text-3xl sm:text-4xl lg:text-5xl" ><span class="font-avenirBold">Tennibot</span> commercial</Text>
                    <Text tag="p" className="font-plutoLight sm:text-lg lg:text-xl md:w-[100%] lg:w-[80%] xl:w-[60%] mt-3 text-t-off-white" >Whether you’re interested in placing an order or you’d just like to learn more, we’d love to connect with you.</Text>
                </div>

                <CommercialForm client:load /> 
            </div>
        </section> -->

    </main>
</Layout>