---
import Button from "@components/core/Button.astro"
import Layout from "../layouts/Layout.astro"
import Text from "@components/core/Text.astro"
// import DeviceGridItem from "@components/DeviceGridItem.astro"
// import { Image } from 'astro:assets'
import CCSlider from "@components/CCSlider.tsx"
import CommercialForm from "@components/CommercialForm"

const perksStyle = 'flex flex-col lg:flex-row justify-center items-center md:gap-3 gap-5'
const perksTextStyle = 'uppercase font-avenir text-center min-[870px]:text-nowrap lg:text-wrap 2xl:text-xl'
const inputStyle = 'bg-transparent border-2 p-2.5 border-t-off-white rounded-md sm:p-1.5 focus:outline-none focus:ring-indigo-500 focus:border-t-green'
const labelStyle = 'lg:text-lg xl:text-xl'

---

<Layout title="Clubs and Coaches | Tennibot">
    <main class="bg-t-off-black overflow-hidden text-t-off-white">
        <section class="bg-cover bg-top h-screen bg-[url('/images/commercial/heromobile_t.webp')] min-[450px]:bg-[url('/images/commercial/heromobile_t.webp')] min-[800px]:bg-[url('/images/commercial/herodesktop.webp')] xl:bg-[url('/images/commercial/herodesktopxl.webp')] " >
            <div class="flex flex-col items-center tablet:items-start h-full justify-start lg:items-start " >
                <div class="z-[1] w-[80%] flex flex-col lg: tablet:mt-[5%] mt-10 lg:w-[100%] tablet:w-[80%] tablet:ml-[10%]" >
                    <Text tag="h1" className="font-avenir text-t-off-white uppercase text-2xl mobilem:text-3xl md:text-5xl sm:text-4xl xl:text-5xl 2xl:text-6xl tablet:px-0" >
                        Take your club<br class="xl:hidden" /> <strong class="font-avenirBold" >to the next level</strong>
                    </Text>
                    <Text tag="p" className="py-5 font-plutoLight sm:text-lg xl:text-xl 2xl:text-2xl tablet:w-[80%]">
                        None of your members like to pick up balls! It's time to stand out,<br class="hidden lg:block" />  by offering a solution for the worst part of tennis.
                    </Text>
                    <div class="flex" >
                        <Button href="/buy" theme="light" className="tablet:w-64 w-full" >Buy now</Button>
                    </div>
                </div>
                <div class="absolute w-full h-[90%] bg-gradient-to-b from-t-shade from-10%  to-90% opacity-70" />
            </div>
        </section>

        <section>
            <div class="grid grid-cols-1 min-[870px]:grid-cols-4 tablet:grid-cols-2 tablet:w-[80%] lg:w-[90%] lg:center tablet:mx-auto min-[870px]:gap-10 gap-10 py-14 " >
                <div class={perksStyle} >
                    <svg xmlns="http://www.w3.org/2000/svg" width="42" height="45" viewBox="0 0 42 45" fill="none">
                        <path d="M41.7295 40.4164C40.293 32.9326 35.0753 26.6574 28.043 23.7844C23.7328 26.3542 18.2884 26.3542 13.9027 23.7844C6.79445 26.6574 1.65272 32.9326 0.215844 40.4164C-0.0110281 41.6265 -0.767226 44.4985 3.01383 44.4985H39.0073C42.7883 44.5743 42.0321 41.7023 41.7295 40.4164ZM20.935 22.5753C27.0598 22.5753 31.9749 17.5855 31.9749 11.5377C31.9749 5.41454 26.9842 0.5 20.935 0.5C14.8099 0.5 9.89483 5.41454 9.89483 11.5377C9.89483 17.6613 14.8099 22.5753 20.935 22.5753Z" fill="#F6F7F2"/>
                    </svg>
                    <Text tag="p" className={perksTextStyle} >
                        Unlimited user profiles
                    </Text>
                </div>

                <div class={perksStyle} >
                    <svg xmlns="http://www.w3.org/2000/svg" width="38" height="45" viewBox="0 0 38 45" fill="none">
                        <path d="M12.9693 19.8861C12.8371 19.7557 12.8371 19.5601 12.9693 19.4297L13.4101 18.995C13.5424 18.8646 13.7407 18.8646 13.873 18.995L17.9064 22.9723C18.0386 23.1027 18.237 23.1027 18.3692 22.9723L26.5242 14.9308C26.6565 14.8004 26.8549 14.8004 26.9871 14.9308L27.4279 15.3655C27.5602 15.4959 27.5602 15.6915 27.4279 15.8219L18.4574 24.6675C18.2811 24.8414 17.9945 24.8414 17.8182 24.6675L12.9693 19.8861Z" fill="#F6F7F2"/>
