---
import Layout from "layouts/Layout.astro"
import customization from '@assets/partner/customization-icon.svg'
import shipping from '@assets/partner/shipping-icon.svg'
import moneyBack from '@assets/partner/return-icon.svg'
import warranty from '@assets/partner/warranty-icon.svg'
import { Package } from "lucide-react"
import ReservePageVideo from "@components/ReservePageVideo"
import shippingIcon from '../assets/partner/shipping-icon.svg'
import warrantyIcon from '../assets/partner/warranty-icon.svg'
import cancelIcon from '../assets/partner/cancel-icon.svg'
import sportsIcon from '../assets/partner/sports-icon.svg'
---
<Layout title="Reserve | Tennibot" showFooter={false} showHeader={false} >
    <!-- Trackdesk set client_reference_id help fuction begin -->
  <script>
    (function () {
        var cookie = document.cookie.match('(^|;)\\s*trakdesk_cid\\s*=\\s*([^;]+)');
        if (Array.isArray(cookie)) {
            try {
                var trakdeskCid = JSON.parse(cookie.pop());
                var cid = trakdeskCid['cid'];
                document.querySelectorAll('a[href^="https://buy.stripe.com/"]').forEach(function (a) {
                    var url = new URL(a.href);
                    url.searchParams.set('client_reference_id', cid);
                    a.href = url.href;
                });
            } catch (e) {
                console.log(e);
            }
        }
    })();
    </script>
    <!-- Trackdesk set client_reference_id help fuction end -->
     <!-- Trackdesk tracker optional types help script begin -->
    <script async src="//cdn.trackdesk.com/tracking.js"></script>
    <script>
      (function(t,d,k){(t[k]=t[k]||[]).push(d);t[d]=t[d]||t[k].f||function(){(t[d].q=t[d].q||[]).push(arguments)}})(window,"trackdesk","TrackdeskObject");

      trackdesk('tennibot', 'conversion', {
        conversionType: 'sale'
      });
    </script>
    <!-- Trackdesk tracker optional types help script end -->
    <main class="w-full bg-t-off-black relative text-t-off-white" >
      <section class="relative flex md:flex-row flex-col-reverse" >
        <!-- <div class="relative bg-[url('/images/partner/partner-hero.webp')] bg-cover md:bg-center bg-[position:5%_75%] w-[100%] h-[99.9vh]" >
          <div class="absolute inset-0 bg-gradient-to-l from-black/70 from-0% hidden md:block to-transparent to-90%"></div>
        </div> -->

        <ReservePageVideo client:load />

        <div class="lg:w-[35%] md:w-[45%] flex flex-col justify-center md:absolute top-0 bottom-0 bg-t-off-black right-0 md:h-[99.9vh] h-full overflow-y-scroll custom-scrollbar">
          <div class="w-[90%] md:w-[80%] mx-auto" >
            <div class="flex bg-t-off-black pt-16 flex-row gap-x-5 justify-between text-t-off-white" >
                <div>
                    <!-- <h1 class="font-avenirBold text-t-green text-2xl" >Tennibot</h1> -->
                    <h1 class="font-avenirBold text-t-off-white text-4xl" >Partner</h1>
                </div>
                <div class="flex flex-row gap-x-2">
                  <p class="font-avenirBold text-t-off-white text-xl" >$1,995</p>
                  <p class="font-avenir text-t-disabled text-xl line-through" >$3,000</p>
                </div>
            </div>
            <div class="flex flex-row justify-end" >
              <div class="flex flex-row items-center" >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="mr-1" viewBox="0 0 66 66" fill="none">
                  <path d="M26.2811 23.0352C28.0761 23.0352 29.5311 24.4902 29.5311 26.2852C29.5311 28.0802 28.0761 29.5352 26.2811 29.5352C24.4863 29.5352 23.0312 28.0802 23.0312 26.2852C23.0312 24.4902 24.4863 23.0352 26.2811 23.0352Z" fill="#BBDC00"/>
                  <path d="M36.0312 39.2852C36.0312 41.0801 37.4866 42.5352 39.2812 42.5352C41.0762 42.5352 42.5312 41.0801 42.5312 39.2852C42.5312 37.4902 41.0762 36.0352 39.2812 36.0352C37.4866 36.0352 36.0312 37.4902 36.0312 39.2852Z" fill="#BBDC00"/>
                  <path d="M28.5792 41.5833L41.5792 28.5833C42.8486 27.3142 42.8486 25.2563 41.5792 23.987C40.3101 22.7179 38.2525 22.7179 36.983 23.987L23.9831 36.9871C22.714 38.2563 22.714 40.3142 23.9831 41.5833C25.2524 42.8524 27.3101 42.8524 28.5792 41.5833Z" fill="#BBDC00"/>
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M46.7955 7.01488L43.0876 7.90402L41.0943 4.65343C37.2899 -1.55114 28.275 -1.55114 24.4707 4.65343L22.4776 7.90402L18.7696 7.01488C11.6922 5.31773 5.31773 11.6922 7.01488 18.7696L7.90402 22.4776L4.65343 24.4707C-1.55114 28.2752 -1.55114 37.2901 4.65343 41.0945L7.90402 43.0878L7.01488 46.7957C5.31773 53.8729 11.6922 60.2474 18.7696 58.5503L22.4776 57.6611L24.4707 60.9117C28.275 67.1163 37.2899 67.1163 41.0943 60.9117L43.0876 57.6611L46.7955 58.5503C53.873 60.2474 60.2476 53.8729 58.5504 46.7957L57.6612 43.0878L60.9119 41.0945C67.1164 37.2901 67.1164 28.2752 60.9119 24.4707L57.6612 22.4776L58.5504 18.7696C60.2476 11.6922 53.873 5.31773 46.7955 7.01488ZM30.0118 8.05114C31.28 5.98294 34.2849 5.98294 35.5531 8.05114L38.78 13.3136C39.5155 14.5133 40.94 15.1033 42.3085 14.7751L48.3113 13.3357C50.6705 12.77 52.7953 14.8948 52.2295 17.2539L50.7901 23.2567C50.4618 24.6253 51.0517 26.0495 52.2516 26.7851L57.514 30.012C59.5823 31.2802 59.5823 34.2851 57.514 35.5533L52.2516 38.7799C51.0517 39.5157 50.4618 40.9398 50.7901 42.3084L52.2295 48.3112C52.7953 50.6703 50.6705 52.7952 48.3113 52.2294L42.3085 50.7899C40.94 50.462 39.5155 51.0519 38.78 52.2515L35.5531 57.5142C34.2849 59.5822 31.28 59.5822 30.0118 57.5142L26.7852 52.2515C26.0495 51.0519 24.6253 50.462 23.2567 50.7899L17.2539 52.2294C14.8948 52.7952 12.77 50.6703 13.3357 48.3112L14.7751 42.3084C15.1033 40.9398 14.5133 39.5157 13.3136 38.7799L8.05114 35.5533C5.98294 34.2851 5.98294 31.2802 8.05114 30.012L13.3136 26.7851C14.5133 26.0495 15.1033 24.6253 14.7751 23.2567L13.3357 17.2539C12.77 14.8948 14.8948 12.77 17.2539 13.3357L23.2567 14.7751C24.6253 15.1033 26.0495 14.5133 26.7852 13.3136L30.0118 8.05114Z" fill="#BBDC00"/>
                </svg>
                <p class="font-avenir text-t-green text-sm" >Save $1,005</p>
              </div>
            </div>
            <div class="bg-t-off-black" >
              <p class="font-avenir text-[#A6A6A6] text-sm pt-5 pb-3 text-pretty" >Reserve for only $499 today to secure your partner. Pay the remaining $1495 before shipping in April 2025.</p>
            </div>
            <hr class="border-t-green border-t-1 w-full mx-auto mt-5" />
            <div class="flex flex-row items-center justify-around gap-x-5 my-7" >
              <div>
                <div class="flex flex-row items-center mb-2" >
                  <img src={shippingIcon.src} width={20} class="mr-1" alt="Shipping Icon" />
                  <p class="font-avenir text-t-green text-sm" >Worldwide Shipping</p>
                  <button 
                  class="relative ml-2"
                  aria-label="Shipping information"
                  onclick="this.querySelector('.tooltip').classList.toggle('hidden')"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 30 30" fill="none">
                      <path d="M15 0C6.71625 0 0 6.71625 0 15C0 23.2838 6.71625 30 15 30C23.2838 30 30 23.2838 30 15C30 6.71625 23.2838 0 15 0ZM16.25 22.5H13.75V13.75H16.25V22.5ZM15 10.625C13.965 10.625 13.125 9.785 13.125 8.75C13.125 7.715 13.965 6.875 15 6.875C16.035 6.875 16.875 7.715 16.875 8.75C16.875 9.785 16.035 10.625 15 10.625Z" fill="#8E9088"/>
                    </svg>
                    <div class="tooltip absolute bottom-full left-0 -translate-x-[calc(100%-26px)] mb-2 hidden w-56 p-5 text-xs text-t-off-white bg-t-off-black rounded-lg shadow-lg border border-t-green">
                      <p class="font-avenir text-t-gray text-xs">The Partner comes in two models: one compatible with both tennis and padel, and another made just for pickleball lovers</p>
                    </div>
                  </button>
                </div>
                <div class="flex flex-row items-center md:mb-0 mb-2" >
                  <img src={warrantyIcon.src} width={20} class="mr-1" alt="Warranty Icon" />
                  <p class="font-avenir text-t-green text-sm" >3 Year Warranty</p>
                </div>
              </div>
              <div>
                <div class="flex flex-row flex-wrap items-center mb-2" >
                  <img src={sportsIcon.src} width={20} class="mr-1" alt="Warranty Icon" />
                  <p class="font-avenir text-t-green text-sm" >Tennis, Padel & Pickleball</p>
                  <button 
                  class="relative ml-2"
                  aria-label="Shipping information"
                  onclick="this.querySelector('.tooltip').classList.toggle('hidden')"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 30 30" fill="none">
                      <path d="M15 0C6.71625 0 0 6.71625 0 15C0 23.2838 6.71625 30 15 30C23.2838 30 30 23.2838 30 15C30 6.71625 23.2838 0 15 0ZM16.25 22.5H13.75V13.75H16.25V22.5ZM15 10.625C13.965 10.625 13.125 9.785 13.125 8.75C13.125 7.715 13.965 6.875 15 6.875C16.035 6.875 16.875 7.715 16.875 8.75C16.875 9.785 16.035 10.625 15 10.625Z" fill="#8E9088"/>
                    </svg>
                    <div class="tooltip absolute bottom-full left-0 -translate-x-[calc(100%-26px)] mb-2 hidden w-56 p-5 text-xs text-t-off-white bg-t-off-black rounded-lg shadow-lg border border-t-green">
                      <p class="font-avenir text-t-gray text-xs">The Partner comes in two models: one compatible with both tennis and padel, and another made just for pickleball lovers.</p>
                    </div>
                  </button>
                </div>
                <div class="flex flex-row items-center md:mb-0 mb-2" >
                  <img src={cancelIcon.src} width={20} class="mr-1" alt="Warranty Icon" />
                  <p class="font-avenir text-t-green text-sm" >Cancel Anytime</p>
                </div>
              </div>
            </div>
            <hr class="border-t-green border-t-1 w-full mx-auto" />
            <!-- <div class="bg-white p-5 mt-2" >
              <p class="font-avenir text-[#A6A6A6] text-xl">Deposit</p>
              <p class="font-avenir text-t-off-black text-2xl mt-2">$499</p>
            </div> -->
          </div>
          <div class="bg-t-off-black p-10 flex-col items-center mt-10 flex justify-center md:pb-20" >
            <a href="https://buy.stripe.com/6oEdTp8pygzo5AA9AC" class={`w-72 text-xl 2xl:text-2xl 2xl:py-3 rounded-full py-2 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green hover:bg-t-green hover:text-t-off-black`}>Reserve</a>
            <div class="flex items-center gap-x-2 mt-3" >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 45 45" fill="none">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M43.125 22.5001C43.125 33.8909 33.8908 43.1251 22.5 43.1251C11.1091 43.1251 1.875 33.8909 1.875 22.5001C1.875 11.1091 11.1091 1.875 22.5 1.875C33.8908 1.875 43.125 11.1091 43.125 22.5001ZM5.63781 22.5001C5.63781 27.352 7.68719 31.7255 10.9676 34.802C11.3944 34.187 11.9003 33.3905 12.4072 32.4374C13.7181 29.9725 15.0002 26.5272 15.0002 22.5005C15.0002 18.4737 13.7181 15.0284 12.4072 12.5635C11.9002 11.6101 11.3941 10.8134 10.9672 10.1984C7.68702 13.2748 5.63781 17.6481 5.63781 22.5001ZM22.5 39.3621C19.3884 39.3621 16.4738 38.5193 13.9718 37.0497C14.4882 36.314 15.1037 35.3536 15.7181 34.1982C17.2198 31.3746 18.7502 27.32 18.7502 22.5005C18.7502 17.681 17.2198 13.6263 15.7181 10.8027C15.1035 9.64698 14.4878 8.6864 13.9713 7.95055C16.4734 6.48068 19.3882 5.63781 22.5 5.63781C25.6117 5.63781 28.5268 6.48074 31.029 7.9507C30.5124 8.68653 29.8969 9.64705 29.2822 10.8027C27.7805 13.6263 26.2502 17.681 26.2502 22.5005C26.2502 27.32 27.7805 31.3746 29.2822 34.1982C29.8967 35.3536 30.5121 36.3138 31.0284 37.0495C28.5264 38.5193 25.6115 39.3621 22.5 39.3621ZM34.0327 34.8018C37.3129 31.7253 39.3622 27.352 39.3622 22.5001C39.3622 17.6482 37.313 13.275 34.0331 10.1986C33.6062 10.8136 33.1001 11.6103 32.5931 12.5635C31.2823 15.0284 30.0002 18.4737 30.0002 22.5005C30.0002 26.5272 31.2823 29.9725 32.5931 32.4374C33.0999 33.3905 33.6058 34.187 34.0327 34.8018Z" fill="#BBDC00"/>
              </svg>
              <p class="font-avenir text-t-off-white text-sm" >Claim your 33% off until Jan. 1st</p>
            </div>
          </div>
        </div>
      </section>
    </main>
</Layout>