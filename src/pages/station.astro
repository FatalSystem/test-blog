---
import Button from "@components/Core/Button.astro"
import Layout from "../layouts/Layout.astro"
import Text from "@components/Core/Text.astro"
import DeviceGridItem from "@components/DeviceGridItem.astro"
import { Image } from 'astro:assets'

import stationLevelMobile from '@assets/station/stationlevelmobile.webp'
import stationLevelDesktop from '@assets/station/stationlevel.webp'
import stationApp from '@assets/station/stationapp.webp'
import downloadIOS from '@assets/rover/downloadios.svg'
import downloadAndroid from '@assets/rover/downloadandroid.svg'
import VideoPlayer from "@components/VideoPlayer"
import RadialGradient from "@components/RadialGradient"
import stationAppDesktop from '@assets/station/stationappdesktop.webp'
import { Pages } from "@utils"

---
<Layout title="Welcome to Tennibot.">
    <main class="bg-t-off-black overflow-hidden text-t-off-white">
        <section class="bg-cover bg-center h-[90vh] bg-[url('../src/assets/station/stationheromobile.webp')] min-[450px]:bg-[url('../src/assets/station/stationherotablets.webp')] min-[800px]:bg-[url('../src/assets/station/stationherotablet.webp')] xl:bg-[url('../src/assets/station/stationhero.webp')] " >
            <div class="flex flex-col items-center h-full justify-center lg:justify-start lg:items-start" >
                <Text tag="h1" className="z-[1] text-t-off-white uppercase font-black text-2xl mobilem:text-3xl px-3 tablet:px-0 tablet:w-[75%] text-center lg:text-left lg:w-[40%] lg:ml-[10%] mt-[10%]" >The <span class="text-t-green" >station</span>:</br> a coach that fits in your tennis bag</Text>
                <div class="z-[1] mx-auto min-[520px]:flex-row justify-center  gap-5 flex flex-col items-center mt-5 lg:ml-[10%]" >
                    <Button onClick="/" theme="light" className="tablet:w-64 w-full px-16" >Play video</Button>
                    <Button href={Pages.BUY} theme="green" className="tablet:w-64 w-full px-16" >Buy now</Button>
                </div>
                <div class="absolute w-full h-[90%] bg-gradient-to-b from-t-shade from-10% via-transparent via-70% to-t-shade to-90% opacity-70" />
            </div>
        </section>

        <!-- TODO: Improve this -->
        <section class="pb-28 min-[640px]:pb-10 bg-t-gray relative">
            <picture>
                <source srcset={stationLevelDesktop.src} media="(min-width: 640px)" />
                <Image src={stationLevelMobile} class="w-full" alt="Station close up" />
            </picture>
            <div class="w-[80%] mx-auto min-[640px]:absolute min-[640px]:top-[20%] min-[640px]:left-[5%] min-[640px]:w-[50%] " >
                <Text tag="h2" className="text-t-off-black uppercase mb-5 text-3xl" >Take your game<br> <strong class="font-black" >to the next level</strong></Text>
                <Text tag="p" className="text-t-off-black" >The Station does more than just help the Rover navigate the court. With two 4K cameras and a state of the art processor, the Station can record video, track players, and call shots in real time. </Text>
            </div>
        </section>

        <section class="bg-t-off-black lg:h-[70vh] min-[670px]:h-fit min-[670px]:pt-16 " >
            <div class="min-[670px]:w-[80%] w-full lg:h-[60vh] h-fit grid lg:grid-cols-4 min-[670px]:grid-cols-2 min-[670px]:mx-auto min-[670px]:gap-3">
                <DeviceGridItem containerClass="lg:bg-[url('../src/assets/rover/rovercloseup.webp')] min-[670px]:bg-[url('../src/assets/rover/rovercloseuptablet.webp')] bg-[url('../src/assets/station/placedstation.webp')] " >
                    <Text tag="h6" className="z-[1] text-t-off-white uppercase text-2xl min-[670px]:text-xl text-center font-bold min-[670px]:font-thin min-[670px]:text-left mb-3" >Match recording</Text>
                    <Text tag="p" className="z-[1] text-t-off-white min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The Tennibot bucket holds up to 80 tennis balls, in an easy-to remove net bag.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('../src/assets/rover/roverballs.webp')] min-[670px]:bg-[url('../src/assets/rover/roverballstablet.webp')] bg-[url('../src/assets/station/stationlinejudge.webp')]" >
                    <Text tag="h6" className="z-[1] text-t-off-white uppercase text-2xl min-[670px]:text-xl text-center font-bold min-[670px]:font-thin min-[670px]:text-left mb-3 mobilem:w-[70%] tablet:w-[60%] min-[670px]:w-full " >Line judging</Text>
                    <Text tag="p" className="z-[1] text-t-off-white min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The Tennibot can easily handle multiple lessons before needing to recharge.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('../src/assets/rover/roverterrain.webp')] min-[670px]:bg-[url('../src/assets/rover/roverterraintablet.webp')] bg-[url('../src/assets/station/placingstation.webp')]" >
                    <Text tag="h6" className="z-[1] text-t-off-white uppercase text-2xl min-[670px]:text-xl text-center font-bold min-[670px]:font-thin min-[670px]:text-left mb-3 mobilem:w-[70%] tablet:w-[60%] min-[670px]:w-full" >No installation</Text>
                    <Text tag="p" className="z-[1] min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >Whether you prefer the speed of hard courts or sliding on clay, Tennibot has got you covered.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('../src/assets/rover/roversize.webp')] min-[670px]:bg-[url('../src/assets/rover/roversizetablet.webp')] bg-[url('../src/assets/station/stationcontrol.webp')] " >
                    <Text tag="h6" className="z-[1] text-t-off-white uppercase text-2xl min-[670px]:text-xl text-center font-bold min-[670px]:font-thin min-[670px]:text-left mb-3" >Useful stats</Text>
                    <Text tag="p" className="z-[1] text-t-off-white min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The Tennibot fits in most car trunks and at only 25lbs, it it easy to roll on and off the court.</Text>
                </DeviceGridItem>
            </div>
        </section>

        <section class="bg-t-off-black flex justify-center min-[550px]:h-[50vh] min-[550px]:mt-16 min-[550px]:items-center min-[550px]:pt-0 pt-20 text-t-off-white xl:mt-[10%]" >
            <div class="w-[80%] mx-auto flex min-[550px]:flex-row flex-col items-center justify-center" >
                <div class="min-[550px]:w-[50%] min-[550px]:mb-0 mb-14" >
                    <Text tag="h2" className="font-bold text-pretty text-3xl lg:text-4xl min-[550px]:text-left uppercase"  >Play smarter</Text>
                    <Text tag="p" className="text-lg text-pretty min-[550px]:text-left my-7 tracking-tight" >Using the Tennibot app, you can record your highlights and keep a record of all of your matches and practices. The Station gives you actionable feedback so you can...</Text>
                    <div class="flex flex-row gap-5 lg:pr-10 min-[550px]:pl-0 px-8" >
                        <a href="https://apps.apple.com/us/app/tennibot/id1438424530" target="_blank" class="cursor-pointer"  ><Image src={downloadIOS}  alt="Download Tennibot on iOS" /></a>
                        <a href="https://play.google.com/store/apps/details?id=com.tennibot&hl=en&gl=US" target="_blank" class="cursor-pointer" ><Image src={downloadAndroid}   alt="Download Tennibot on iOS" /></a>
                    </div>
                </div>
                <div class="min-[550px]:w-[50%] lg:ml-20 min-[550px]:ml-10" >
                    <picture>
                        <source srcset={stationAppDesktop.src} sizes={`w-[${stationAppDesktop.width}]`} media="(max-width: 425px)" />
                        <Image src={stationApp} alt="Line judging image" />
                    </picture>
                </div>
            </div>
        </section>


        <section class="bg-t-off-black flex justify-center pt-20 text-t-off-white" >
            <div class="w-[80%] lg:pb-24 lg:pt-16 pb-12" >
                <div class="flex flex-row justify-between" >
                    <Text tag="h2" className="text-3xl lg:text-4xl uppercase font-black" >See it in action</Text>
                    <a class="transition ease-in-out delay-150 hidden md:flex flex-row items-center font-avenir text-t-off-white underline uppercase text-lg cursor-pointer hover:text-t-green stroke-t-off-white hover:stroke-t-green duration-200" >
                        View video gallery
                        <svg xmlns="http://www.w3.org/2000/svg" width="42" height="19" viewBox="0 0 52 29" fill="none" class="ml-3" >
                            <path d="M1 14.5H51M51 14.5L36.3659 28M51 14.5L36.3659 1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                </div>

                <div class="h-fit relative overflow-hidden rounded-xl mt-10" >
                    <VideoPlayer client:only="react" />
                    <RadialGradient from="#1C1C1F" to="#141416" />
                </div>
                <div class="flex flex-row justify-center md:hidden mt-10" >
                    <Button onClick="/" className="tablet:w-fit w-full" >View video gallery</Button>
                </div>
            </div>
        </section>

        <section class=" bg-t-off-black lg:pb-32 pt-11 pb-20 text-t-off-white" >
            <div class="w-[80%] flex lg:flex-row flex-col items-center mx-auto h-full" >
                <div>
                    <Text tag="h3" className="uppercase font-thin text-3xl lg:text-4xl mb-5" >Want to learn more?</Text>
                    <Text tag="p" className="" >If you have a question about the Tennibot or how it operates, visit our FAQ's page for more information.</Text>
                </div>
                <div class="lg:w-[50%] lg:mt-0 mt-10 w-full flex lg:justify-end justify-center" >
                    <Button onClick="/" className="tablet:w-fit w-full" >View FAQ's</Button>
                </div>
            </div>
        </section>

    </main>
</Layout>