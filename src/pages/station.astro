---
import Button from "@components/core/Button.astro"
import Layout from "../layouts/Layout.astro"
import Text from "@components/core/Text.astro"
import DeviceGridItem from "@components/DeviceGridItem.astro"
import { Image } from 'astro:assets'

import stationLevel from '@assets/station/stationlevel.webp'
import stationLevelTablet from '@assets/station/stationleveltablet.webp'
import stationLevelDesktop from '@assets/station/stationleveldesktop.webp'

import stationApp from '@assets/station/stationapp.webp'
import downloadIOS from '@assets/rover/downloadios.svg'
import downloadAndroid from '@assets/rover/downloadandroid.svg'
// import VideoPlayer from "@components/VideoPlayer"
// import RadialGradient from "@components/RadialGradient"
import stationAppDesktop from '@assets/station/stationappdesktop.webp'
import { Pages } from "@utils"

---
<Layout title="Welcome to Tennibot.">
    <main class="bg-t-off-black overflow-hidden text-t-off-white">
        <section class="bg-cover bg-center h-[90vh] bg-[url('/images/station/stationhero.webp')] min-[450px]:bg-[url('/images/station/stationherotablet.webp')] min-[800px]:bg-[url('/images/station/stationherodesktop.webp')] xl:bg-[url('/images/station/stationherodesktopxl.webp')] " >
            <div class="flex flex-col items-center h-full justify-start lg:justify-start lg:items-start" >
                <Text tag="h1" className="z-[1] font-avenir mt-[25%] sm:mt-[15%] lg:mt-[5%] lg:ml-[15%] 2xl:ml-[11%] text-t-off-white uppercase text-2xl mobilem:text-3xl sm:text-4xl 2xl:text-5xl px-3 tablet:px-0 tablet:w-[75%] text-center lg:text-left lg:w-[40%]" ><span class="font-avenirBold" >The <span class="text-t-green" >station</span>:<br /></span> a coach that fits<br class="hidden sm:block" /> in<br class="sm:hidden" /> your tennis bag</Text>
                <div class="z-[1] mx-auto min-[520px]:flex-row justify-center gap-5 flex flex-col lg:items-start items-center lg:w-fit  w-[80%] max-tablet:w-[80%] mt-5 lg:ml-[15%] 2xl:ml-[11%]" >
                    <Button href={Pages.BUY} theme="green" className="tablet:w-64 w-full " >Buy now</Button>
                </div>
            </div>
        </section>

        <!-- TODO: Improve this -->
        <section class="bg-t-off-black py-36 md:py-40 lg:py-56 2xl:py-64">
            <div class="w-[80%] 2xl:w-[65%] mx-auto flex flex-col-reverse md:flex-row gap-10" >
                <div class="md:w-[50%] flex flex-col justify-center " >
                    <Text tag="h2" className="text-t-off-white font-avenir uppercase mb-5 text-2xl lg:text-3xl xl:text-4xl 2xl:text-5xl" >Take your game<br> <strong class="font-avenirBold" >to the next level</strong></Text>
                    <Text tag="p" className="text-t-off-white font-plutoLight xl:text-lg 2xl:text-xl" >The Station does more than just help the Rover navigate the court. With state of the art computing and cameras, the Station can record video, track players, and call shots in real time.</Text>
                </div>
                <picture class="m-auto max-w-[80%] xl:max-w-[40%] md:w-[50%] mb-5 sm:mb-0" >
                    <source srcset={stationLevelTablet.src} media="(max-width: 768px)" />
                    <source srcset={stationLevel.src} media="(max-width: 640px)" />
                    <Image src={stationLevelDesktop} alt="Station close up" class="mx-auto" />
                </picture>
            </div>
        </section>

        <section class="bg-t-off-black min-[670px]:h-fit" >
            <div class="min-[670px]:w-[80%] w-full  h-fit grid lg:grid-cols-4 min-[670px]:grid-cols-2 min-[670px]:mx-auto min-[670px]:gap-3">
                <DeviceGridItem containerClass="lg:bg-[url(/images/station/stationcloseupdesktop.webp')] min-[670px]:bg-[url('/images/station/stationcloseupmobile.webp')] bg-[url('/images/station/stationcloseupmobile.webp')] " >
                    <Text tag="h6" className="z-[1] text-t-off-white uppercase text-2xl min-[670px]:text-xl text-center font-avenirBold min-[670px]:font-avenir min-[670px]:text-left mb-3" >Match recording</Text>
                    <Text tag="p" className="z-[1] font-plutoLight text-t-off-white min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >Never miss another killer rally. The Station records matches and automatically filters downtime.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('/images/station/linejudgingdesktop.webp')] min-[670px]:bg-[url('/images/station/linejudgingmobile.webp')] bg-[url('/images/station/linejudgingmobile.webp')]" >
                    <Text tag="h6" className="z-[1] text-t-off-white uppercase text-2xl min-[670px]:text-xl text-center font-avenirBold min-[670px]:font-avenir min-[670px]:text-left mb-3 mobilem:w-[70%] tablet:w-[60%] min-[670px]:w-full " >Line judging</Text>
                    <Text tag="p" className="z-[1] font-plutoLight text-t-off-white min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >Tired of arguing over line calls? The Station makes calls for you in real-time.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('/images/station/placingstationdesktop.webp')] min-[670px]:bg-[url('/images/station/placingstationmobile.webp')] bg-[url('/images/station/placingstationmobile.webp')]" >
                    <Text tag="h6" className="z-[1] text-t-off-white uppercase text-2xl min-[670px]:text-xl text-center font-avenirBold min-[670px]:font-avenir min-[670px]:text-left mb-3 mobilem:w-[70%] tablet:w-[60%] min-[670px]:w-full" >No installation</Text>
                    <Text tag="p" className="z-[1] font-plutoLight min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The removable holder attaches to the net post in seconds, no screws required.</Text>
                </DeviceGridItem>
                <DeviceGridItem containerClass="lg:bg-[url('/images/station/stationappdesktop.webp')] min-[670px]:bg-[url('/images/station/stationappmobile.webp')] bg-[url('/images/station/stationappmobile.webp')] " >
                    <Text tag="h6" className="z-[1] text-t-off-white uppercase text-2xl min-[670px]:text-xl text-center font-avenirBold min-[670px]:font-avenir min-[670px]:text-left mb-3" >Actionable data</Text>
                    <Text tag="p" className="z-[1] font-plutoLight text-t-off-white min-[670px]:w-full w-[80%] text-center min-[670px]:text-left text-pretty overflow-hidden h-fit lg:h-0 lg:opacity-0 pb-5 tablet:pb-10 min-[670px]:pb-3 lg:group-hover:opacity-100 xl:group-hover:h-[18%] lg:group-hover:h-[30%] transition-all duration-500" >The Station tracks key data points to provide detailed analysis on how to best improve your game.</Text>
                </DeviceGridItem>
            </div>
        </section>

        <section class="bg-t-off-black flex justify-center text-t-off-white py-36 md:py-40 lg:py-56 2xl:py-64" >
            <div class="w-[80%] 2xl:w-[65%] mx-auto flex min-[600px]:flex-row flex-col items-center justify-center" >
                <div class="min-[600px]:w-[50%] min-[600px]:mb-0 mb-14" >
                    <Text tag="h2" className="font-avenir text-pretty text-2xl lg:text-4xl 2xl:text-5xl min-[550px]:text-left uppercase"  >Smarter practice,</Text>
                    <Text tag="h2" className="font-avenirBold text-pretty text-2xl lg:text-4xl 2xl:text-5xl min-[550px]:text-left uppercase"  >superior play</Text>

                    <Text tag="p" className="text-pretty font-plutoLight min-[550px]:text-left my-7 xl:text-lg 2xl:text-xl tracking-tight" >Using the Tennibot app, you can record your highlights and keep a record of all of your matches and practices. The Station gives you actionable feedback so you can see which areas of your game need improvement.</Text>
                    <div class="flex flex-row gap-5 lg:pr-10 min-[550px]:pl-0 pr-8" >
                        <a href="https://apps.apple.com/us/app/tennibot/id1438424530" target="_blank" class="cursor-pointer"  ><Image src={downloadIOS}  alt="Download Tennibot on iOS" /></a>
                        <a href="https://play.google.com/store/apps/details?id=com.tennibot&hl=en&gl=US" target="_blank" class="cursor-pointer" ><Image src={downloadAndroid}   alt="Download Tennibot on iOS" /></a>
                    </div>
                </div>
                <div class="min-[600px]:w-[50%] lg:ml-20 min-[600px]:ml-10" >
                    <picture>
                        <source srcset={stationApp.src} sizes={`w-[${stationAppDesktop.width}]`} media="(max-width: 425px)" />
                        <Image src={stationAppDesktop} alt="Line judging image" class="mx-auto" />
                    </picture>
                </div>
            </div>
        </section>


        <!-- <section class="bg-t-off-black flex justify-center pt-20 text-t-off-white" >
            <div class="w-[80%] lg:pb-24 lg:pt-16 pb-12" >
                <div class="flex flex-row justify-between" >
                    <Text tag="h2" className="text-3xl lg:text-4xl uppercase font-black" >See it in action</Text>
                    <a class="transition ease-in-out delay-150 hidden md:flex flex-row items-center font-avenir text-t-off-white underline uppercase text-lg cursor-pointer hover:text-t-green stroke-t-off-white hover:stroke-t-green duration-200" >
                        View video gallery
                        <svg xmlns="http://www.w3.org/2000/svg" width="42" height="19" viewBox="0 0 52 29" fill="none" class="ml-3" >
                            <path d="M1 14.5H51M51 14.5L36.3659 28M51 14.5L36.3659 1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                </div>

                <div class="h-fit relative overflow-hidden rounded-xl mt-10" >
                    <VideoPlayer client:only="react" />
                    <RadialGradient from="#1C1C1F" to="#141416" />
                </div>
                <div class="flex flex-row justify-center md:hidden mt-10" >
                    <Button onClick="/" className="w-64" >View video gallery</Button>
                </div>
            </div>
        </section> -->

        <section class=" bg-t-off-black lg:pb-32 pt-11 pb-20 text-t-off-white" >
            <div class="w-[80%] 2xl:w-[65%] flex md:flex-row flex-col items-end mx-auto h-full" >
                <div>
                    <Text tag="h3" className="uppercase font-avenir text-2xl lg:text-4xl 2xl:text-5xl mb-5" >Want to learn more?</Text>
                    <Text tag="p" className="font-plutoLight lg:text-lg 2xl:" >If you have a question about the Tennibot or how it operates, visit our FAQ's page for more information.</Text>
                </div>
                <div class="lg:w-[50%] lg:mt-0 mt-10 w-full flex lg:justify-end justify-center" >
                    <Button href={Pages.FAQ} >View FAQ's</Button>
                </div>
            </div>
        </section>

    </main>
</Layout>