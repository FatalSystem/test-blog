---
import Layout from "../layouts/Layout.astro"
import Text from "@components/core/Text.astro"
import { sanityClient } from "sanity:client"
import TabContainer from "@components/TabContainer.tsx"
import FaqForm from "@components/FaqForm"
 
const questions = await sanityClient.fetch(`*[_type == "questions"] | order(_createdAt asc)`)
const problems = await sanityClient.fetch(`*[_type == "problems"] | order(_createdAt asc)`)

const inputStyle = 'bg-transparent border-2 border-t-off-black rounded-md sm:p-1.5 p-2.5 focus:outline-none focus:ring-indigo-500 focus:border-t-green'
---

<Layout title="FAQ | Tennibot">
    <main class="bg-off-black overflow-hidden text-t-green" >
        <section class="w-[90%] md:w-[80%] 2xl:max-w-[1266px] mx-auto pt-20" >
            <Text tag="h1" className="uppercase font-avenirBold lg:text-4xl 2xl:text-6xl text-3xl text-pretty" >Have a question?</Text>
            <Text tag="h3" className="uppercase font-avenirBold text-white lg:font-avenir lg:text-4xl text-3xl 2xl:text-6xl" >You're in the right place</Text>
        </section>
        <section class="md:w-[80%] 2xl:max-w-[1266px] w-full relative mx-auto my-10 group pb-20 " >
            <TabContainer client:load questions={questions} problems={problems} />
        </section>
        <section class="md:py-20 mb-20">
            <div class="w-[80%] 2xl:max-w-[1266px] mx-auto">
                <Text tag="h3" className="uppercase font-avenirBold lg:text-3xl 2xl:text-4xl text-2xl text-pretty" >Still have a question?</Text>
                <Text tag="p" className="text-pretty font-avenirBold text-white 2xl:text-lg mt-3">We have an answer. Fill out the form below and we'll get back to you as soon as possible.</Text>

                <form name="faq" method="post" data-netlify="true" class="font-avenir 2xl:text-lg mt-10 grid-cols-1 md:grid-cols-2 gap-5 hidden">
                    <div class="flex flex-col w-full gap-1">
                        <label for="question" >Question</label>
                        <textarea id="question" name="question" rows="6" required class={`${inputStyle} h-full`} />
                    </div>

                    <div class="flex flex-col sm:gap-5 gap-10" >
                        <div class="flex flex-col w-full gap-1">
                            <label for="name" >Name</label>
                            <input id="name" name="name" type="text" required class={inputStyle} />
                        </div>

                        <div class="flex flex-col w-full gap-1">
                            <label for="email" >Email Address</label>
                            <input id="email" name="email" type="email" required class={inputStyle} />
                        </div>

                        <div class="flex md:flex-col flex-col-reverse gap-1 w-full">
                            <input type="submit" value="Submit" class="cursor-pointer mt-5 focus:outline-none focus:ring-indigo-500 focus:border-t-green text-lg w-full tablet:w-64 font-thin rounded-full py-2 font-avenir uppercase border-2 transition duration-300 text-t-off-white md:text-t-off-black bg-t-off-black border-t-off-black md:text-t-off-off md:bg-t-off-white hover:bg-t-off-black hover:text-t-off-white" />
                            <div class="flex items-center gap-3 mt-3" >
                                <input id="newsletter" name="newsletter" type="checkbox" class="appearance-none border-2 border-t-off-black size-4 rounded-sm checked:bg-t-off-black focus:outline-none focus:ring-indigo-500 focus:border-t-green" />
                                <label for="newsletter" >I'd like to receive Tennibot email updates</label>
                            </div>
                        </div>

                    </div>

                </form>
                <FaqForm client:load />
            </div>
        </section>
    </main>
</Layout>