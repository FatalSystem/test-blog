---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Contact - Thank You | Tennibot">
  <main class="bg-t-off-black font-pluto">
    
    <!-- Main Content -->
    <section class="w-full md:w-[80%] 2xl:max-w-[1133px] mx-auto py-[27px]">
      <!-- Thank You Content -->
      <div class="flex gap-16 justify-between items-center h-[535px]">
        <!-- Left Side - Thank You Message -->
        <div class="h-full">
          <span class="text-t-off-white font-plutoLight text-base">Thank you!</span>
          <h1 class="uppercase font-dm font-extrabold text-4xl text-t-off-white mb-0.5">
            WE'LL BE RIGHT WITH YOU
          </h1>
          <p class="text-t-off-white font-plutoLight text-base max-w-[380px]">
            We'll be in touch shortly to help and answer your question!
          </p>
        </div>

        <!-- Right Side - Still Need Help -->
        <div>
          <h2 class="uppercase font-dm font-extrabold text-4xl text-t-off-white mb-2">
            STILL NEED HELP?
          </h2> 
          <p class="text-t-off-white font-avenirBold text-lg">Give us a ring at</p>
          <a 
            href="tel:251-277-8022" 
            class="text-t-green font-plutoLight text-xl lg:text-2xl transition-colors duration-200"
          >
            251-277-8022
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
