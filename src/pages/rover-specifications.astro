---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Contact | Tennibot">
  <main class="bg-t-off-black font-pluto">
    <section class="w-full md:w-[80%] 2xl:max-w-[1133px] mx-auto text-t-off-white">
        <div class="relative">
            <img src="/public/images/rover/hero.png">
            <img src="/public/images/rover/gradient-hero.png" class="absolute w-full h-full top-0 left-0">
        </div>

        <div class="py-10 flex flex-col gap-[68px]">
            <h2 class="text-6xl font-dm text-t-off-white uppercase font-bold">Rover Specifications</h2>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Rover Specs</h4>
                <div class="text-lg font-plutoLight text-t-off-white">| Dimensions | Approx. 40” x 21” x 14” (arms stowed)</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Weight |  Approx. 26 lbs</div>
            </div>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Performance</h4>
                <div class="text-lg font-plutoLight text-t-off-white">| Max Speed | 0.9 m/s</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Operating Temp | 15 °F to 110 °F</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Battery Duration | 3–5 hours (based on usage and external conditions)</div>
            </div>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Battery</h4>
                <div class="text-lg font-plutoLight text-t-off-white">| Nominal Voltage | 11.1 V</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Max Charging Voltage | 12.6 V</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Nominal Capacity | 14 Ah</div>
                <div class="text-lg font-plutoLight text-t-off-white">Charging (12V Adapter)</div>

                <div class="text-lg font-plutoLight text-t-off-white mt-10">| Max Charge Time | 90 minutes</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Output Voltage | 12.4 V to 12.8 V</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Output Current | 3.5 A to 4 A</div>
            </div>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Station Specs</h4>
                <div class="text-lg font-plutoLight text-t-off-white">| Dimensions | Approx. 6.5” (D) × 3” (H)</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Weight | Approx. 1 lb 6 oz</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Operating Temp | 15 °F to 100 °F</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Battery Duration | 3–5 hours (based on usage and external conditions)</div>
            </div>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Station Battery</h4>
                <div class="text-lg font-plutoLight text-t-off-white"| Nominal Voltage | 3.7></div>
                <div class="text-lg font-plutoLight text-t-off-white">| Max Charging Voltage | 4.2 V</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Nominal Capacity | 13.6 Ah</div>
                <div class="text-lg font-plutoLight text-t-off-white">Charging (5V USB)</div>

                <div class="text-lg font-plutoLight text-t-off-white mt-10">Feature Specification</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Max Charging Time | Approx. 100 minutes (may vary by adapter)</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Charging Current | 3.0 A max (may vary by adapter)</div>
            </div>
        </div>
    </section>


  </main>
</Layout>
