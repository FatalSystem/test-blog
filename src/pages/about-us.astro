---
import Layout from "../layouts/Layout.astro"
import AboutSlider from "@components/AboutSlider"
import Text from "@components/core/Text.astro"
import {Marquee, MarqueeItem } from "@components/Marquee"
import { Image } from 'astro:assets'
import Button from "@components/core/Button.astro"

import muse from "@assets/about-us/muse.svg"
import svr from "@assets/about-us/svr.svg"
import tbd from "@assets/about-us/tbd.svg"
import tia from "@assets/about-us/tia.svg"
import disrupt from "@assets/about-us/disrupt.svg"
import ces from "@assets/about-us/ces.svg"
import sogal from "@assets/about-us/sogal.svg"
import europro from "@assets/about-us/europro.svg"
import allaunchpad from "@assets/about-us/allaunchpad.svg"

import haitham from "@assets/about-us/haitham.webp"
import haithamTablet from "@assets/about-us/haithamtablet.webp"
import haithamDesktop from "@assets/about-us/haithamdesktop.webp"
import lincoln from "@assets/about-us/lincoln.webp"
import lincolnTablet from "@assets/about-us/lincolntablet.webp"
import lincolnDesktop from "@assets/about-us/lincolndesktop.webp"
import tennibotStory from "@assets/about-us/tennibotstory.webp"
import tennibotStoryTablet from "@assets/about-us/tennibotstorytablet.webp"
import tennibotStoryDesktop from "@assets/about-us/tennibotstorydesktop.webp"
import tennibotStoryDesktopXl from "@assets/about-us/tennibotstorydesktopxl.webp"

import tennibotStoryShadowTablet from "@assets/about-us/tennibotstoryshadowtablet.webp"
import tennibotStoryShadowDesktop from "@assets/about-us/tennibotstoryshadowdesktop.webp"
import tennibotStoryShadowDesktopXl from "@assets/about-us/tennibotstoryshadowdesktopxl.webp"
import { Pages } from "@utils"

const MARQUEE_CONTENT = [
  {
    img: muse,
    label: 'Gold winner'
  },
  {
    img: svr,
    label: 'Finalist'
  },
  {
    img: tbd,
    label: 'Innovation award'
  },
  {
    img: tia,
    label: 'Winner'
  },
  {
    img: disrupt,
    label: 'Innovation winner'
  },
  {
    img: ces,
    label: 'Honoree'
  },
  {
    img: sogal,
    label: 'Gold winner'
  },
  {
    img: europro,
    label: 'Top design winner'
  },
  {
    img: allaunchpad,
    label: 'Winner'
  }
]

---

<Layout title="Welcome to Tennibot.">
    <main class="bg-t-off-black overflow-hidden text-t-off-white" >
        <section class="relative" >
            <AboutSlider client:load />
        </section>

        <section>
            <div class="w-[80%] 2xl:w-[60%] mx-auto flex flex-col justify-center items-center gap-14 py-16 min-[933px]:pt-32 min-[933px]:pb-40 " >
                <Text tag="h2" className="font-avenir uppercase text-3xl md:text-4xl lg:text-5xl tablet:text-left w-full" >Our <strong class="font-avenirBold" >founders</strong></Text>
                <div class="flex flex-col justify-center gap-10 items-center tablet:w-[70%] min-[933px]:w-[100%] md:justify-between min-[933px]:flex-row-reverse" >
                    <picture class="rounded-full group/haithamImg relative bg-t-off-white lg:hover:bg-transparent transition-all duration-500 ease-in-out" >
                        <source srcset={haitham.src} media="(max-width: 450px)" />
                        <source srcset={haithamTablet.src} media="(max-width: 768px)" />
                        <Image src={haithamDesktop} alt="Haitham Eletrabi" class="relative w-full z-10 tablet:bottom-5 tablet:right-5 bottom-3 right-3 lg:group-hover/haithamImg:bottom-0 lg:group-hover/haithamImg:right-0 mx-auto transition-all duration-500 ease-in-out" />
                    </picture>
                    <div class="min-[933px]:w-[60%]" >
                        <Text tag="h3" className="uppercase font-avenirBold text-2xl sm:text-3xl mt-8 mb-3"  >Haitham Eletrabi</Text>
                        <Text tag="p" className="font-plutoLight sm:text-lg 2xl:text-xl " >Haitham is the co-founder & CEO at Tennibot. Haitham is a competitive tennis player and hardware hacker. He oversees the operations and supply chain.  Fun fact: Haitham has a Netherland Dwarf bunny called Oreo :)</Text>
                    </div>
                </div>
                <div class="flex flex-col justify-center gap-10 items-center tablet:w-[70%] min-[933px]:w-[100%] md:justify-between min-[933px]:flex-row" >
                    <picture class="rounded-full group/lincolnImg relative bg-t-off-white lg:hover:bg-transparent transition-all duration-500 ease-in-out" >
                        <source srcset={lincoln.src} media="(max-width: 450px)" />
                        <source srcset={lincolnTablet.src} media="(max-width: 768px)" />
                        <Image src={lincolnDesktop} alt="Lincoln Wang" class="relative w-full z-10 mx-auto tablet:bottom-5 tablet:right-5 bottom-3 right-3 lg:group-hover/lincolnImg:bottom-0 lg:group-hover/lincolnImg:right-0 transition-all duration-500 ease-in-out" />
                    </picture>
                    <div class="min-[933px]:w-[60%] min-[933px]:ml-5" >
                        <Text tag="h3" className="uppercase font-avenirBold text-2xl sm:text-3xl mt-8 mb-3"  >Lincoln Wang</Text>
                        <Text tag="p" className="pb-10 font-plutoLight sm:text-lg 2xl:text-xl" >Lincoln is the co-founder & CTO at Tennibot. Lincoln is a robotics & computer vision guru. He oversees engineering, software and electronics. Fun fact: Lincoln hits un-returnable cross-court forehands!</Text>
                    </div>
                </div>
            </div>
        </section>

        <section class="w-full" >
            <div class="" >
                <Text tag="h2" className="w-[80%] 2xl:w-[60%] mx-auto font-avenir uppercase text-3xl md:text-4xl lg:text-5xl mb-10 min-[933px]:text-right" >Our <strong class="font-avenirBold" >story</strong></Text>
                <picture class="group/tennibotStory absolute z-[1] w-full" >
                    <source srcset={tennibotStory.src} media="(max-width: 450px)" />
                    <source srcset={tennibotStoryTablet.src} media="(max-width: 680px)" />
                    <source srcset={tennibotStoryDesktop.src} media="(max-width: 1000px)" />
                    <Image src={tennibotStoryDesktopXl} alt="Tennibot Story" class=" w-full 2xl:w-[60%] mx-auto tablet:w-[80%] tablet:mx-auto relative tablet:bottom-3 tablet:right-3 lg:group-hover/tennibotStory:bottom-0 lg:group-hover/tennibotStory:right-0 transition-all duration-500 ease-in-out " />
                </picture>
                <picture>
                    <!-- <source srcset={tennibotStory.src} media="(max-width: 450px)" /> -->
                    <source srcset={tennibotStoryShadowTablet.src} media="(max-width: 680px)" />
                    <source srcset={tennibotStoryShadowDesktop.src} media="(max-width: 1000px)" />
                    <Image src={tennibotStoryShadowDesktopXl} alt="Tennibot Story" class="w-full 2xl:w-[60%] tablet:w-[80%] tablet:mx-auto relative" />
                </picture>

                <div class="w-[80%] 2xl:w-[60%] flex flex-col lg:flex-row mx-auto gap-8 pt-10" >
                    <Text tag="p" className="font-plutoLight sm:text-lg 2xl:text-xl"  >Tennibot was born one night as Haitham, practicing with a ball machine, realized that he spent more time picking up balls than actually hitting them. So he set out to fix the worst part of his favorite sport. That was when Haitham was introduced to Lincoln through an Auburn business professor. Lincoln had just finished his Master's degree and happened to be a tennis enthusiast himself.</Text>
                    <Text tag="p" className="font-plutoLight sm:text-lg 2xl:text-xl" >Soon after meeting, whenever the duo wasn’t playing doubles, they were working on the Tennibot. After years of designing, prototyping, testing and tweaking, the team was able to take Tennibot from a mere concept to the most innovative product to hit the tennis industry in years. Now the Tennibot is ready to be put on every tennis court in the world and make tedious ball-collecting a thing of the past.</Text>
                </div>
                <Text className="text-3xl sm:text-4xl italic font-avenir font-thin mt-14 md:mt-20 text-center mx-auto lg:mb-14" >Revolutionize the<br class="tablet:hidden" /> way you train,<br class="hidden tablet:block lg:hidden" /> one<br class="tablet:hidden" /> robot at a time.</Text>
            </div>
        </section>

        <section>
            <section class="bg-t-off-black pt-36 pb-24" >
                <Text tag="h2" className="w-[80%] 2xl:w-[60%] mx-auto font-avenir uppercase tablet:text-left text-center min-[933px]:text-left mb-10 text-3xl md:text-4xl lg:text-5xl" >Our <strong class="font-avenirBold" >trophy case</strong></Text>
                <div class="relative flex h-full w-full flex-col items-center justify-center overflow-hidden" >
                  <Marquee pauseOnHover className="[--duration:50s]" >
                    {MARQUEE_CONTENT.map((item, index) => {
                      return (
                        <MarqueeItem key={index} img={item.img} label={item.label} />
                      )
                    })}
                  </Marquee>
                </div>
              </section>
        </section>

        <section class=" bg-t-off-black lg:pb-32 pt-10 pb-20 text-t-off-white" >
          <div class="w-[80%] 2xl:w-[65%] flex md:flex-row flex-col items-end mx-auto h-full " >
              <div>
                <Text tag="h2" className="font-avenir uppercase pb-5 text-3xl md:text-4xl lg:text-5xl text-left" >Our <strong class="font-avenirBold" >careers</strong></Text>
                <Text tag="p" className="font-plutoLight lg:text-lg 2xl:text-xl md:w-[90%] 2xl:w-[70%]" >Do you love robots and sports? Tennibot might be the perfect fit. We are a diverse group of night owls and coffee drinkers who are extremely passionate about what we do.</Text>
              </div>
              <div class="lg:w-[50%] lg:mt-0 mt-10 w-full flex lg:justify-end justify-center" >
                  <Button href={Pages.CAREERS} theme="ghostLight" >View open positions</Button>
              </div>
          </div>
      </section>

    </main>
</Layout>