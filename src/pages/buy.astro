                        },
                        "background-color": "#b5f20c",
                        ":focus": {
                            "background-color": "#b5f20c"
                        },
                        "border-radius": "40px",
                    },
                    "quantityInput": {
                        // "font-size": "16px",
                        "border-radius": "0px",
                        "border-width": "1.5px",
                        "margin": "0px",
                        "padding": "14.5px 0px"
                    },
                    "quantityDecrement": {
                        "border-radius": "25px 0px 0px 25px",
                        "border-width": "2px 0px 2px 2px",
                        "color": "white",
                        "width": "30px",
                        "padding": "14.5px 0px"
                    },
                    "quantityIncrement": {
                        "border-radius": "0px 25px 25px 0px",
                        "border-width": "2px 2px 2px 0px",
                        "color": "white",
                        "width": "30px",
                        "padding": "14.5px 0px"
                    }
                },
                "buttonDestination": "checkout",
                "contents": {
                  "img": false,
                  "title": false,
                  "price": false
                },
