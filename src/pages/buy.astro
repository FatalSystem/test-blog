        <section class="bg-t-off-black pb-24" >
          <div class="relative flex h-full w-full flex-col items-center justify-center overflow-hidden" >
            <Marquee pauseOnHover className="[--duration:100s]" >
              {MARQUEE_CONTENT.map((item, index) => {
                return (
                  <CustomerReview key={index} review={item.review} author={item.author} />
                )
              })}
            </Marquee>
          </div>
        </section>
  
        <section id="faq" class="w-[80%] 2xl:w-[65%] py-20 mx-auto">
          <Text tag="h2" className="font-plutoBold text-t-off-white text-xl lg:text-2xl xl:text-3xl mb-7" >Frequently Asked Questions</Text>
          {FAQ.map((item, index) => {
            return (
              <FAQItem key={index} index={index} question={item.question} answer={item.answer} client:idle />
            )
          })}
        </section>
  
        <section class=" bg-t-off-black lg:pb-32 pt-11 pb-20 text-t-off-white" >
          <div class="w-[80%] 2xl:w-[65%] flex flex-col items-end mx-auto h-full " >
