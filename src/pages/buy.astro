                      "max-width": "100%",
                      "margin-left": "0px",
                      "margin-bottom": "0px"
                    }
                  },
                  "button": {
                    // "font-size": "1.5rem",
                    "padding-top": "16px",
                    "padding-bottom": "16px",
                    "color": "#111111",
                    ":hover": {
                      "color": "#111111",
                      "background-color": "#a8c600"
                    },
                    "background-color": "#bbdc00",
                    ":focus": {
                      "background-color": "#a8c600"
                    },
                    "border-radius": "40px",
                    "padding-left": "56px",
                    "padding-right": "56px"
                  },
                  "quantityInput": {
                    // "font-size": "16px",
                    "padding-top": "16px",
                    "padding-bottom": "16px"
                  }
                },
