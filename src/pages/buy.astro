                    // "font-size": "1.5rem",
                    "padding-top": "16px",
                    "padding-bottom": "16px",
                    "color": "#111111",
                    ":hover": {
                      "color": "#111111",
                      "background-color": "#a8c600"
                    },
                    "background-color": "#bbdc00",
                    ":focus": {
                      "background-color": "#a8c600"
                    },
                    "border-radius": "40px"
                  }
                },
                "text": {
                  "total": "Subtotal",
                  "button": "Checkout"
                },
                "popup": false
              },
              "toggle": {
                "styles": {
                  "toggle": {
                    "background-color": "#bbdc00",
                    ":hover": {
                      "background-color": "#a8c600"
                    },
                    ":focus": {
