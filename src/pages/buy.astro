---
import Layout from "../layouts/Layout.astro"
import Text from "@components/core/Text.astro"
import { Image } from 'astro:assets'
// import Button from "@components/core/Button.astro"
// import BuyImageGallery from "@components/BuyImageGallery/BuyImageGallery.tsx"
import {CustomerReviews} from "@components/CustomerReviews.tsx"

import shopPay from "@assets/buy/shoppay.svg"
import googlePay from "@assets/buy/googlepay.svg"
import metaPay from "@assets/buy/metapay.svg"

import visa from "@assets/buy/visa.svg"
import mastercard from "@assets/buy/mastercard.svg"
import amex from "@assets/buy/amex.svg"
import discover from "@assets/buy/discover.svg"
import type { EmblaOptionsType } from "embla-carousel/components/Options"

const OPTIONS: EmblaOptionsType = {}
const SLIDE_COUNT = 10
const SLIDES = Array.from(Array(SLIDE_COUNT).keys())

import roverOnCourt from "@assets/buy/rovercourt.webp"

const slides = [
  {
    img: roverOnCourt,
    alt: "Tennibot on the court."
  },
  {
    img: roverOnCourt,
    alt: "Tennibot on the court."
  },
  {
    img: roverOnCourt,
    alt: "Tennibot on the court."
  },
  {
    img: roverOnCourt,
    alt: "Tennibot on the court."
  }
]

const payStyle = 'w-[30%]'

---

<Layout title="Welcome to Tennibot.">
    <main class="bg-t-off-black overflow-hidden text-t-off-white" >
      <section class="bg-[url('/images/buy/courtbg.webp')] bg-center bg-cover py-10 md:h-[90vh] h-[110vh]" >
        <div class="w-[80%] h-full md:h-fit md:grid md:grid-cols-2 md:gap-10 flex flex-col justify-between mx-auto" >
          <div>
            <Text tag="h1" className="text-3xl md:text-2xl text-pretty uppercase mb-5" >Try risk free with a<br> <span class="font-black" >100 day money-back guarantee</span></Text>
            <Text className="md:text-lg" >Jump into the future of sports with Tennibot, the world’s first autonomous tennis assistant. Save time on the court and hit hundreds of extra shots in every practice session.</Text>
          </div>

          <div class="bg-t-off-black border border-t-off-white rounded-lg p-5" >
            
              <div class="flex flex-row justify-between mb-2" >
                  <Text tag="h2" className="text-2xl font-black" >Tennibot</Text>
                  <Text tag="p" className="text-xl font-black text-center" >$2,195</Text>
              </div>
              <Text tag="p" className="mb-5" >Or monthly payments as low as <strong class="text-t-green" >$112</strong> with Shop Pay!</Text>
              <ul class="list-disc list-inside font-avenir text-t-off-white text-pretty" >
                <li>New orders ship April 2024!</li>
                <li>Limited quantity available</li>
              </ul>

              <div class="flex flex-col md:items-start md:flex-col-reverse items-center mt-4 mb-5 ">
                <div class="flex flex-col items-center " >
                    <div id='product-component-1697596901031' class="self-center md:self-start" />
                </div>
              </div>

              <div>
                <div class="flex flex-row justify-between w-" >
                    <Image src={shopPay} alt="Shop Pay" class={payStyle} />
                    <Image src={googlePay} alt="Google Pay" class={payStyle} />
                    <Image src={metaPay} alt="Meta Pay" class={payStyle} />
                </div>
                <div class="mt-3 flex flex-row gap-3 " >
                    <Image src={visa} alt="Visa" class="w-[10%]" />
                    <Image src={mastercard} alt="Mastercard" class="w-[10%]" />
                    <Image src={amex} alt="Amex" class="w-[10%]" />
                    <Image src={discover} alt="Discover" class="w-[10%]" />
                    <Text tag="p" >+4</Text>
                </div>
            </div>

          </div>
        </div>
      </section>

