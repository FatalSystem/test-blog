---
import Layout from "layouts/Layout.astro"
import time from '@assets/partner/time.svg'
import bbc from '@assets/partner/bbc.svg'
import techCrunch from '@assets/partner/techcrunch.svg'
import bloomberg from '@assets/partner/bloomberg.svg'
import customization from '@assets/partner/customization-icon.svg'
import moneyBack from '@assets/partner/return-icon.svg'
import warranty from '@assets/partner/warranty-icon.svg'
import PartnerVideoDisplay from "@components/PartnerVideoDisplay"
import PartnerFooter from "@components/PartnerFooter.astro"
import PartnerFeatures from "@components/PartnerFeatures"
import TestimonialItem from "@components/TestimonialItem"
import PartnerVideoSlider from "@components/PartnerVideoSlider"
import { Pages } from "@utils"
import PartnerHowItWorksSlider from "@components/PartnerHowItWorksSlider"
import DraggableSlider from "@components/DraggableSlider"
import DraggablePartnerAction from "@components/DraggablePartnerAction"
---
<Layout title="Partner | Tennibot" showFooter={false} showHeader={false} showPartnerHeader={true} >
    <main class="w-full bg-t-off-black text-t-off-white" >
      <section class="relative h-[100vh] bg-[url('/images/partner/partner-hero.webp')] bg-cover md:bg-left bg-[position:10%_75%] flex flex-col justify-between" >
        <div class="absolute inset-0 bg-gradient-to-l md:from-black/70 from-black/40 from-0% md:to-transparent to-black/40 md:to-90%"></div>
        <div class="flex flex-col justify-start w-fit self-center md:items-center items-start z-10 pt-[8vh] p-5" >
            <h1 class="font-avenir text-t-off-white uppercase mb-3 lg:text-6xl text-4xl text-center" >The <span class="font-avenirBold" >Partner</span></h1>
            <p class="font-avenir text-t-off-white text-left uppercase md:text-xl text-md" >
                The only ball machine<br class="md:hidden" /> that moves like a human.
            </p>
            <a href={Pages.RESERVE} class={`mt-10 w-64 tablet:w-64 2xl:w-80 text-xl 2xl:text-2xl 2xl:py-3 rounded-full py-2 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green`}>Reserve</a>
        </div>

        <div class="w-[50%] mx-auto pb-[15vh] z-10 flex flex-col justify-end" >
            <p class="font-avenir text-t-off-white uppercase text-center md:text-lg text-sm mb-3 flex flex-col justify-center items-center" >As seen in:</p>
            <div class="mobilel:flex mobilel:flex-row grid grid-cols-2 md:gap-7 gap-5 items-center justify-center" >
                <img
                src={time.src}
                width={70}
                height={50}
                class="brightness-0 invert mobilel:w-[50px]  lg:w-[80px]"
                />
                <img
                src={techCrunch.src}
                width={130}
                height={50}
                class="brightness-0 invert mobilel:w-[110px] lg:w-[150px]"
                />
                <img
                src={bbc.src}
                width={60}
                height={50}
                class="brightness-0 invert mobilel:w-[50px] lg:w-[80px]"
                />
                <img
                src={bloomberg.src}
                width={120}
                class="brightness-0 invert mb-[-5px] mobilel:w-[100px] lg:w-[130px]"
                />
            </div>
        </div>
      </section>

      <section class="relative hidden lg:block bg-black" >
        <div class="w-[80%] mx-auto pt-24 pb-10" >
            <h2 class="font-avenirBold text-t-green text-center uppercase md:text-3xl mobilem:text-2xl text-xl" >Train without limits</h2>
        </div>
        <PartnerVideoDisplay client:load />
    </section>

    <section class="relative block lg:hidden bg-black" >
        <div class="w-[80%] mx-auto pt-24 pb-10" >
            <h2 class="font-avenirBold text-t-green text-center uppercase md:text-3xl mobilem:text-2xl text-xl" >Train without limits</h2>
        </div>
        <PartnerVideoSlider type="tennis" client:load />
    </section>

      <section class="bg-black" >
        <div class="w-[80%] mx-auto pt-16 pb-10" >
            <h2 class="font-avenirBold text-t-green text-center uppercase md:text-3xl mobilem:text-2xl text-xl" >Why Tennibot?</h2>
            <p class="font-pluto text-t-off-white text-center mt-5 md:text-lg mobilem:text-md text-sm" >We invented intelligent court training – the rest are just playing catch-up.</p>
        </div>

        <div class="w-[80%] mx-auto flex lg:flex-row flex-col lg:gap-15 gap-10 pt-5 pb-16" >
            <div class="w-[100%] border-2 md:max-w-[50%] md:mx-auto border-t-off-white rounded-xl text-left py-8 px-5" >
                <h5 class="font-avenirBold uppercase text-xl text-t-off-white mb-3" >Premium Quality</h5>
                <p class="font-pluto text-t-off-white text-sm text-pretty" >Tennibot is the only ball machine company that offers a <span class="text-t-green">3-year warranty</span>. We stand behind our quality, while others don't.</p>
            </div>
            <div class="w-[100%] border-2 md:max-w-[50%] md:mx-auto border-t-off-white rounded-xl text-left py-8 px-5" >
                <h5 class="font-avenirBold uppercase text-xl text-t-off-white mb-3" >Track Record</h5>
                <p class="font-pluto text-t-off-white text-sm text-pretty" >Since 2018, we have been building autonomous tennis robots for picking up balls and sweeping clay courts. <span class="text-t-green">This is not our first rodeo :)</span></p>
            </div>
            <div class="w-[100%] border-2 md:max-w-[50%] md:mx-auto border-t-off-white rounded-xl text-left py-8 px-5" >
                <h5 class="font-avenirBold uppercase text-xl text-t-off-white mb-3" >Detail Obsessed</h5>
                <p class="font-pluto text-t-off-white text-sm text-pretty" >We purchased, tested, and analyzed <span class="text-t-green">every ball machine on the market</span> to solve & address all the consumer pain points and inconveniences to build the ultimate ball machine!</p>
            </div>
        </div>
      </section>

      <section class="bg-black" >
        <div class="w-[80%] mx-auto flex md:flex-row flex-col justify-center pt-10 md:pb-36 pb-16" >
            <div class=" flex flex-col md:items-center items-start md:w-[50%]" >
                <h5 class="font-avenirBold md:text-2xl text-xl uppercase text-left text-t-off-white mb-5" >
                    Designed and<br class="" /> assembled in the USA
                </h5>
            </div>
            <div class="md:w-[50%] flex flex-col justify-between" >
                <p class="font-avenir md:text-md text-sm text-t-off-white mb-8" >
                    Tennibot's products are proudly designed and assembled in Auburn, Alabama.<br class="md:block hidden" /> Crafted with care by fellow tennis, pickle, & padel players.
                </p>
                <a href={Pages.RESERVE} class={`tablet:w-64 w-full 2xl:w-80 text-xl 2xl:text-2xl 2xl: 2xl:py-3 rounded-full py-2 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green`}>Reserve</a>
            </div>
        </div>

        <div class="w-[80%] mx-auto flex flex-row justify-center gap-10 pt-5 pb-16" >
            <p class="font-avenir text-t-off-white text-center text-md md:text-lg" >
                "Finally, a ball machine that moves and adapts like a real player. I have been waiting for this invention for years!"<br /> <br />James C., Tennis Coach | Burlingame, CA
            </p>
        </div>
      </section>
      
      <section class="bg-black pt-5 md:pb-36 pb-16" >
        <PartnerFeatures client:load />
      </section>

      <section class="bg-black md:pb-36 pb-16 pt-10" >
        <div class="w-[80%] mx-auto" >
            <h2 class="font-avenirBold text-t-green text-center md:text-3xl mobilem:text-2xl text-xl uppercase" >How partner works</h2>
            <p class="font-pluto text-t-off-white text-center md:text-lg mobilem:text-lg text-sm mt-5 mb-10" >In three easy steps...</p>
        </div>
        <PartnerHowItWorksSlider client:load />
      </section>
      <section class="bg-black pt-16 md:pb-36 pb-16" >
        <div class="" >
            <h2 class="w-[80%] mx-auto font-avenirBold text-t-green text-center md:text-3xl mobilem:text-2xl text-xl mb-10" >Intelligent. Powerful. Unmatched.</h2>
            <div class="lg:bg-t-off-black lg:w-[80%] lg:mx-auto lg:p-10 rounded-xl flex flex-col">
                <p class="md:mx-5 mx-auto font-avenir uppercase text-t-off-white md:text-2xl mobilem:text-xl mb-5">See it in action</p>
                <DraggablePartnerAction client:load />
            </div>
        </div>
      </section>
      <section class="bg-black pt-16 pb-36" >
        <div class="" >
            <h2 class="font-avenirBold text-t-green text-center md:text-3xl mobilem:text-2xl text-xl mb-10" >But don't take our word for it!</h2>
            <!-- <div class="px-5 flex flex-row gap-10 overflow-x-scroll flex-nowrap [&::-webkit-scrollbar]:hidden" > -->
            <DraggableSlider client:load className="gap-10" >
                <TestimonialItem client:load quote={`"It’s fantastic for drilling, practice points, and even doubles drills. I really enjoyed it."`} name="Sylvana Jordyn" location="Rockville, MD" videoSource="https://player.vimeo.com/video/1031406658" className="bg-[url('/images/partner/testimonial-one.png')]" />
                <TestimonialItem client:load quote={`“I worked on rapid-fire volleys, reflexes, and range at the net—it’s perfect for sharpening your skills.”`} name="Logan West" location="Washington, DC" videoSource="https://player.vimeo.com/video/1031406854" className="bg-[url('/images/partner/testimonial-two.png')]" />
                <TestimonialItem client:load quote={`“What surprised me the most was how much I had to move and anticipate—it felt just like a real hitting session.”`} name="Alex Chan" location="Rockville, MD" videoSource="https://player.vimeo.com/video/1031406731" className="bg-[url('/images/partner/testimonial-three.png')]" />
                <TestimonialItem client:load quote={`“The Tennibot Partner is an amazing ball machine—it moves, evolves, and offers an experience unlike any other ball machine I’ve played with before.”`} name="Mo Eldemerdash" location="Auburn, AL" videoSource="https://player.vimeo.com/video/1031426621" className="bg-[url('/images/partner/testimonial-four.png')]" />
            </DraggableSlider>
            <!-- </div> -->
        </div>
      </section>

      <!-- <section class="bg-black pt-16 md:pb-44 pb-16" >
        <div class="w-[80%] md:bg-t-off-black rounded-xl mx-auto px-0 md:px-14 py-16" >
            <h2 class="font-avenirBold text-t-green text-center text-3xl  mobilem:text-2xl mb-5" >Reserve your spot now </h2>
            <p class="font-avenir text-t-off-white text-center text-lg mb-10" >Be one of the Early Backers - only 150 units available</p>
            <div class="w-[100%]">
                <div class="flex md:flex-row flex-col-reverse w-full gap-5" >
                    <div class="flex md:flex-col flex-col mt-5 md:mt-0 w-full justify-start gap-10">
                        <div>
                            <img
                            src={customization.src}
                            width={25}
                            height={25}
                            />
                            <p class="font-avenirBold text-t-off-white text-lg mt-3" >Personalized Customization</p>
                            <p class="font-pluto text-t-off-white" >Have your name, your loved one's name, or even your club's name etched on your robot.</p>
                        </div>
                        <div>
                            <img
                            src={moneyBack.src}
                            width={25}
                            height={25}
                            />
                            <p class="font-avenirBold text-t-off-white text-lg mt-3" >60-day-money-back-guarantee</p>
                            <p class="font-pluto text-t-off-white" >Try Partner for 60 days. Free returns within 60 days</p>
                        </div>
                        <div>
                            <img
                            src={warranty.src}
                            width={25}
                            height={25}
                            />
                            <p class="font-avenirBold text-t-off-white text-lg mt-3" >5 Year Warranty</p>
                            <p class="font-pluto text-t-off-white" >We've got you covered. Purchase with peace of mind.</p>
                        </div>
                        <a href={Pages.RESERVE} class={`tablet:w-64 w-full 2xl:w-80 text-xl 2xl:text-2xl 2xl: 2xl:py-3 rounded-full py-2 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green`}>Reserve</a>
                    </div>
                    <div class="w-full relative h-[40vh] md:h-auto overflow-hidden bg-[url('/images/partner/founderb.webp')] bg-cover bg-center rounded-xl" >
                    </div>
                </div>
            </div>
        </div>
      </section> -->
    </main>
</Layout>
<PartnerFooter />