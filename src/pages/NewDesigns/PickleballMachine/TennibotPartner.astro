---
import bucketmachin from "../../../assets/newdesignimages/bucketmachin.png";
import picklebotIcon from "../../../assets/newdesignimages/picklebotIcon.png";
import '../../../../public/styles/global.css'

---

<section class="bg-[#191A16] text-white">
  <div class="py-16 px-6">
<div class="max-w-[80rem] mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        
        <div class="space-y-8">
        <div class="space-y-2">
  <h1 class="font-extrabold text-[36px] leading-[40px] uppercase font-dm-sans">
    MEET THE TENNIBOT PARTNER:
  </h1>
  <h1 class="font-extrabold text-[36px] leading-[40px] uppercase text-[#C0F20C] font-dm-sans">
    YOUR ULTIMATE PICKLEBALL TRAINING PARTNER
  </h1>
</div>

          
        <p class="text-[#F6F7F2] text-[16px] leading-[24px] tracking-[-0.4px] font-light font-pluto-sans max-w-md">
  The Tennibot Partner is the best pickleball machine for players who demand AI precision, total control, and high portability.
</p>

          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Custom drill builder</h4>
                <p class="text-gray-300 mt-1">Create and save personalized training sequences</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">App + remote operation</h4>
                <p class="text-gray-300 mt-1">Full control from your smartphone or included remote</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Trusted by clubs, coaches & advanced players</h4>
                <p class="text-gray-300 mt-1">Professional-grade equipment for serious training</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="relative  h-[586px]">
  <img
    src={bucketmachin.src}
    class="w-full h-full object-cover rounded-[12px] opacity-100"
    alt="Bucket Machine"
  />
</div>

      </div>
    </div>
  </div>

  <!-- Second Section - Tennibot Rover -->
  <div class="py-16 px-6">
   <div class="max-w-[80rem] mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        
              
        <div class="relative  h-[586px]">
  <img
    src={picklebotIcon.src}
    class="w-full h-full object-cover rounded-[12px] opacity-100"
    alt="Bucket Machine"
  />
</div>
        
        <!-- Right Content -->
        <div class="space-y-8">
          <div class="space-y-4">
            <h2 class="text-4xl lg:text-5xl font-bold leading-tight uppercase">
              COMBINE IT WITH THE TENNIBOT ROVER
            </h2>
            <h3 class="text-3xl lg:text-4xl font-bold leading-tight uppercase">
              FOR <span class="text-lime-400">COMPLETE AUTONOMY</span>
            </h3>
          </div>
          
          <p class="text-gray-300 text-lg leading-relaxed max-w-md">
            Pair your pickleball machine with the Tennibot Rover – the AI-powered ball collector that handles cleanup while you focus on playing.
          </p>
          
          <!-- Features List -->
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Nonstop drill sessions</h4>
                <p class="text-gray-300 mt-1">Train continuously without interruption</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Automated ball pickup</h4>
                <p class="text-gray-300 mt-1">Never waste time collecting balls manually</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Smoother training flow</h4>
                <p class="text-gray-300 mt-1">Focus entirely on skill development</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>