---
import leftvectorIcon from "../../../assets/newdesignimages/leftvectorIcon.png";
import RightVectorIcon from "../../../assets/newdesignimages/RightVectorIcon.png";
import BallsBeg from "../../../assets/newdesignimages/BallsBeg.png";
import MoneyBackIcon from "../../../assets/newdesignimages/MoneyBackIcon.png";
import TruckIcon from "../../../assets/newdesignimages/TruckIcon.png";
import protectIcon from "../../../assets/newdesignimages/protectIcon.png";
import picklebotbuy from "../../../assets/newdesignimages/picklebotbuy.png";
import '../../../../public/styles/global.css'
---

<section class="relative bg-[#191A16] min-h-screen overflow-hidden flex items-start justify-center pt-12 pb-12 mt-10">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      
      <div class="space-y-4">
        <div class="relative bg-gray-800 rounded-lg overflow-hidden">
          <div class="aspect-square bg-gray-700 flex items-center justify-center relative">
            <div class="w-full h-full bg-gradient-to-br from-gray-600 to-gray-800 flex items-center justify-center">
              <img src={picklebotbuy.src} alt="Pickleball Machine" class="w-full h-full object-cover" />
            </div>
          </div>
          
         <button class="absolute left-4 top-1/2 transform -translate-y-1/2 w-12 h-12 bg-transparent border-2 border-white hover:bg-white/10 rounded-full flex items-center justify-center transition-all duration-200">
            <img src={leftvectorIcon.src} alt="Previous" class="w-8 h-6" />
          </button>
         <button class="absolute right-4 top-1/2 transform -translate-y-1/2 w-12 h-12 bg-transparent border-2 border-white hover:bg-white/10 rounded-full flex items-center justify-center transition-all duration-200">
            <img src={RightVectorIcon.src} alt="Next" class="w-8 h-6" />
          </button>
          
          <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 flex space-x-2">
            <div class="w-3 h-3 bg-white rounded-full"></div>
            <div class="w-2 h-2 bg-white/40 rounded-full"></div>
            <div class="w-2 h-2 bg-white/40 rounded-full"></div>
            <div class="w-2 h-2 bg-white/40 rounded-full"></div>
            <div class="w-2 h-2 bg-white/40 rounded-full"></div>
            <div class="w-2 h-2 bg-white/40 rounded-full"></div>
          </div>
        </div>
        
        <div class="flex space-x-2">
          <div class="w-28 h-28 bg-gray-700 rounded-lg flex-shrink-0 overflow-hidden">
            <img src={picklebotbuy.src} alt="Thumbnail 1" class="w-full h-full object-cover" />
          </div>
    <div class="w-28 h-28  bg-gray-700 rounded-lg flex-shrink-0 overflow-hidden">
            <img src={BallsBeg.src} alt="Thumbnail 2" class="w-full h-full object-cover" />
          </div>
           <div class="w-28 h-28  bg-gray-700 rounded-lg flex-shrink-0 overflow-hidden">
               <img src={BallsBeg.src} alt="Thumbnail 2" class="w-full h-full object-cover" />
          </div>
           <div class="w-28 h-28  bg-gray-700 rounded-lg flex-shrink-0 overflow-hidden">
             <img src={picklebotbuy.src} alt="Thumbnail 1" class="w-full h-full object-cover" />
           </div>
           <div class="w-28 h-28  bg-gray-700 rounded-lg flex-shrink-0 overflow-hidden">
             <img src={picklebotbuy.src} alt="Thumbnail 1" class="w-full h-full object-cover" />
           </div>
        </div>
      </div>
      
      <div class="space-y-6">
        <h1 class="text-white text-3xl lg:text-4xl font-bold leading-tight uppercase">
        Pickleball Ball Collector  <br/>
         for Smarter Practice
        </h1>
        
        <div class="flex items-center space-x-3">
          <div class="flex space-x-1">
            <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
            </svg>
            <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
            </svg>
            <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
            </svg>
            <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
            </svg>
            <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
            </svg>
          </div>
          <span class="text-gray-400 text-sm">(4.8) based on 526 reviews</span>
        </div>
        
        <p class="text-gray-300 text-lg leading-relaxed">
         Tennibot Rover is the AI-powered pickleball retriever that lets you train more and pick up less.
        </p>
        
        <div class="flex items-center space-x-3">
          <span class="text-white text-3xl font-bold">$2,195</span>
          <span class="text-gray-400 text-xl line-through">$3,500</span>
        </div>
        
        <div class="flex space-x-4">
          <!-- PickleballCollector -->
            <a
         
          class="bg-lime-400 hover:bg-lime-500 text-black font-semibold px-20 py-3 rounded-full transition-colors uppercase">
            BUY NOW
        </a>
          <button class="border-2 border-lime-400 text-lime-400 bg-[#2b2e17] hover:bg-lime-400 hover:text-black font-semibold px-20 py-3 rounded-full transition-colors uppercase">
            BOOK A DEMO 
          </button>
        </div>
        
        <div class="flex items-center space-x-8 pt-6">
          <div class="flex items-center space-x-3">
            <div class="w-20 h-15 bg-[#262424] rounded-2xl flex items-center justify-center">
              <img src={TruckIcon.src} alt="Shipping" class="w-8 h-8" />
            </div>
            <div class="text-gray-300">
              <div class="text-sm font-medium">Free shipping in the US</div>
             
            </div>
          </div>
          
          <div class="flex items-center space-x-3">
             <div class="w-20 h-15 bg-[#262424] rounded-2xl flex items-center justify-center">
              <img src={MoneyBackIcon.src} alt="Money Back" class="w-8 h-8" />
            </div>
            <div class="text-gray-300">
              <div class="text-sm font-medium">60 day money-back guarantee</div>
    
            </div>
          </div>
          
          <div class="flex items-center space-x-3">
           <div class="w-20 h-15 bg-[#262424] rounded-2xl flex items-center justify-center">
              <img src={protectIcon.src} alt="Warranty" class="w-8 h-8" />
            </div>
            <div class="text-gray-300">
              <div class="text-sm font-medium">3 Year Warranty</div>
           
            </div>
          </div>
        </div>
        
        <div class="border-2 border-lime-400 bg-[#2b2e17] rounded-lg p-6 mt-8">
          <div class="flex items-start space-x-4">
            <div class="w-32 h-42 bg-gray-700 rounded-lg flex-shrink-0 overflow-hidden">
              <img src={picklebotbuy.src} alt="Bundle" class="w-full h-full object-cover" />
            </div>
            <div class="flex-1">
              <h3 class="text-lime-400 font-semibold mb-2 uppercase">BUNDLE & SAVE!</h3>
              <p class="text-gray-300 text-sm mb-3">
                Bundle PARTNER + ROVER for seamless practice — nonstop shots, zero ball pickup.
              </p>
              <div class="flex items-center space-x-3 mb-4">
                <span class="text-white text-xl font-bold">$2,995</span>
                <span class="text-gray-400 line-through">$3,500</span>
              </div>
              <div class="flex space-x-3">
                <button class="bg-lime-400 hover:bg-lime-500 text-black font-semibold px-6 py-2 rounded-full text-sm transition-colors uppercase">
                  BUY BUNDLE
                </button>
                <button class="border border-lime-400 text-lime-400 bg-[#2b2e17] hover:bg-lime-400 hover:text-black font-semibold px-6 py-2 rounded-full text-sm transition-colors uppercase">
                  VIEW BUNDLE
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>