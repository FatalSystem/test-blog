---
import '../../../../public/styles/global.css'
---

<div class="bg-[#191A16] py-16 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <h2
        class="text-white text-4xl lg:text-5xl font-bold leading-tight uppercase mb-4"
      >
        <span class="text-lime-400">Ideal</span>
        for Players, Coaches,<br />
        and Clubs
      </h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto">
        Whether you coach juniors or run a club, a pickleball ball collector
        robot like the Rover boosts your training flow.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="bg-[#262424] rounded-lg p-8 space-y-6">
        <div class="inline-flex">
          <div
            class="text-[#C0F20C] font-bold text-base uppercase tracking-wider"
          >
            Players
          </div>
        </div>

        <p class="text-gray-300 text-base leading-relaxed">
          Maximize rally time and reduce effort
        </p>
      </div>

      <div class="bg-[#262424] rounded-lg p-8 space-y-6">
        <div class="inline-flex">
          <div
            class="text-[#C0F20C] font-bold text-base uppercase tracking-wider"
          >
            Coaches
          </div>
        </div>

        <p class="text-gray-300 text-base leading-relaxed">
          Run tighter, more efficient sessions
        </p>
      </div>

      <div class="bg-[#262424] rounded-lg p-8 space-y-6">
        <div class="inline-flex">
          <div
            class="text-[#C0F20C] font-bold text-base uppercase tracking-wider"
          >
            Clubs
          </div>
        </div>

        <p class="text-gray-300 text-base leading-relaxed">
          Save on staff time, increase court turnover
        </p>
      </div>
    </div>
  </div>
</div>
