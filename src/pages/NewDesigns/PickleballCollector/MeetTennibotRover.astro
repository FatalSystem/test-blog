---
import bucketmachin from "../../../assets/newdesignimages/bucketmachin.png";
import picklebotIcon from "../../../assets/newdesignimages/picklebotIcon.png";
import '../../../../public/styles/global.css'

---

<section class="bg-[#191A16] text-white">
  <div class="py-16 px-6">
<div class="max-w-[80rem] mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        
        <div class="space-y-8">
        <div class="space-y-2">
  <h1 class="font-extrabold text-[36px] leading-[40px] uppercase font-dm-sans">
 Meet the Tennibot Rover: 
  </h1>
  <h1 class="font-extrabold text-[36px] leading-[40px] uppercase text-[#C0F20C] font-dm-sans">
  The Future of Ball <br/>Retrieval
  </h1>
</div>

          
        <p class="text-[#F6F7F2] text-[16px] leading-[24px] tracking-[-0.4px] font-light font-pluto-sans max-w-md">
 Tennibot Rover is the most advanced pickleball ball collecting robot on the market. Fully automatic, lightweight, and powered by smart sensors, it's the best pickleball ball collector for players who value their time.
</p>

          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Real-time ball detection</h4>
                <p class="text-gray-300 mt-1">Advanced AI vision system identifies pickleballs instantly</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Intelligent obstacle avoidance</h4>
                <p class="text-gray-300 mt-1">Safely navigates around players and court equipment</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Large capacity collection tray</h4>
                <p class="text-gray-300 mt-1">Holds up to 120 pickleballs for extended sessions</p>
              </div>
            </div>
               <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Long battery life, fast recharge</h4>
                <p class="text-gray-300 mt-1">4-6 hours operation, quick charging system</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="relative  h-[586px]">
  <img
   src={picklebotIcon.src}
  
    class="w-full h-full object-cover rounded-[12px] opacity-100"
    alt="Bucket Machine"
  />
</div>

      </div>
    </div>
  </div>

  <!-- Second Section - Tennibot Rover -->
  <div class="py-16 px-6">
   <div class="max-w-[80rem] mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        
              
        <div class="relative  h-[586px]">
  <img
      src={bucketmachin.src}
    class="w-full h-full object-cover rounded-[12px] opacity-100"
    alt="Bucket Machine"
  />
</div>
        
        <!-- Right Content -->
        <div class="space-y-8">
          <div class="space-y-4">
            <h2 class="text-4xl lg:text-5xl font-bold leading-tight uppercase">
            Pair With the Tennibot Partner for <span class="text-lime-400">Full Automation</span>
            </h2>
           
          </div>
          
          <p class="text-gray-300 text-lg leading-relaxed max-w-md">
           Train. Shoot. Collect. Repeat. Combine Tennibot Rover with the Tennibot Partner ball machine to create a fully autonomous pickleball training system
          </p>
          
          <!-- Features List -->
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Drill + cleanup = uninterrupted focus</h4>
                <p class="text-gray-300 mt-1">Never stop training to collect balls</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-6 h-6 bg-lime-400 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="text-lime-400 font-semibold text-lg">Built for solo players, coaches, and team training</h4>
                <p class="text-gray-300 mt-1">Perfect for any training scenario</p>
              </div>
            </div>
            
        
          </div>
        </div>
      </div>
    </div>
  </div>
</section>