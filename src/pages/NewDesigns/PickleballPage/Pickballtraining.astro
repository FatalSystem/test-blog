---
import RustedbyIcon from "../../../assets/newdesignimages/rustedbyIcon.png";
import SaveupIcon from "../../../assets/newdesignimages/SaveupIcon.png";
import AccurateIcon from "../../../assets/newdesignimages/AccurateIcon.png";
import TennibotBg from "../../../assets/newdesignimages/TennibotBg.png";
import GradientImage from "../../../assets/newdesignimages/Gradient.png";
import '../../../../public/styles/global.css'
---

<section
  class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 bg-gradient-to-b from-slate-800 to-slate-900 relative overflow-hidden"
>
  <div class="absolute inset-0 z-0">
    <img
      src={TennibotBg.src}
      alt="Tennibot Machine"
      class="w-full h-full object-cover opacity-40"
    />

    <img
      src={GradientImage.src}
      alt="Gradient Overlay"
      class="absolute top-0 left-0 w-full h-full object-cover pointer-events-none z-10"
    />
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center mb-12 sm:mb-16">
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 sm:mb-6 leading-tight text-white uppercase"
      >
        Why AI Gear Elevates Your  <span class="text-lime-400">Pickleball</span><br />
        <span class="text-lime-400">Training</span>
      </h2>
 <p
    class="text-[#F6F7F2] text-[16px] leading-[24px] tracking-[-0.4px] text-center font-[370] font-light"
    style="font-family: 'HvDTrial Pluto Sans';"
  >
    Tennibot's pickleball solutions let you focus on your game, without the hassle
  </p>

    </div>

    <div class="mb-8 sm:mb-82"></div>

    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
   

        <div class="flex items-start gap-4">
          <img
            src={AccurateIcon.src}
            alt="Lightweight"
            class="w-6 h-6 object-contain mt-1"
          />
          <h3 class="text-white font-semibold mb-2">
           Accurate training with real-time line judging
          </h3>
        </div>

        <div class="flex items-start gap-4">
          <img
            src={RustedbyIcon.src}
            alt="Trusted by coaches"
            class="w-6 h-6 object-contain mt-1"
          />
          <h3 class="text-white font-semibold mb-2">
        Perfect for clubs, coaches, and individual players
          </h3>
        </div>

        <div class="flex items-start gap-4">
          <img
            src={SaveupIcon.src}
            alt="No manual"
            class="w-6 h-6 object-contain mt-1"
          />
          <h3 class="text-white font-semibold mb-2">
         More playing time, less court cleanup
          </h3>
        </div>
      </div>
    </div>
  </div>
</section>
