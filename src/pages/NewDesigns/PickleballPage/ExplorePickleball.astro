---
import BgImage from "../../../assets/newdesignimages/Pickballbackground.png";
import GradientImage from "../../../assets/newdesignimages/Gradient.png";
import bbcimg from "../../../assets/newdesignimages/head/bbc.png";
import timeImg from "../../../assets/newdesignimages/head/timeVector.png";
import digitalTraends from "../../../assets/newdesignimages/head/digital-trends.png";
import laTimes from "../../../assets/newdesignimages/head/latimes.png";
import mashhable from "../../../assets/newdesignimages/head/mashable.png";
import '../../../../public/styles/global.css'

---

<section
  class="relative min-h-screen overflow-hidden flex items-start justify-center pt-12 pb-12 mt-10"
>
  <img
    src={BgImage.src}
    alt="Background"
    fetchpriority="high"
    class="absolute top-0 left-0 w-full h-full object-cover pointer-events-none z-0"
  />

  <img
    src={GradientImage.src}
    alt="Gradient Overlay"
    class="absolute top-0 left-0 w-full h-full object-cover pointer-events-none z-10"
  />

  <div
    class="relative z-20 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col h-full justify-between"
  >
    <div class="text-center pt-4 mt-16 uppercase">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-3 sm:mb-5 leading-snug animate-fade-in-up text-white"
      >
       Explore AI-Powered <span class="text-lime-400 drop-shadow-lg">Pickleball Gear</span> That <br />Serves, Collects & Judges

      </h1>
      <p
        class="text-xs sm:text-sm md:text-base mb-6 sm:mb-8 opacity-90 leading-relaxed animate-fade-in-up delay-200 text-white px-4 max-w-xl mx-auto"
      >
      Discover the most advanced pickleball machine, and the <br
          class="hidden sm:block"
        />
       only autonomous ball collector - powered by AI
      </p>
      <div
        class="flex gap-3 sm:gap-4 justify-center flex-wrap animate-fade-in-up delay-400"
      >
        <a
           href="/NewDesigns/PickleballMachine"

          class="px-5 py-2 sm:px-6 sm:py-3 bg-lime-400 text-black rounded-full text-xs sm:text-sm font-semibold hover:translate-y-1 hover:shadow-lg hover:shadow-lime-400/50 transition-all duration-300 transform hover:scale-105"
        >
          Pickleball Machine
        </a>
        <a
          href="#demo"
          class="px-5 py-2 sm:px-6 sm:py-3 bg-transparent text-lime-400 border-2 border-lime-400 rounded-full text-xs sm:text-sm font-semibold hover:bg-lime-400 hover:text-black hover:translate-y-1 transition-all duration-300 transform hover:scale-105"
        >
          Ball Collector
        </a>
      </div>
    </div>

    <div
      class="mt-16 flex gap-4 sm:gap-6 lg:gap-8 justify-center items-center flex-wrap z-20 px-4 mt-80"
    >
      <img
        src={timeImg.src}
        alt="TIME logo"
        class="h-4 sm:h-5 md:h-6 opacity-80 hover:opacity-100 transition-opacity duration-300"
      />
      <img
        src={bbcimg.src}
        alt="BBC logo"
        class="h-4 sm:h-5 md:h-6 opacity-80 hover:opacity-100 transition-opacity duration-300"
      />
      <img
        src={laTimes.src}
        alt="The LA Times logo"
        class="h-4 sm:h-5 md:h-6 opacity-80 hover:opacity-100 transition-opacity duration-300"
      />
      <img
        src={mashhable.src}
        alt="Mashable logo"
        class="h-4 sm:h-5 md:h-6 opacity-80 hover:opacity-100 transition-opacity duration-300"
      />
      <img
        src={digitalTraends.src}
        alt="Digital Trends logo"
        class="h-4 sm:h-5 md:h-6 opacity-80 hover:opacity-100 transition-opacity duration-300"
      />
    </div>
  </div>
</section>
