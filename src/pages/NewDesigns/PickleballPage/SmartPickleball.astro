---
import PhonesImage from '../../../assets/newdesignimages/PhonesImage.png';
import WorkswithIcon from '../../../assets/newdesignimages/WorkswithIcon.png';
import OptimizedIcon from '../../../assets/newdesignimages/OptimizedIcon.png';
import SmallPhoneIcon from '../../../assets/newdesignimages/SmallPhoneIcon.png';

import '../../../../public/styles/global.css'

---


<section  class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 bg-[#191A16] relative z-10">
  <div class="container mx-auto px-6 lg:px-12">
    
    <!-- Main Heading -->
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
        BUILD YOUR SMART PICKLEBALL<br>
        COURT WITH <span class="text-lime-400">TENNIBOT</span>
      </h1>
      <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto leading-relaxed">
        Use Tennibot gear individually or as an integrated system. Automate drills, collect<br>
        balls hands-free, and get reliable line calls - all powered by AI.
      </p>
    </div>

    <!-- Content Grid -->
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      
      <!-- Left Side - Phone Images -->
      <div class="relative flex justify-center lg:justify-start">
        <img     
          src={PhonesImage.src}
          alt="Tennibot Mobile App Interface"     
          fetchpriority="high"
          class="max-w-full h-auto"
        />
      </div>
      
      <!-- Right Side - Features -->
      <div class="space-y-8">
        
        <div class="flex items-start gap-4">
     <div class="flex-shrink-0 w-[60px] h-[60px] bg-[#262424] rounded-[12px] flex items-center justify-center">
  <img
    src={SmallPhoneIcon.src}
    alt="Tennibot Mobile App Interface"
    fetchpriority="high"
    class="w-8 h-8"  
  />
</div>

          <div>
            <h3 class="text-white font-semibold text-lg mb-2">Shared interface and app integration</h3>
            <p class="text-gray-300">Control all devices from one intuitive mobile app</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-[60px] h-[60px] bg-[#262424] rounded-[12px] flex items-center justify-center">
  <img
    src={WorkswithIcon.src}
    alt="Tennibot Mobile App Interface"
    fetchpriority="high"
    class="w-8 h-8"  
  />
</div>
          <div>
            <h3 class="text-white font-semibold text-lg mb-2">Works with all standard pickleball courts</h3>
            <p class="text-gray-300">Easy setup on any court surface or configuration</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
           <div class="flex-shrink-0 w-[60px] h-[60px] bg-[#262424] rounded-[12px] flex items-center justify-center">
  <img
    src={OptimizedIcon.src}
    alt="Tennibot Mobile App Interface"
    fetchpriority="high"
    class="w-8 h-8"  
  />
</div>
          <div>
            <h3 class="text-white font-semibold text-lg mb-2">Optimized for indoor & outdoor use</h3>
            <p class="text-gray-300">Weather-resistant design built for any environment</p>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="pt-8">
           <a
    href="#book-demo"
    class="bg-[#2b2e17] border-2 border-lime-400 text-lime-400 px-5 py-3 rounded-full font-bold text-base uppercase tracking-wider hover:bg-lime-400 hover:text-black transition-all duration-300"
  >
            Learn How It Works Together
          </a>
        </div>
        
      </div>
    </div>
  </div>
</section>