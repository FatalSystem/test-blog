---
import '../../../../public/styles/global.css'
---

<section  class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 bg-[#262424] relative z-10">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-16 max-w-7xl mx-auto">
      
      <!-- Left Column - Header Content -->
      <div class="lg:pr-8">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
          COMMON QUESTIONS<br>
          ABOUT <span class="text-lime-400">TENNIBOT<br>
          PICKLEBALL GEAR</span>
        </h2>
        
        <div class="space-y-4 mb-8">
          <p class="text-gray-300 text-lg">
            Join the revolution in pickleball training.
          </p>
          <p class="text-gray-300 text-lg">
            Bring AI-powered coaching to your program and watch your players excel.
          </p>
        </div>
        
        <div class="space-y-2">
          <p class="text-white text-lg">
            Got more questions? Give us a ring at
          </p>
          <a href="tel:251-277-8022" class="text-lime-400 text-lg font-semibold hover:text-lime-300 transition-colors">
            251-277-8022
          </a>
        </div>
      </div>

      <!-- Right Column - FAQ Accordion -->
     <div class="space-y-4">
        <div class="border-b border-white pb-4">
            <button class="w-full flex justify-between items-center text-left group">
              <span class="text-white text-lg">How long does the battery last?</span>
              <svg class="w-5 h-5 text-gray-400 transform group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <p class="text-gray-400 mt-2 hidden">
              The Rover and Station can last up to 5 hours on a full charge.
            </p>
          </div>
         <div class="border-b border-white pb-4">
            <button class="w-full flex justify-between items-center text-left group">
              <span class="text-white text-lg">Is the collector safe for clay courts?</span>
              <svg class="w-5 h-5 text-gray-400 transform group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
          </div>
         <div class="border-b border-white pb-4">
            <button class="w-full flex justify-between items-center text-left group">
              <span class="text-white text-lg">Can I use these products indoors?</span>
              <svg class="w-5 h-5 text-gray-400 transform group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
          </div>
         <div class="border-b border-white pb-4">
            <button class="w-full flex justify-between items-center text-left group">
              <span class="text-white text-lg">What is the warranty period?</span>
              <svg class="w-5 h-5 text-gray-400 transform group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
          </div>
         <div class="border-b border-white pb-4">
            <button class="w-full flex justify-between items-center text-left group">
              <span class="text-white text-lg">Can the Tennibot handle rain?</span>
              <svg class="w-5 h-5 text-gray-400 transform group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
          </div>
        </div>
    </div>
  </div>
</section>

