---
import picklebotImage from '../../../assets/newdesignimages/picklebotImage.png';
import TennibotAtlanta from '../../../assets/newdesignimages/TennibotAtlanta.png';
import '../../../../public/styles/global.css'
---

<section id="products" class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 bg-[#191A16] relative z-10">
  <div class="text-center mb-12 sm:mb-16 lg:mb-20">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 sm:mb-6 leading-tight text-white">
    Upgrade Your Pickleball Game  <br />With  <span class="text-lime-400">AI-Powered Gear</span>
    </h2>
    <p class="text-lg sm:text-xl opacity-80 text-gray-300 px-4">
   Explore Our Smart Ball Machines & Automatic Ball Retrievers
    </p>
  </div>

  <div class="flex flex-wrap justify-center gap-6 sm:gap-8 max-w-6xl mx-auto ">
    <div id="rover" class="w-full sm:w-[22rem] relative rounded-2xl overflow-hidden hover:translate-y-2 hover:shadow-2xl hover:shadow-lime-400/20 transition-all duration-300 group">
      <img src={TennibotAtlanta.src} alt="The Rover" fetchpriority="high" />
      <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-6 bg-gradient-to-t from-black/80 via-black/50 to-transparent">
        <h3 class="text-xl sm:text-2xl font-bold mb-2 sm:mb-3 text-white uppercase">Pickleball <br /> Ball Machine</h3>
        <p class="text-gray-200 mb-4 sm:mb-6 leading-relaxed text-sm sm:text-base">
        Launch with accuracy and create custom drills using the Tennibot Partner - the AI-powered pickleball machine made for focused training.
        </p>
        <a href="#rover-details" class="inline-block px-6 py-2 sm:px-8 sm:py-3 border-2 border-lime-400 rounded-full text-lime-400 font-semibold text-xs sm:text-sm hover:bg-lime-400 hover:text-black hover:translate-y-1 transition-all duration-300 uppercase tracking-wide">
         SHOP NOW
        </a>
      </div>
    </div>

    <div class="w-full sm:w-[22rem] relative rounded-2xl overflow-hidden hover:translate-y-2 hover:shadow-2xl hover:shadow-lime-400/40 transition-all duration-300 group">
      <img src={picklebotImage.src} alt="The Bundle" fetchpriority="high" />
      <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 bg-gradient-to-t from-black/80 via-black/50 to-transparent">
        <h3 class="text-xl sm:text-2xl font-bold mb-2 sm:mb-3 text-white uppercase">Pickleball Ball<br />  Collector</h3>
        <p class="text-gray-200 mb-4 sm:mb-6 leading-relaxed text-sm sm:text-base">
       Automate ball retrieval with the Tennibot Rover - a smart, portable collector built for pickleball courts
        </p>
        <a href="#rover-details" class="inline-block px-6 py-2 sm:px-8 sm:py-3 border-2 border-lime-400 rounded-full text-lime-400 font-semibold text-xs sm:text-sm hover:bg-lime-400 hover:text-black hover:translate-y-1 transition-all duration-300 uppercase tracking-wide">
          BUY NOW
        </a>
      </div>
    </div>
  </div>
</section>
