---

import Layout from 'layouts/Layout.astro';

import bollsonground from '../../../assets/newdesignimages/bollsonground.png';
import bollsbacket from '../../../assets/newdesignimages/bollsbacket.png';
import bollsinbeg from '../../../assets/newdesignimages/bollsinbeg.png';

import LightweightIcon from "../../../assets/newdesignimages/LightweightIcon.png";
import NomanualIcon from "../../../assets/newdesignimages/NomanualIcon.png";
import RustedbyIcon from "../../../assets/newdesignimages/rustedbyIcon.png";
import SaveupIcon from "../../../assets/newdesignimages/SaveupIcon.png";
import BuiltforIcon from "../../../assets/newdesignimages/BuiltforIcon.png";
import AutomateIcon from "../../../assets/newdesignimages/AutomateIcon.png";

import machinesReady from '../../../assets/new/home/machines-ready.webp';
import customDrills from '../../../assets/new/home/custom-drills.webp';
import roverCollect from '../../../assets/new/home/rover-collect.webp';
import loadPartner from '../../../assets/new/home/load-partner.webp';

import InnovativeTennis from '../../../assets/newdesignimages/InnovativeTennis.png';

import padel from '../../../assets/newdesignimages/padel.png';
import picklebot from '../../../assets/newdesignimages/picklebot.png';
import tennis from '../../../assets/newdesignimages/tennis.png';
import DraggableSlider from '@components/DraggableSlider';
import TestimonialItem from '@components/TestimonialItem';

import Text from "@components/core/Text.astro"
import { Image } from 'astro:assets'
import roverApp from '@assets/rover/roverapp.webp'
import downloadIOS from '@assets/rover/downloadios.svg'
import downloadAndroid from '@assets/rover/downloadandroid.svg'

import stationRoverBg from '../../../assets/new/home/station-rover-bg.webp';
import NewFAQ from '@components/NewFAQ';
import VideoThumbnail from '@components/VideoThumbnail';
import NHero from '@components/NHero.astro';

---
<Layout title="Tennibot - AI-Powered Tennis Training Equipment | Ball Machines & Collectors" showFooter={true} showHeader={true}>
  <main>
    <NHero primaryCta="Shop now" secondaryCta="Book a demo" primaryCtaLink="/compare" secondaryCtaLink="/compare" >
      <h1
      slot="title"
      class="text-2xl mobilem:text-3xl mobilel:text-4xl font-avenirBold sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-bold mb-3 sm:mb-5 leading-tight animate-fade-in-up text-white"
      >
          ELEVATE YOUR<br /> <span class="text-t-green drop-shadow-lg font-avenirBold ">TENNIS TRAINING</span>
      </h1>
      <p
      slot="description"
      class="text-sm font-plutoLight sm:text-base md:text-lg mb-6 sm:mb-8 opacity-90 leading-relaxed animate-fade-in-up delay-200 text-white max-w-2xl mx-auto"
      >
          AI-powered ball machines and automated ball collectors<br class="hidden sm:block"/>
          designed to maximize your performance with minimal effort.
      </p>
    </NHero>

    <section id="products" class="py-16 sm:py-20 lg:py-24 bg-[#191A16] relative z-10" role="region" aria-label="Product showcase">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="text-center mb-12 sm:mb-16 lg:mb-20">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-avenirBold mb-4 sm:mb-6 leading-tight text-white">
            AI-POWERED TRAINING <span class="text-lime-400">SOLUTIONS</span>
          </h2>
          <p class="text-base sm:text-lg font-plutoLight text-t-off-white px-4">
            Explore Our Smart Ball Machines & Automatic Ball Retrievers
          </p>
        </div>
    
    <div class="flex flex-col sm:overflow-x-scroll sm:flex-row sm:flex-nowrap sm:[&::-webkit-scrollbar]:hidden gap-6 sm:gap-5 md:gap-8">
      <article id="partner" class="relative sm:min-w-[285px] rounded-2xl lg:h-full h-56 sm:h-full overflow-hidden">
        <img     
          src={bollsbacket.src}
          alt="Tennibot Partner - AI-powered tennis ball machine with programmable drills"     
          fetchpriority="high"     
          class="w-full h-full object-cover"
        />
        
        <div class="absolute flex flex-col justify-end bottom-0 top-0 left-0 right-0 p-6 sm:p-8 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
          <h3 class="text-xl sm:text-2xl font-avenirBold mb-2 text-white"><span class="font-plutoLight" >THE</span> PARTNER</h3>
          <p class="text-sm sm:text-base font-pluto text-gray-200 mb-4 sm:mb-6 leading-relaxed">
            Launch precision shots with programmable drills.
          </p>
          <a href="#partner-details" class={`w-full text-sm sm:text-base rounded-full py-3 px-8 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green hover:bg-t-green hover:text-t-off-black`}>
             BROWSE MODELS
           </a>
        </div>
      </article>
    
      <article id="rover" class="relative sm:min-w-[285px] rounded-2xl lg:h-full h-56 sm:h-full overflow-hidden">
        <img     
          src={bollsonground.src}
          alt="Tennibot Rover - Automatic tennis ball collector and retriever"     
          fetchpriority="high"     
          class="w-full h-full object-cover"
        />
        
        <div class="absolute flex flex-col justify-end bottom-0 top-0 left-0 right-0 p-6 sm:p-8 bg-gradient-to-t from-black/60 via-black/40 to-transparent">
          <h3 class="text-xl sm:text-2xl font-avenirBold mb-2 sm:mb-3 text-white"><span class="font-plutoLight" >THE</span> ROVER</h3>
          <p class="text-sm sm:text-base font-pluto text-gray-200 mb-4 sm:mb-6 leading-relaxed">
            Pick up balls in seconds, hands-free.
          </p>
                   <a href="#rover-details" class={`w-full text-sm sm:text-base rounded-full py-3 px-8 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green hover:bg-t-green hover:text-t-off-black`}>
             SEE COLLECTORS
           </a>
        </div>
      </article>
    
      <article class="relative sm:min-w-[285px] rounded-2xl lg:h-full h-56 sm:h-full overflow-hidden border-solid border-t-green border-2">
        <div class="absolute top-4 sm:top-5 font-pluto right-4 sm:right-5 bg-lime-400 text-black px-3 py-1 sm:px-4 sm:py-2 rounded-full text-xs font-bold z-10">
          RECOMMENDED
        </div>
        
        <img     
          src={bollsinbeg.src}    
          alt="Tennibot Bundle - Complete tennis training solution with Partner ball machine and Rover collector"     
          fetchpriority="high"     
          class="w-full h-full object-cover"
        />
        
        <div class="absolute flex flex-col justify-end bottom-0 top-0  left-0 right-0 p-6 sm:p-8 bg-gradient-to-t from-black/60 via-black/40 to-transparent">
          <h3 class="text-xl sm:text-2xl font-avenirBold mb-2 sm:mb-3 text-white"><span class="font-plutoLight" >THE</span> BUNDLE</h3>
          <p class="text-sm sm:text-base font-pluto text-gray-200 mb-4 sm:mb-6 leading-relaxed">
            PARTNER + ROVER<br>
            Complete AI training solution
          </p>
                 <a href="#rover-details" class={`w-full text-sm sm:text-base rounded-full py-3 px-8 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green hover:bg-t-green hover:text-t-off-black`}>
          BUY NOW
           </a>
        </div>
      </article>
        </div>
      </div>
    </section>

    <section
      class="py-16 sm:py-20 bg-[url('/images/new/home/why-bg.webp')] bg-cover bg-center lg:py-24"
      role="region"
      aria-label="Why choose Tennibot"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 min-h-[55vh] flex flex-col justify-between relative z-10">
        
        <h2
          class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-center font-avenirBold mb-8 sm:mb-12 leading-tight text-white"
        >
          WHY <span class="text-t-green">CHOOSE</span> OUR BALL MACHINES<br class="hidden sm:block" />
          <span class="text-t-off-white">AND BALL COLLECTORS?</span>
        </h2>

        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            <div class="flex items-center gap-3 sm:gap-4">
              <img
                src={AutomateIcon.src}
                alt="Automate training sessions icon"
                class="w-5 h-5 sm:w-6 sm:h-6 object-contain flex-shrink-0"
              />
              <p class="text-sm sm:text-base font-pluto text-t-off-white">
                Automate your training sessions
              </p>
            </div>

            <div class="flex items-center gap-3 sm:gap-4">
              <img
                src={SaveupIcon.src}
                alt="Save court time icon"
                class="w-5 h-5 sm:w-6 sm:h-6 object-contain flex-shrink-0"
              />
              <p class="text-sm sm:text-base font-pluto text-t-off-white">
              Save up to 40% court time
              </p>
            </div>

            <div class="flex items-center gap-3 sm:gap-4">
              <img
                src={BuiltforIcon.src}
                alt="Built for all surfaces icon"
                class="w-5 h-5 sm:w-6 sm:h-6 object-contain flex-shrink-0"
              />
              <p class="text-sm sm:text-base font-pluto text-t-off-white">
                Built for all surfaces and skill levels
              </p>
            </div>

            <div class="flex items-center gap-3 sm:gap-4">
              <img
                src={LightweightIcon.src}
                alt="Lightweight portable equipment icon"
                class="w-5 h-5 sm:w-6 sm:h-6 object-contain flex-shrink-0"
              />
              <p class="text-sm sm:text-base font-pluto text-t-off-white">
                Lightweight, portable, powerful
              </p>
            </div>

            <div class="flex items-center gap-3 sm:gap-4">
              <img
                src={RustedbyIcon.src}
                alt="Trusted by coaches icon"
                class="w-5 h-5 sm:w-6 sm:h-6 object-contain flex-shrink-0"
              />
              <p class="text-sm sm:text-base font-pluto text-t-off-white">
                Trusted by coaches and clubs worldwide
              </p>
            </div>

            <div class="flex items-center gap-3 sm:gap-4">
              <img
                src={NomanualIcon.src}
                alt="No manual collection needed icon"
                class="w-5 h-5 sm:w-6 sm:h-6 object-contain flex-shrink-0"
              />
              <p class="text-sm sm:text-base font-pluto text-t-off-white">
                No manual chasing or collecting needed
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24 bg-[#191A16] relative" role="region" aria-label="How it works">
      <div class="max-w-7xl mx-auto">
          <div class="text-center mb-12 sm:mb-16">
            <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-avenirBold mb-4 sm:mb-6 leading-tight text-white">
              HOW OUR BALL LAUNCHERS & BALL<br class="hidden sm:block" />
              COLLECTORS <span class="text-lime-400">WORK TOGETHER</span> ON COURT
            </h2>
          </div>
          <DraggableSlider client:load className="gap-5 px-0" >
            <article class="rounded-lg min-w-[290px] min-h-[40vh] overflow-hidden relative">
              <img     
                src={machinesReady.src}    
                alt="Tennibot ball machines ready for training in under a minute"     
                fetchpriority="high"
                class="w-full h-full object-cover"     
              />
              <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 lg:p-8 bg-gradient-to-t from-black/60 via-black/40 to-transparent">
                <p class="text-sm sm:text-base font-pluto text-t-off-white">Machines are ready in under a minute</p>
              </div>
            </article>
    
            <article class="rounded-lg min-w-[290px] min-h-[40vh] overflow-hidden relative">
              <img     
                src={customDrills.src}
                alt="Custom tennis drills via mobile app interface"
                fetchpriority="high"
                class="w-full h-full object-cover"
              />
              <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 lg:p-8 bg-gradient-to-t from-black/60 via-black/40 to-transparent">
                <p class="text-sm sm:text-base font-pluto text-t-off-white">Run custom drills via the app</p>
              </div>
            </article>
    
            <article class="rounded-lg min-w-[290px] min-h-[40vh] overflow-hidden relative">
              <img     
                src={roverCollect.src}
                alt="Tennibot Rover collecting tennis balls automatically"
                fetchpriority="high"
                class="w-full h-full object-cover"
              />
              <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 lg:p-8 bg-gradient-to-t from-black/60 via-black/40 to-transparent">
                <p class="text-sm sm:text-base font-pluto text-t-off-white">Let the rover collect balls while you practice</p>
              </div>
            </article>
    
            <article class="rounded-lg min-w-[290px] min-h-[40vh] overflow-hidden relative">
              <img     
                src={loadPartner.src}    
                alt="Loading tennis balls back into Partner ball machine"
                fetchpriority="high"
                class="w-full h-full object-cover"
              />
              <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 lg:p-8 bg-gradient-to-t from-black/60 via-black/40 to-transparent">
                <p class="text-sm sm:text-base font-pluto text-t-off-white">Load the partner back up and repeat with ease</p>
              </div>
            </article>
          </DraggableSlider>
      </div>
    </section>
  
    <section class="relative bg-[#191A16] min-h-screen flex items-center overflow-hidden" role="region" aria-label="Innovative tennis equipment">
      <div class="absolute right-0 md:top-0 bottom-0 md:w-1/2 w-[60%] lg:flex items-center justify-center">
        <img     
          src={InnovativeTennis.src}
          alt="Innovative tennis training equipment and ball machines"     
          fetchpriority="high"
          class="max-w-full max-h-full object-contain opacity-90"
        />
      </div>
      <div class="max-w-7xl w-full z-10 mb-80 md:mb-0 mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-2xl lg:max-w-xl xl:max-w-2xl">
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-4xl xl:text-5xl font-avenirBold text-t-off-white mb-6 leading-tight">
            INNOVATIVE TENNIS
            EQUIPMENT THAT <span class="text-lime-400">SAVES TIME
            & BOOSTS PERFORMANCE</span>
          </h2>
          <p class="text-sm sm:text-base lg:text-lg font-pluto text-t-off-white mb-4 leading-relaxed">
            Tennibot offers premium ball machines and automatic ball collectors
            for players at every level. Our machines are designed for precision
            training, while our collectors eliminate time-consuming cleanup of the
            court.
          </p>
          
          <p class="text-sm sm:text-base lg:text-lg font-pluto text-t-off-white mb-8">
            Whether you're a coach or a weekend warrior, Tennibot enhances your
            performance and optimizes your training routine. Our ball machines and
            ball collectors are available for tennis, padel, and pickleball.
          </p>
          <a href="#rover-details" class="inline-block w-full sm:w-auto text-sm sm:text-base rounded-full py-3 px-8 font-avenir uppercase text-t-green border-2 transition duration-300 text-center bg-[rgba(192,242,12,0.10)] border-t-green hover:bg-t-green hover:text-t-off-black">
            BROWSE MODELS
          </a>
        </div>
      </div>
    </section>

    <section class="bg-[#262424] flex justify-center text-t-off-white" >
      <div class="w-[95%] 2xl:w-[65%] lg:pb-24 py-16" >
          <div class="flex flex-row justify-center" >
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-avenirBold mb-4 sm:mb-6 leading-tight text-center text-white">
              SEE OUR BALL MACHINES<br class="hidden sm:block" />
              & COLLECTORS <span class="text-lime-400">IN ACTION</span>
            </h2>
          </div>

           <div class="w-full sm:grid sm:grid-cols-2 flex flex-col mt-5 gap-5" >
               <VideoThumbnail client:idle title="setup" videoSource="https://player.vimeo.com/video/932265258" className="bg-[url('/images/rover/setupthumbnail.webp')]"  />
               <VideoThumbnail client:idle title="Serve Practice Timelapse" videoSource="https://player.vimeo.com/video/946348494" className="bg-[url('/images/rover/timelapsethumbnail.webp')] bg-cover bg-left" />
          </div> 
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24 bg-[#191A16]" role="region" aria-label="Shop by category">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="text-center mb-12 sm:mb-16 lg:mb-20">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-avenirBold mb-4 sm:mb-6 leading-tight text-white">SHOP BY CATEGORY</h2>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
          <article class="relative group cursor-pointer">
            <div class="relative overflow-hidden rounded-lg">
              <img src={tennis.src} alt="Tennis ball machines and equipment for tennis training" class="w-full h-48 sm:h-56 lg:h-64 object-cover group-hover:scale-105 transition-transform duration-500"/>
              <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <h3 class="text-lg sm:text-xl lg:text-2xl font-avenirBold text-t-off-white">TENNIS</h3>
              </div>
              <div class="absolute bottom-4 right-4">
                <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 sm:w-6 sm:h-6 text-t-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
          </article>
          
          <article class="relative group cursor-pointer">
            <div class="relative overflow-hidden rounded-lg">
              <img src={picklebot.src} alt="Pickleball ball machines and equipment for pickleball training" class="w-full h-48 sm:h-56 lg:h-64 object-cover group-hover:scale-105 transition-transform duration-500"/>
              <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <h3 class="text-lg sm:text-xl lg:text-2xl font-avenirBold text-t-off-white">PICKLEBALL</h3>
              </div>
              <div class="absolute bottom-4 right-4">
                <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 sm:w-6 sm:h-6 text-t-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
          </article>
          
          <article class="relative group cursor-pointer sm:col-span-2 lg:col-span-1">
            <div class="relative overflow-hidden rounded-lg">
              <img src={padel.src} alt="Padel ball machines and equipment for padel training" class="w-full h-48 sm:h-56 lg:h-64 object-cover group-hover:scale-105 transition-transform duration-500"/>
              <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <h3 class="text-lg sm:text-xl lg:text-2xl font-avenirBold text-t-off-white">PADEL</h3>
              </div>
              <div class="absolute bottom-4 right-4">
                <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 sm:w-6 sm:h-6 text-t-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24 bg-t-off-black" role="region" aria-label="Customer testimonials">
      <div>
          <div class="text-center max-w-[80%] mx-auto mb-12 sm:mb-16 lg:mb-20">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-avenirBold mb-4 sm:mb-6 leading-tight text-t-off-white uppercase">What <span class="text-t-green">players & coaches</span><br class="hidden sm:block"/> say about tennibot</h2>
          </div>
          <DraggableSlider client:load className="gap-10" >
              <TestimonialItem client:load quote={`"It's fantastic for drilling, practice points, and even doubles drills. I really enjoyed it."`} name="Sylvana Jordyn" location="Rockville, MD" videoSource="https://player.vimeo.com/video/1031406658" className="bg-[url('/images/partner/testimonial-one.png')]" />
              <TestimonialItem client:load quote={`"I worked on rapid-fire volleys, reflexes, and range at the net—it's perfect for sharpening your skills."`} name="Logan West" location="Washington, DC" videoSource="https://player.vimeo.com/video/1031406854" className="bg-[url('/images/partner/testimonial-two.png')]" />
              <TestimonialItem client:load quote={`"What surprised me the most was how much I had to move and anticipate—it felt just like a real hitting session."`} name="Alex Chan" location="Rockville, MD" videoSource="https://player.vimeo.com/video/1031406731" className="bg-[url('/images/partner/testimonial-three.png')]" />
              <TestimonialItem client:load quote={`"The Tennibot Partner is an amazing ball machine—it moves, evolves, and offers an experience unlike any other ball machine I've played with before."`} name="Mo Eldemerdash" location="Auburn, AL" videoSource="https://player.vimeo.com/video/1031426621" className="bg-[url('/images/partner/testimonial-four.png')]" />
          </DraggableSlider>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24 bg-t-off-black flex justify-center min-[550px]:items-center text-t-off-white" role="region" aria-label="Mobile app control">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 flex min-[550px]:flex-row flex-col items-center justify-center" >
          <div class="min-[550px]:w-[50%] min-[550px]:mb-0 mb-14" >
              <Text tag="h2" className="font-avenir text-pretty text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-left uppercase"  >Take <span class="font-avenirBold text-t-green" >control</span></Text>
              <Text tag="p" className="font-plutoLight text-sm sm:text-base lg:text-lg xl:text-xl text-pretty my-7 tracking-tight" >The Tennibot app enables you to select specific regions on the court, designate restricted zones to avoid, or drive it yourself.</Text>
              <div class="flex flex-row gap-3 sm:gap-5 lg:pr-10 min-[550px]:pl-0 pr-8" >
                  <a href="https://apps.apple.com/us/app/tennibot/id1438424530" target="_blank" class="cursor-pointer" aria-label="Download Tennibot app for iOS"  ><Image src={downloadIOS}  alt="Download Tennibot on iOS" class="w-28 sm:w-32 lg:w-36" /></a>
                  <a href="https://play.google.com/store/apps/details?id=com.tennibot&hl=en&gl=US" target="_blank" class="cursor-pointer" aria-label="Download Tennibot app for Android" ><Image src={downloadAndroid}   alt="Download Tennibot on Android" class="w-32 sm:w-36 lg:w-40" /></a>
              </div>
