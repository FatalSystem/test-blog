---
import SeeTennibotIcon from '../../../assets/newdesignimages/SeeTennibotIcon.png';
import RealPlayersIcon from '../../../assets/newdesignimages/RealPlayersIcon.png';
import '../../../../public/styles/global.css'
---  
  
  <section class="bg-black py-20">
    <div class="container mx-auto px-12">
      <h2 class="text-4xl font-bold text-white text-center mb-4">
        SEE OUR BALL MACHINES, BALL<br/>
        LAUNCHERS & COLLECTORS <span class="text-lime-400">IN ACTION</span>
      </h2>
      
      <div class="grid md:grid-cols-2 gap-8 mt-12">
        <div class="relative group cursor-pointer">
			   <img     
      src={SeeTennibotIcon.src}
      alt="The Rover"     
      fetchpriority="high"     
    />
        </div>
        
        <div class="relative group cursor-pointer">
			   <img     
      src={RealPlayersIcon.src}
      alt="The Rover"     
      fetchpriority="high"     
    />
        </div>
      </div>
    </div>
  </section>