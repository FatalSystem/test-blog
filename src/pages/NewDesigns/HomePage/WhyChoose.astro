---
import LightweightIcon from "../../../assets/newdesignimages/LightweightIcon.png";
import NomanualIcon from "../../../assets/newdesignimages/NomanualIcon.png";
import RustedbyIcon from "../../../assets/newdesignimages/rustedbyIcon.png";
import SaveupIcon from "../../../assets/newdesignimages/SaveupIcon.png";
import BuiltforIcon from "../../../assets/newdesignimages/BuiltforIcon.png";
import AutomateIcon from "../../../assets/newdesignimages/AutomateIcon.png";
import TennibotImage from "../../../assets/newdesignimages/TennibotImage.png";
import GradientImage from "../../../assets/newdesignimages/Gradient.png";
import "../../../../public/styles/global.css";
---

<section
  class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 bg-gradient-to-b from-slate-800 to-slate-900 relative overflow-hidden"
>
  <div class="absolute inset-0 z-0">
    <img
      src={TennibotImage.src}
      alt="Tennibot Machine"
      class="w-full h-full object-cover opacity-40"
    />

    <img
      src={GradientImage.src}
      alt="Gradient Overlay"
      class="absolute top-0 left-0 w-full h-full object-cover pointer-events-none z-10"
    />
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center mb-12 sm:mb-16">
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 sm:mb-6 leading-tight text-white"
      >
        WHY <span class="text-lime-400">CHOOSE</span> OUR BALL MACHINES<br />
        <span class="text-white">AND BALL COLLECTORS?</span>
      </h2>
    </div>

    <div class="mb-8 sm:mb-82"></div>                            

    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="flex items-start gap-4">
          <img
            src={AutomateIcon.src}
            alt="Automate"
            class="w-6 h-6 object-contain mt-1"
          />
          <h3 class="text-white font-semibold mb-2">
            Automate your training sessions
          </h3>
        </div>

        <div class="flex items-start gap-4">
          <img
            src={SaveupIcon.src}
            alt="Save up"
            class="w-6 h-6 object-contain mt-1"
            <h3
            class="text-white font-semibold mb-2"
          />
          Save up to 40% court time
        </div>
      </div>

      <div class="flex items-start gap-4">
        <img
          src={BuiltforIcon.src}
          alt="Built for all"
          class="w-6 h-6 object-contain mt-1"
        />
        <h3 class="text-white font-semibold mb-2">
          Built for all surfaces and skill levels
        </h3>
      </div>

      <div class="flex items-start gap-4">
        <img
          src={LightweightIcon.src}
          alt="Lightweight"
          class="w-6 h-6 object-contain mt-1"
        />
        <h3 class="text-white font-semibold mb-2">
          Lightweight, portable, powerful
        </h3>
      </div>

      <div class="flex items-start gap-4">
        <img
          src={RustedbyIcon.src}
          alt="Trusted by coaches"
          class="w-6 h-6 object-contain mt-1"
        />
        <h3 class="text-white font-semibold mb-2">
          Trusted by coaches and clubs worldwide
        </h3>
      </div>

      <div class="flex items-start gap-4">
        <img
          src={NomanualIcon.src}
          alt="No manual"
          class="w-6 h-6 object-contain mt-1"
        />
        <h3 class="text-white font-semibold mb-2">
          No manual chasing or collecting needed
        </h3>
      </div>
    </div>
  </div>
</section>
