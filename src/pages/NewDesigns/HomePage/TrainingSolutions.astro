---
import bollsonground from '../../../assets/newdesignimages/bollsonground.png';
import bollsbacket from '../../../assets/newdesignimages/bollsbacket.png';
import bollsinbeg from '../../../assets/newdesignimages/bollsinbeg.png';
import '../../../../public/styles/global.css'
---

<section id="products" class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 bg-gradient-to-b from-slate-900 to-slate-800 relative z-10">
  <div class="text-center mb-12 sm:mb-16 lg:mb-20">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 sm:mb-6 leading-tight text-white">
      AI-POWERED TRAINING <span class="text-lime-400">SOLUTIONS</span>
    </h2>
    <p class="text-lg sm:text-xl opacity-80 text-gray-300 px-4">
      Explore Our Smart Ball Machines & Automatic Ball Retrievers
    </p>
  </div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 max-w-6xl mx-auto">
  <div id="partner" class="relative rounded-2xl overflow-hidden hover:translate-y-2 hover:shadow-2xl hover:shadow-lime-400/20 transition-all duration-300 group">
    <img     
      src={bollsbacket.src}
      alt="The Partner"     
      fetchpriority="high"     
    />
    
    <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 bg-gradient-to-t from-black/80 via-black/50 to-transparent">
      <h3 class="text-xl sm:text-2xl font-bold mb-2 sm:mb-3 text-white">THE PARTNER</h3>
      <p class="text-gray-200 mb-4 sm:mb-6 leading-relaxed text-sm sm:text-base">
        Launch precision shots with programmable drills.
      </p>
      <a href="#partner-details" class="inline-block px-6 py-2 sm:px-8 sm:py-3 border-2 border-lime-400 rounded-full text-lime-400 font-semibold text-xs sm:text-sm hover:bg-lime-400 hover:text-black hover:translate-y-1 transition-all duration-300 uppercase tracking-wide">
        BROWSE MODELS
      </a>
    </div>
  </div>

  <div id="rover" class="relative rounded-2xl overflow-hidden hover:translate-y-2 hover:shadow-2xl hover:shadow-lime-400/20 transition-all duration-300 group">
    <img     
      src={bollsonground.src}
      alt="The Rover"     
      fetchpriority="high"     
    />
    
    <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 bg-gradient-to-t from-black/80 via-black/50 to-transparent">
      <h3 class="text-xl sm:text-2xl font-bold mb-2 sm:mb-3 text-white">THE ROVER</h3>
      <p class="text-gray-200 mb-4 sm:mb-6 leading-relaxed text-sm sm:text-base">
        Pick up balls in seconds, hands-free.
      </p>
      <a href="#rover-details" class="inline-block px-6 py-2 sm:px-8 sm:py-3 border-2 border-lime-400 rounded-full text-lime-400 font-semibold text-xs sm:text-sm hover:bg-lime-400 hover:text-black hover:translate-y-1 transition-all duration-300 uppercase tracking-wide">
        SEE COLLECTORS
      </a>
    </div>
  </div>

  <div class="relative rounded-2xl overflow-hidden hover:translate-y-2 hover:shadow-2xl hover:shadow-lime-400/40 transition-all duration-300 group md:col-span-2 lg:col-span-1">
    <div class="absolute top-4 sm:top-5 right-4 sm:right-5 bg-lime-400 text-black px-3 py-1 sm:px-4 sm:py-2 rounded-full text-xs font-bold z-10">
      RECOMMENDED
    </div>
    
    <img     
      src={bollsinbeg.src}    
      alt="The Bundle"     
      fetchpriority="high"     
    />
    
    <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 bg-gradient-to-t from-black/80 via-black/50 to-transparent">
      <h3 class="text-xl sm:text-2xl font-bold mb-2 sm:mb-3 text-white">THE BUNDLE</h3>
      <p class="text-gray-200 mb-4 sm:mb-6 leading-relaxed text-sm sm:text-base">
        PARTNER + ROVER<br>
        Complete AI training solution
      </p>
     <a href="#rover-details" class="inline-block px-6 py-2 sm:px-8 sm:py-3 border-2 border-lime-400 rounded-full text-lime-400 font-semibold text-xs sm:text-sm hover:bg-lime-400 hover:text-black hover:translate-y-1 transition-all duration-300 uppercase tracking-wide">
     BUY NOW
      </a>
    </div>
  </div>
</div>
</section>