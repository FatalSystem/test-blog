---
import padel from '../../../assets/newdesignimages/padel.png';
import picklebot from '../../../assets/newdesignimages/picklebot.png';
import tennis from '../../../assets/newdesignimages/tennis.png';
import '../../../../public/styles/global.css'
--- 
 
 <section class="bg-gray-900 py-20">
    <div class="container mx-auto px-12">
      <h2 class="text-4xl font-bold text-white text-center mb-12">SHOP BY CATEGORY</h2>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="relative group cursor-pointer">
          <div class="relative overflow-hidden rounded-lg">
            <img   src={tennis.src} alt="Tennis" class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <h3 class="text-white text-2xl font-bold">TENNIS</h3>
            </div>
            <div class="absolute bottom-4 right-4">
              <div class="w-10 h-10 bg-lime-400 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
        
        <div class="relative group cursor-pointer">
          <div class="relative overflow-hidden rounded-lg">
            <img src={picklebot.src} alt="Pickleball" class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <h3 class="text-white text-2xl font-bold">PICKLEBALL</h3>
            </div>
            <div class="absolute bottom-4 right-4">
              <div class="w-10 h-10 bg-lime-400 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
        
        <div class="relative group cursor-pointer">
          <div class="relative overflow-hidden rounded-lg">
            <img src={padel.src} alt="Padel" class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <h3 class="text-white text-2xl font-bold">PADEL</h3>
            </div>
            <div class="absolute bottom-4 right-4">
              <div class="w-10 h-10 bg-lime-400 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>