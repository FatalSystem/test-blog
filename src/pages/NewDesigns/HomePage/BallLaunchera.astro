---
import LettheIcon from '../../../assets/newdesignimages/LettheIcon.png';
import LoadtheIcon from '../../../assets/newdesignimages/LoadtheIcon.png';
import MachinesareIcon from '../../../assets/newdesignimages/MachinesareIcon.png';
import RuncustomIcon from '../../../assets/newdesignimages/RuncustomIcon.png';
import '../../../../public/styles/global.css'
---

<section class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 bg-gradient-to-b from-slate-900 to-slate-800 relative">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12 sm:mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 sm:mb-6 leading-tight text-white">
        HOW OUR BALL LAUNCHERS & BALL<br>
        COLLECTORS <span class="text-lime-400">WORK TOGETHER</span> ON COURT
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden backdrop-blur-sm">
     <img     
      src={MachinesareIcon.src}    
      alt="The Bundle"     
      fetchpriority="high"     
    />
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden backdrop-blur-sm">
        <img     
      src={RuncustomIcon.src}    
      alt="The Bundle"     
      fetchpriority="high"     
    />
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden backdrop-blur-sm">
        <img     
      src={LettheIcon.src}    
      alt="The Bundle"     
      fetchpriority="high"     
    />
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden backdrop-blur-sm">
         <img     
      src={LoadtheIcon.src}    
      alt="The Bundle"     
      fetchpriority="high"     
    />
    </div>
	</div>
	</div>
</section>

