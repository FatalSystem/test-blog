
---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Contact | Tennibot">
  <main class="bg-t-off-black font-pluto">
    <section class="w-full md:w-[80%] 2xl:max-w-[1133px] mx-auto text-t-off-white">
        <div class="relative">
            <img src="/public/images/rover/hero.png">
            <img src="/public/images/rover/gradient-hero.png" class="absolute w-full h-full top-0 left-0">
        </div>

        <div class="py-10 flex flex-col gap-[68px]">
            <h2 class="text-6xl font-dm text-t-off-white uppercase font-bold">Partner Specifications</h2>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Partner Specs</h4>
                <div class="text-lg font-plutoLight text-t-off-white">| Dimensions |17.7 in x 22.6 in x 21.5 in</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Weight | Approx. 38 lbs</div>
            </div>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Performance</h4>
                <div class="text-lg font-plutoLight text-t-off-white">| Max Drive Speed | 0.4-1.0 m/s</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Max Ball Speed | 10-70 mph (65 mph for Pickleball)</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Feed Rate | 2-15 Seconds</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Elevation | 10-40 Degrees</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Ball Capacity | 140</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Max Spin | 3000 RPM</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Operating Temp | 15 °F to 110 °F</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Battery Duration | 4–5 hours (based on usage and external conditions)</div>
            </div>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Sensors</h4>
                <ul class="text-lg font-plutoLight text-t-off-white list-disc ml-5">
                    <li>4K cameras</li>
                    <li>High resolution encoders</li>
                    <li>IMU</li>
                    <li>Ultrasonic sensors</li>
                </ul>
            </div>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">AI features</h4>
                <ul class="text-lg font-plutoLight text-t-off-white list-disc ml-5">
                    <li>8 TOPS processing power</li>
                    <li>On device Neural Network inference</li>
                    <li>3D object tracking</li>
                    <li>H264, H265 encoding</li>
                </ul>
            </div>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Battery</h4>
                <div class="text-lg font-plutoLight text-t-off-white">| Battery Duration | 4–5 hours (based on usage and external conditions)</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Nominal Capacity | 10.5 Ah</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Max Charge Time | 90 minutes</div>
            </div>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Station Specs</h4>
                <div class="text-lg font-plutoLight text-t-off-white">| Dimensions | Approx. 6.5” (D) × 3” (H)</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Weight | Approx. 1 lb 6 oz</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Operating Temp | 15 °F to 100 °F</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Battery Duration | 3–5 hours (based on usage and external conditions)</div>
            </div>

            <div>
                <h4 class="text-4xl mb-3 font-dm text-t-off-white uppercase font-bold">Station Battery</h4>
                <div class="text-lg font-plutoLight text-t-off-white">| Nominal Voltage | 3.7 V</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Max Charging Voltage | 4.2 V</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Nominal Capacity | 13.6 Ah</div>
                <div class="text-lg font-plutoLight text-t-off-white">Charging (5V USB)</div>

                <div class="text-lg font-plutoLight text-t-off-white mt-10">Feature Specification</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Max Charging Time | Approx. 100 minutes (may vary by adapter)</div>
                <div class="text-lg font-plutoLight text-t-off-white">| Charging Current | 3.0 A max (may vary by adapter)</div>
            </div>

        </div>
    </section>


  </main>
</Layout>
