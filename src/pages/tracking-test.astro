---
import Layout from "layouts/Layout.astro"
import ReactTrackingButton from "../components/ReactTrackingButton";
---
<Layout title="Reserve | Tennibot" showFooter={false} showHeader={false} >
    <div class="p-4">
        <h1>Tracking Test</h1>
        
        <!-- Astro Button -->
        <button 
            data-tracking="astro-button"
            class="bg-blue-500 text-white px-4 py-2 rounded mr-4">
            Track with Astro
        </button>

        <!-- React Button -->
        <ReactTrackingButton client:load />
    </div>
</Layout>

<script>
    // Astro button tracking
    document.querySelectorAll('[data-tracking]').forEach(button => {
        button.addEventListener('click', (e) => {
            const buttonId = (e.target as HTMLElement).dataset.tracking;
            window.mixpanel?.track('Button Clicked', {
                buttonId,
                framework: 'astro',
                page: 'Tracking Test'
            });
        });
    });
</script>