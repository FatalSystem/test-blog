---
import Layout from "layouts/Layout.astro"
---
<Layout title="Reserve | Tennibot" showFooter={false} showHeader={false} >
    <div class="p-4">
        <h1>Tracking Test</h1>
        <a href="/checkout?type=onetime" class="group cursor-pointer mt-8 flex flex-row justify-center items-center border-t-green bg-t-green border-2 rounded-md p-3 stroke-t-off-black md:stroke-t-green md:hover:stroke-t-green relative transition-all duration-300 ease-in-out">
            One Time
        </a>
        <a href="/checkout?type=monthly" class="group cursor-pointer mt-8 flex flex-row justify-center items-center border-t-green bg-t-green border-2 rounded-md p-3 stroke-t-off-black md:stroke-t-green md:hover:stroke-t-green relative transition-all duration-300 ease-in-out">
            Monthly Subscription
        </a>
        <a href="/checkout?type=annual" class="group cursor-pointer mt-8 flex flex-row justify-center items-center border-t-green bg-t-green border-2 rounded-md p-3 stroke-t-off-black md:stroke-t-green md:hover:stroke-t-green relative transition-all duration-300 ease-in-out"
        >Annual Subscription</a>
    </div>
</Layout>