---
import Button from "@components/core/Button.astro"
import Layout from "layouts/Layout.astro"
import { CircleAlert } from "lucide-react"

---

<Layout title="Page not found | Tennibot">
    <main class="bg-t-off-black overflow-hidden text-t-off-white" >
        <section class="w-[80%] md:w-[40%] mx-auto py-48 flex flex-col justify-center" >
            <div class="flex flex-col justify-center mb-8">
                <CircleAlert client:load className="mx-auto size-16 mb-5" />
                <h1 class="font-avenirBold uppercase text-t-off-white text-3xl 2xl:text-4xl ml-2 text-center" >Page not found</h1>
            </div>
            <p class="font-plutoLight text-t-off-white text-justify 2xl:text-xl">I'm sorry, but the page you are trying to access cannot be found. This could be due to a number of reasons, such as the page being removed, renamed, or temporarily unavailable. Thank you for your understanding.</p>
            <Button href="/" className="mt-10 mx-auto" >Home</Button>
        </section>
    </main>
</Layout>