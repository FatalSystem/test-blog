---
import SportForm from "@components/SportForm"
import Layout from "layouts/Layout.astro"
import Button from "@components/core/Button.astro"
import Text from "@components/core/Text.astro"
---
<Layout title="Join the newsletter | Tennibot">
    <main class="w-full bg-t-off-black relative text-t-off-white" >
      <div class="lg:bg-[url('/images/padel/padelbot.webp')] md:bg-[url('/images/padel/padelbot-laptop.webp')] bg-[url('/images/padel/padelbot-mobile.webp')] bg-center md:bg-right md:h-[80vh] h-[60rem] bg-cover">
        <div class="bg-black w-full md:h-[80vh] h-[60rem] absolute opacity-20 group-hover:opacity-40 transition-all duration-300 ease-in-out" ></div>
        <div class="w-[95%] sm:w-[80%] pt-[5vh] flex md:flex-row flex-col  justify-between h-full gap-5 mx-auto" >
          <div class="lg:mt-[5vh] z-10 mx-auto w-[90%]">
              <h1 class="text-t-off-white font-avenir uppercase xl:text-4xl lg:text-3xl md:text-2xl mobilem:text-xl mobilel:text-2xl text-xl text-pretty mx-auto w-[90%] tablet:w-full" >It's not just for tennis anymore<br /><span class="font-avenirBold" >the padelbot is here</span></h1>
          </div>
          <div class="flex flex-col z-10 md:justify-start justify-end" >
            <div class="bg-t-off-black border-2 border-t-off-white rounded-lg py-5 mobilem:px-10 px-5 w-[90%] mx-auto  mb-10" >
              <SportForm from="Padelbot Form" sport="Padel" client:load />
            </div>
          </div>
        </div>
      </div>
      <section class="flex flex-col sm:flex-row tablet:mt-0 mt-[-1px]" >
          <div class="w-full md:w-[50%] md:h-full" >
            <div class="bg-black h-[50vh] sm:w-[50vw] w-full absolute opacity-20 group-hover:opacity-40 transition-all duration-300 ease-in-out" ></div>
            <div  class=" bg-[url('/images/padel/tennis.webp')] bg-cover bg-top" >
              <div class="h-[50vh] flex flex-col items-center justify-between py-5">
                <Text tag="h3" className="uppercase z-10 font-avenirBold xl:text-4xl text-3xl" >
                  Tennis
                </Tex>
                <div class="flex flex-col items-center w-[90%]" >
                  <Button aria-label="Navigate to the Station page" href='/home' className="mt-4 z-10 w-64 " >Learn more</Button>
                </div>
              </div>
            </div>
          </div>
          <div class="relative w-full md:w-[50%] md:h-full" >
            <div class="bg-black h-[50vh] sm:w-[50vw] w-full absolute opacity-20 group-hover:opacity-40 transition-all duration-300 ease-in-out" ></div>
            <div class="bg-[url('/images/padel/pickleball.webp')] bg-cover bg-top" >
              <div class="h-[50vh] flex flex-col items-center justify-between py-5">
                <Text tag="h3" className="uppercase z-10 font-avenirBold xl:text-4xl text-3xl" >
                  Pickleball
                </Tex>
                <div class="flex flex-col items-center w-[90%]" >
                  <Button aria-label="Navigate to the Station page" href='/pickleball' className="mt-4 z-10 w-64 " >Learn more</Button>
                </div>
              </div>
            </div>
          </div>
      </section>
    </main>
</Layout>