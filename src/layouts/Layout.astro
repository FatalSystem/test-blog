---
import { ImageSupportDetection } from "astro-imagetools/components"
import Footer from "../components/Footer.astro"
import Header from "@components/Header"
export interface Props {
  title: string
}

const { title } = Astro.props
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta property="og:url" content="http://tennibot.com" />
	  <meta property="og:title" content="Tennibot">
	  <meta property="og:site_name" content="Tennibot" />
	  <meta property="og:determiner" content="the" />
	  <meta property="og:type" content="website" />
    <meta property="og:description" content="Tennibot | The world's first robotic tennis ball collector. Play more, pick up less.">
	  <meta name="description" content="Tennibot | The world's first robotic tennis ball collector. Play more, pick up less.">
    <meta name="keywords" content="tennis ball machine, tennis ball collector, tennis ball hopper, ball hopper, tennis ball mower, tennis robot, tennis ball picker upper, tennis ball pickup machine, tennis ball collector robot, tennis ball collector machine, automatic tennis ball collector, automated tennis ball collector">
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="https://player.vimeo.com/video/893993983?background=1" as="document">
    <link rel="preload" href="https://player.vimeo.com/video/894270264?background=1" as="document">
    <link rel="stylesheet" type="text/css" href="/styles/global.css">
    <meta name="generator" content={Astro.generator} />
    <ImageSupportDetection />
    <title>{title}</title>
  </head>
  <body class="bg-t-off-black" >
    <Header client:load />
    <slot />
    <Footer />
  </body>
</html>
